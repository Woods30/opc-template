{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    10,
    10
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 220
      },
      "min": 44,
      "max": 420,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "spaces",
          "type": "block",
          "size": {
            "weight": 1
          },
          "min": 90,
          "content": {
            "mod": "spaces"
          }
        },
        {
          "id": "agents",
          "type": "block",
          "size": {
            "weight": 1
          },
          "min": 120,
          "content": {
            "mod": "agents"
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "block",
      "content": {
        "tab": "active",
        "pane": {
          "gap": 6,
          "radius": 6,
          "background": "background",
          "border": {
            "width": 1,
            "color": "border"
          },
          "focus": {
            "width": 1,
            "color": "accent"
          },
          "header": {
            "content": {
              "mod": "pane"
            },
            "height": 24,
            "position": "top",
            "reveal": "always"
          }
        }
      }
    }
  ]
}
