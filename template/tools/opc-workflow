def metric_catalog_path(root: Path):
    return root / GROWTH_DIR / METRIC_CATALOG_NAME


def channel_snapshots_path(root: Path):
    return root / GROWTH_DIR / CHANNEL_SNAPSHOTS_NAME


def valid_metric_value(value):
    if isinstance(value, bool):
        return False
    if isinstance(value, (int, float)):
        return value == value and value not in (float("inf"), float("-inf"))
    if isinstance(value, dict):
        return (
            value.get("available") is False
            and is_nonempty_string(value.get("reason"))
            and all(key in ("available", "reason", "unit") for key in value)
        )
    return False


def validate_metric_values(values, catalog: dict, scope: str, channel: str):
    errors = []
    if not isinstance(values, dict) or not values:
        return ["values 必须是非空 JSON object"]
    for key, value in values.items():
        if not isinstance(key, str) or not METRIC_KEY_RE.fullmatch(key):
            errors.append(f"非法 metric key「{key}」")
            continue
        definition = catalog.get(key)
        if definition is None:
            errors.append(f"metric key「{key}」未注册：不在指标目录中")
            continue
        if definition.get("scope") != scope:
            errors.append(
                f"metric「{key}」scope 不匹配：目录定义为 {definition.get('scope')}，"
                f"当前记录需要 {scope}"
            )
        if channel not in definition.get("channels", ()):
            errors.append(f"metric「{key}」不支持 channel「{channel}」")
        if not valid_metric_value(value):
            errors.append(
                f"metric「{key}」的数值必须是非布尔有限数字，"
                "或 {available: false, reason: ...}"
            )
        elif isinstance(value, dict) and "unit" in value:
            if value["unit"] != definition.get("unit"):
                errors.append(
                    f"metric「{key}」unit 不匹配：目录为 {definition.get('unit')}，"
                    f"记录为 {value['unit']}"
                )
    return errors


def parse_metric_values(raw: str | None):
    raw = require_text("values", raw)
    if raw is None:
        raise WorkflowError("必须提供 --values")
    try:
        values = json.loads(raw)
    except json.JSONDecodeError as error:
        raise WorkflowError(f"values 不是合法 JSON：{error.msg}") from error
    if not isinstance(values, dict):
        raise WorkflowError("values 必须是 JSON object")
    return values


def validate_record_header(source: str, record: dict, record_type: str):
    errors = []
    schema_version = record.get("schema_version")
    if type(schema_version) is not int:
        errors.append(Diagnostic(source, "schema_version 必须是整数"))
    elif schema_version != SCHEMA_VERSION:
        errors.append(Diagnostic(source, "未知 schema_version"))
    if record.get("record_type") != record_type:
        errors.append(Diagnostic(source, f"record_type 必须是 {record_type}"))
    return errors


def load_metric_catalog(root: Path, known_channels: dict):
    growth = root / GROWTH_DIR
    path = metric_catalog_path(root)
    source = (GROWTH_DIR / METRIC_CATALOG_NAME).as_posix()
    errors = []
    if growth.is_symlink():
        return {}, [Diagnostic(GROWTH_DIR.as_posix(), "growth 目录不能是 symlink")]
    if growth.exists() and not growth.is_dir():
        return {}, [Diagnostic(GROWTH_DIR.as_posix(), "growth 必须是目录")]
    if path.is_symlink():
        return {}, [Diagnostic(source, "指标目录不能是 symlink")]
    if not path.exists():
        return {}, []
    if not path.is_file():
        return {}, [Diagnostic(source, "指标目录必须是文件")]
    record, _body, parse_errors = parse_card_document(path, source)
    if parse_errors:
        return {}, parse_errors
    if not isinstance(record, dict):
        return {}, [Diagnostic(source, "指标目录 frontmatter 必须是 JSON object")]
    errors.extend(validate_record_header(source, record, "metric_catalog"))
    metrics = record.get("metrics")
    if not isinstance(metrics, list):
        return {}, errors + [Diagnostic(source, "metrics 必须是数组")]
    catalog = {}
    for index, metric in enumerate(metrics):
        label = f"第 {index + 1} 个 metric"
        if not isinstance(metric, dict):
            errors.append(Diagnostic(source, f"{label} 必须是 object"))
            continue
        for field in ("key", "label", "unit", "aggregation", "scope"):
            if not is_nonempty_string(metric.get(field)):
                errors.append(Diagnostic(source, f"{label} 字段 {field} 必须是非空字符串"))
        key = metric.get("key")
        if is_nonempty_string(key) and not METRIC_KEY_RE.fullmatch(key):
            errors.append(Diagnostic(source, f"{label} 的 metric key「{key}」格式非法"))
        aggregation = metric.get("aggregation")
        if is_nonempty_string(aggregation) and aggregation not in METRIC_AGGREGATIONS:
            errors.append(Diagnostic(source, f"{label} 的 aggregation 非法"))
        scope = metric.get("scope")
        if is_nonempty_string(scope) and scope not in METRIC_SCOPES:
            errors.append(Diagnostic(source, f"{label} 的 scope 非法"))
        channels = metric.get("channels")
        if not isinstance(channels, list) or not channels:
            errors.append(Diagnostic(source, f"{label} 的 channels 必须是非空数组"))
            continue
        for channel in channels:
            if not isinstance(channel, str) or channel not in known_channels:
                errors.append(Diagnostic(source, f"{label} 使用未知 channel「{channel}」"))
            elif not known_channels[channel]:
                errors.append(Diagnostic(source, f"{label} 使用已停用 channel「{channel}」"))
        if not is_nonempty_string(key):
            continue
        previous = catalog.get(key)
        if previous is not None:
            if previous.get("unit") != metric.get("unit"):
                errors.append(
                    Diagnostic(
                        source,
                        f"metric key「{key}」unit 不一致："
                        f"{previous.get('unit')} 与 {metric.get('unit')}",
                    )
                )
            else:
                errors.append(Diagnostic(source, f"重复 metric key「{key}」"))
            continue
        catalog[key] = metric
    return catalog, errors


def publication_metrics_source(content_id: str, publication_id: str):
    return (
        CONTENT_DIR
        / content_id
        / PUBLICATIONS_DIR_NAME
        / publication_id
        / PUBLICATION_METRICS_NAME
    ).as_posix()


def validate_publication_metrics_record(
    source: str,
    publication_id: str,
    content_id: str,
    record,
    catalog: dict,
    channel: str,
):
    errors = []
    if not isinstance(record, dict):
        return [Diagnostic(source, "指标记录 frontmatter 必须是 JSON object")]
    errors.extend(validate_record_header(source, record, "publication_metrics"))
    if record.get("publication_id") != publication_id:
        errors.append(Diagnostic(source, "publication_id 与固定目录名不一致"))
    if record.get("content_id") != content_id:
        errors.append(Diagnostic(source, "content_id 与所属内容包不一致"))
    snapshots = record.get("snapshots")
    if not isinstance(snapshots, list):
        return errors + [Diagnostic(source, "snapshots 必须是数组")]
    seen_windows = set()
    for index, snapshot in enumerate(snapshots):
        label = f"第 {index + 1} 个指标窗口"
        if not isinstance(snapshot, dict):
            errors.append(Diagnostic(source, f"{label} 必须是 object"))
            continue
        window = snapshot.get("window")
        if not isinstance(window, str) or not METRIC_WINDOW_RE.fullmatch(window):
            errors.append(Diagnostic(source, f"{label} 的 window 格式非法"))
        elif window in seen_windows:
            errors.append(Diagnostic(source, f"重复窗口「{window}」"))
        else:
            seen_windows.add(window)
        if not valid_offset_time(snapshot.get("observed_at")):
            errors.append(Diagnostic(source, f"{label} 的 observed_at 必须是 offset-aware ISO 8601 时间"))
        if not is_nonempty_string(snapshot.get("source")):
            errors.append(Diagnostic(source, f"{label} 的 source 不能为空"))
        if not valid_offset_time(snapshot.get("recorded_at")):
            errors.append(Diagnostic(source, f"{label} 的 recorded_at 必须是 offset-aware ISO 8601 时间"))
        if snapshot.get("recorded_by") != "growth":
            errors.append(Diagnostic(source, f"{label} 的 recorded_by 必须是 growth"))
        for message in validate_metric_values(
            snapshot.get("values"),
            catalog,
            "publication",
            channel,
        ):
            errors.append(Diagnostic(source, f"{label}：{message}"))
    return errors


def load_publication_metrics(
    package: Path,
    publication_id: str,
    content_id: str,
    channel: str,
    catalog: dict,
):
    path = package / PUBLICATION_METRICS_NAME
    source = publication_metrics_source(content_id, publication_id)
    if path.is_symlink():
        return path, None, None, [Diagnostic(source, "指标记录不能是 symlink")]
    if not path.exists():
        return path, None, None, []
    if not path.is_file():
        return path, None, None, [Diagnostic(source, "指标记录必须是文件")]
    record, body, parse_errors = parse_card_document(path, source)
    if parse_errors:
        return path, None, None, parse_errors
    return (
        path,
        record,
        body,
        validate_publication_metrics_record(
            source,
            publication_id,
            content_id,
            record,
            catalog,
            channel,
        ),
    )


def record_publication_metrics(
    root: Path,
    publication_id: str,
    window: str,
    observed_at: str,
    source_name: str,
    values_arg: str | None,
    actor_arg: str | None,
):
    root = ensure_instance(root)
    actor = resolve_actor(root, actor_arg)
    if actor != "growth":
        raise WorkflowError("记录 publication 指标的 actor 必须是 growth")
    window = require_text("window", window)
    observed_at = require_text("observed_at", observed_at)
    source_name = require_text("source", source_name)
    values = parse_metric_values(values_arg)
    if window is None or not METRIC_WINDOW_RE.fullmatch(window):
        raise WorkflowError("window 必须形如 48h、7d 或 2w")
    if observed_at is None or not valid_offset_time(observed_at):
        raise WorkflowError("observed_at 必须是 offset-aware ISO 8601 时间")
    if source_name is None:
        raise WorkflowError("source 不能为空")

    root, content, package, _card, record, _body = load_publication_for_transition(
        root,
        publication_id,
        allow_stale=True,
    )
    if record.get("status") not in ("published", "reviewed"):
        raise WorkflowError("只有 published publication 可以记录发布指标")
    known_channels = configured_channels(root)
    catalog, catalog_errors = load_metric_catalog(root, known_channels)
    if catalog_errors:
        raise WorkflowError("；".join(f"{error.source}：{error.message}" for error in catalog_errors))
    channel = record.get("channel")
    value_errors = validate_metric_values(values, catalog, "publication", channel)
    if value_errors:
        raise WorkflowError("；".join(value_errors))

    path, metrics, body, metrics_errors = load_publication_metrics(
        package,
        publication_id,
        content["content_id"],
        channel,
        catalog,
    )
    if metrics_errors:
        raise WorkflowError("；".join(f"{error.source}：{error.message}" for error in metrics_errors))
    if metrics is None:
        metrics = {
            "schema_version": SCHEMA_VERSION,
            "record_type": "publication_metrics",
            "publication_id": publication_id,
            "content_id": content["content_id"],
            "snapshots": [],
        }
        body = "\n\n# 指标\n"
    if any(snapshot.get("window") == window for snapshot in metrics["snapshots"]):
        raise WorkflowError(f"重复窗口「{window}」：同一 publication 的窗口不可覆盖")
    now = datetime.now(timezone.utc).isoformat(timespec="microseconds")
    metrics["snapshots"].append(
        {
            "window": window,
            "observed_at": observed_at,
            "source": source_name,
            "recorded_at": now,
            "recorded_by": actor,
            "values": values,
        }
    )
    write_atomic(path, render_card(metrics, body))
    return path.relative_to(root).as_posix()


def load_channel_snapshots(root: Path):
    growth = root / GROWTH_DIR
    path = channel_snapshots_path(root)
    source = (GROWTH_DIR / CHANNEL_SNAPSHOTS_NAME).as_posix()
    if growth.is_symlink():
        return path, None, None, [Diagnostic(GROWTH_DIR.as_posix(), "growth 目录不能是 symlink")]
    if growth.exists() and not growth.is_dir():
        return path, None, None, [Diagnostic(GROWTH_DIR.as_posix(), "growth 必须是目录")]
    if path.is_symlink():
        return path, None, None, [Diagnostic(source, "渠道快照不能是 symlink")]
    if not path.exists():
        return path, None, None, []
    if not path.is_file():
        return path, None, None, [Diagnostic(source, "渠道快照必须是文件")]
    record, body, parse_errors = parse_card_document(path, source)
    if parse_errors:
        return path, None, None, parse_errors
    return path, record, body, []


def validate_channel_snapshots_record(
    source: str,
    record,
    catalog: dict,
    known_channels: dict,
):
    errors = []
    if not isinstance(record, dict):
        return [Diagnostic(source, "渠道快照 frontmatter 必须是 JSON object")]
    errors.extend(validate_record_header(source, record, "channel_snapshots"))
    observations = record.get("observations")
    if not isinstance(observations, list):
        return errors + [Diagnostic(source, "observations 必须是数组")]
    seen = set()
    for index, observation in enumerate(observations):
        label = f"第 {index + 1} 个账号观测"
        if not isinstance(observation, dict):
            errors.append(Diagnostic(source, f"{label} 必须是 object"))
            continue
        channel = observation.get("channel")
        if not isinstance(channel, str) or channel not in known_channels:
            errors.append(Diagnostic(source, f"{label} 使用未知 channel「{channel}」"))
        elif not known_channels[channel]:
            errors.append(Diagnostic(source, f"{label} 使用已停用 channel「{channel}」"))
        observed_at = observation.get("observed_at")
        if not valid_offset_time(observed_at):
            errors.append(Diagnostic(source, f"{label} 的 observed_at 必须是 offset-aware ISO 8601 时间"))
        if isinstance(channel, str) and isinstance(observed_at, str):
            key = (channel, instant_key(observed_at))
            if key in seen:
                errors.append(Diagnostic(source, f"重复观测：{channel} 在 {observed_at}"))
            seen.add(key)
        if not is_nonempty_string(observation.get("source")):
            errors.append(Diagnostic(source, f"{label} 的 source 不能为空"))
        if not valid_offset_time(observation.get("recorded_at")):
            errors.append(Diagnostic(source, f"{label} 的 recorded_at 必须是 offset-aware ISO 8601 时间"))
        if observation.get("recorded_by") != "growth":
            errors.append(Diagnostic(source, f"{label} 的 recorded_by 必须是 growth"))
        if isinstance(channel, str):
            for message in validate_metric_values(
                observation.get("values"),
                catalog,
                "channel",
                channel,
            ):
                errors.append(Diagnostic(source, f"{label}：{message}"))
    return errors


def record_channel_snapshot(
    root: Path,
    channel: str,
    observed_at: str,
    source_name: str,
    values_arg: str | None,
    actor_arg: str | None,
):
    root = ensure_instance(root)
    actor = resolve_actor(root, actor_arg)
    if actor != "growth":
        raise WorkflowError("记录渠道快照的 actor 必须是 growth")
    channel = require_text("channel", channel)
    observed_at = require_text("observed_at", observed_at)
    source_name = require_text("source", source_name)
    values = parse_metric_values(values_arg)
    known_channels = configured_channels(root)
    if channel is None or channel not in known_channels:
        raise WorkflowError(f"未知 channel「{channel}」：必须来自 channels.json")
    if not known_channels[channel]:
        raise WorkflowError(f"channel「{channel}」在 channels.json 里已停用")
    if observed_at is None or not valid_offset_time(observed_at):
        raise WorkflowError("observed_at 必须是 offset-aware ISO 8601 时间")
    if source_name is None:
        raise WorkflowError("source 不能为空")
    catalog, catalog_errors = load_metric_catalog(root, known_channels)
    if catalog_errors:
        raise WorkflowError("；".join(f"{error.source}：{error.message}" for error in catalog_errors))
    value_errors = validate_metric_values(values, catalog, "channel", channel)
    if value_errors:
        raise WorkflowError("；".join(value_errors))

    ensure_local_directory(root, GROWTH_DIR)
    path, record, body, load_errors = load_channel_snapshots(root)
    if load_errors:
        raise WorkflowError("；".join(f"{error.source}：{error.message}" for error in load_errors))
    created = record is None
    if created:
        record = {
            "schema_version": SCHEMA_VERSION,
            "record_type": "channel_snapshots",
            "observations": [],
        }
        body = "\n\n# 渠道快照\n"
    if not created:
        record_errors = validate_channel_snapshots_record(
            (GROWTH_DIR / CHANNEL_SNAPSHOTS_NAME).as_posix(),
            record,
            catalog,
            known_channels,
        )
        if record_errors:
            raise WorkflowError("；".join(f"{error.source}：{error.message}" for error in record_errors))
    if any(
        observation.get("channel") == channel
        and instant_key(observation.get("observed_at")) == instant_key(observed_at)
        for observation in record["observations"]
    ):
        raise WorkflowError(f"重复观测：{channel} 在 {observed_at} 已有记录，不可覆盖")
    now = datetime.now(timezone.utc).isoformat(timespec="microseconds")
    record["observations"].append(
        {
            "channel": channel,
            "observed_at": observed_at,
            "source": source_name,
            "recorded_at": now,
            "recorded_by": actor,
            "values": values,
        }
    )
    write_atomic(path, render_card(record, body))
    return path.relative_to(root).as_posix()


def scan_growth_records(root: Path, publications: list[PublicationRecord]):
    known_channels = configured_channels(root)
    catalog, errors = load_metric_catalog(root, known_channels)
    warnings = []
    publication_metrics = {}
    for publication in publications:
        record = publication.data
        publication_id = record.get("publication_id")
        content_id = record.get("content_id")
        channel = record.get("channel")
        if not all(isinstance(value, str) for value in (publication_id, content_id, channel)):
            continue
        package = root / Path(publication.source).parent
        source = publication_metrics_source(content_id, publication_id)
        path = package / PUBLICATION_METRICS_NAME
        if path.exists() or path.is_symlink():
            if record.get("status") not in ("published", "reviewed"):
                errors.append(Diagnostic(source, "只有 published publication 可以记录指标"))
            _path, metrics, _body, metrics_errors = load_publication_metrics(
                package,
                publication_id,
                content_id,
                channel,
                catalog,
            )
            errors.extend(metrics_errors)
            if metrics is not None:
                publication_metrics[publication_id] = metrics.get("snapshots", [])
        elif record.get("status") in ("published", "reviewed"):
            has_publication_metrics = any(
                definition.get("scope") == "publication"
                and channel in definition.get("channels", ())
                for definition in catalog.values()
            )
            if has_publication_metrics:
                warnings.append(Diagnostic(source, "published publication 尚未记录指标窗口"))

    snapshots_path, snapshots_record, _body, snapshots_errors = load_channel_snapshots(root)
    errors.extend(snapshots_errors)
    observations = []
    if snapshots_record is not None:
        errors.extend(
            validate_channel_snapshots_record(
                (GROWTH_DIR / CHANNEL_SNAPSHOTS_NAME).as_posix(),
                snapshots_record,
                catalog,
                known_channels,
            )
        )
        if isinstance(snapshots_record.get("observations"), list):
            observations = snapshots_record["observations"]
    return GrowthScan(catalog, publication_metrics, observations, errors, warnings)


# ---------- 解析与校验 ----------


def parse_card_document(card: Path, source: str, label: str = "内容卡"):
    try:
        text = card.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        return None, None, [Diagnostic(source, f"无法读取{label}：{error}")]
    lines = text.splitlines(keepends=True)
    if not lines or lines[0].rstrip("\r\n") != "---":
        return None, None, [Diagnostic(source, "frontmatter 必须以 --- 开始")]
    end = None
    for index, line in enumerate(lines[1:], 1):
        if line.rstrip("\r\n") == "---":
            end = index
            break
    if end is None:
        return None, None, [Diagnostic(source, "frontmatter 缺少结束标记 ---")]
    try:
        payload = json.loads("".join(lines[1:end]))
    except json.JSONDecodeError as error:
        return None, None, [Diagnostic(source, f"frontmatter 不是合法 JSON：{error.msg}")]
    if not isinstance(payload, dict):
        return None, None, [Diagnostic(source, "frontmatter 必须是 JSON object")]
    return payload, "".join(lines[end + 1 :]), []


def parse_frontmatter(card: Path, source: str, label: str = "内容卡"):
    payload, _body, errors = parse_card_document(card, source, label)
    return payload, errors


def render_card(record: dict, body: str):
    return "---\n{}\n---\n{}".format(
        json.dumps(record, ensure_ascii=False, indent=2),
        body,
    )


def validate_approval(
    source: str,
    approval,
    content_status,
    known_roles: dict,
    package: Path,
):
    errors = []
    if not isinstance(approval, dict):
        return [Diagnostic(source, "字段 approval 必须是 object")]

    required = {
        "status": str,
        "requested_at": str,
        "requested_by": str,
        "artifact": str,
        "artifact_hash": str,
    }
    for field, expected in required.items():
        if field not in approval:
            errors.append(Diagnostic(source, f"approval 字段 {field} 缺失"))
        elif not isinstance(approval[field], expected):
            errors.append(Diagnostic(source, f"approval 字段 {field} 必须是字符串"))

    approval_status = approval.get("status")
    if isinstance(approval_status, str) and approval_status not in APPROVAL_STATUSES:
        errors.append(Diagnostic(source, f"未知 approval status「{approval_status}」"))
    requested_at = approval.get("requested_at")
    if isinstance(requested_at, str) and not valid_offset_time(requested_at):
        errors.append(Diagnostic(source, "approval requested_at 必须是 offset-aware ISO 8601 时间"))
    requested_by = approval.get("requested_by")
    if isinstance(requested_by, str) and requested_by not in known_roles:
        errors.append(Diagnostic(source, f"approval 使用非法 actor「{requested_by}」"))
    if isinstance(requested_by, str) and requested_by != "content":
        errors.append(Diagnostic(source, "审核请求 actor 必须是 content"))
    if isinstance(approval.get("artifact"), str) and approval["artifact"] != MAIN_DRAFT_NAME:
        errors.append(Diagnostic(source, f"approval artifact 必须是 {MAIN_DRAFT_NAME}"))

    expected_hash = approval.get("artifact_hash")
    if isinstance(expected_hash, str) and not ARTIFACT_HASH_RE.fullmatch(expected_hash):
        errors.append(Diagnostic(source, "approval artifact_hash 必须是 sha256:<64 位十六进制>"))
    draft = package / MAIN_DRAFT_NAME
    if draft.is_symlink():
        errors.append(Diagnostic(source, f"{MAIN_DRAFT_NAME} 不能是 symlink"))
    elif not draft.is_file():
        errors.append(Diagnostic(source, f"缺少固定主稿：{MAIN_DRAFT_NAME}"))
    elif (
        approval_status in ("pending", "approved")
        and isinstance(expected_hash, str)
        and ARTIFACT_HASH_RE.fullmatch(expected_hash)
    ):
        try:
            current_hash = artifact_hash(draft)
        except WorkflowError as error:
            errors.append(Diagnostic(source, str(error)))
        else:
            if current_hash != expected_hash:
                errors.append(
                    Diagnostic(
                        source,
                        f"stale approval：{MAIN_DRAFT_NAME} 已在审核后修改",
                    )
                )

    if approval_status == "pending":
        if content_status != "reviewing":
            errors.append(Diagnostic(source, "pending approval 要求内容状态为 reviewing"))
    elif approval_status in APPROVAL_DECISIONS:
        for field in ("decided_at", "decided_by"):
            if not is_nonempty_string(approval.get(field)):
                errors.append(Diagnostic(source, f"approval 字段 {field} 缺失"))
        decided_at = approval.get("decided_at")
        if isinstance(decided_at, str) and not valid_offset_time(decided_at):
            errors.append(Diagnostic(source, "approval decided_at 必须是 offset-aware ISO 8601 时间"))
        decided_by = approval.get("decided_by")
        if isinstance(decided_by, str) and decided_by not in known_roles:
            errors.append(Diagnostic(source, f"approval 使用非法 actor「{decided_by}」"))
        if isinstance(decided_by, str) and decided_by != "gm":
            errors.append(Diagnostic(source, "审批决定 actor 必须是 gm"))
        # closed 保留最后一次 approved：关闭不会抹掉主稿曾经获批这件事。
        if approval_status == "approved" and content_status not in ("ready", "closed"):
            errors.append(Diagnostic(source, "approved approval 要求内容状态为 ready"))
        if approval_status in ("changes_requested", "rejected"):
            # 退回后内容回到 drafting 等改；也可以直接作废（cancelled 是终态）。
            if content_status not in ("drafting", "cancelled"):
                errors.append(Diagnostic(source, f"{approval_status} 后内容状态必须回到 drafting"))
            if not is_nonempty_string(approval.get("note")):
                errors.append(Diagnostic(source, f"{approval_status} 必须记录 note"))
    return errors


def validate_content_block_events(source: str, block, events: list):
    errors = []
    last = next(
        (
            event
            for event in reversed(events)
            if isinstance(event, dict) and event.get("action") in ("block", "unblock")
        ),
        None,
    )
    if block is None:
        if last is not None and last.get("action") == "block":
            errors.append(Diagnostic(source, "内容没有 block 元数据，但事件里有 block"))
        return errors
    if not isinstance(block, dict):
        return errors
    if last is None or last.get("action") != "block":
        errors.append(Diagnostic(source, "block 元数据与 block/unblock event 不一致"))
        return errors
    expected = {
        "at": block.get("at"),
        "actor": block.get("by"),
        "note": block.get("reason"),
    }
    if any(last.get(field) != value for field, value in expected.items()):
        errors.append(Diagnostic(source, "block 元数据与 block/unblock event 不一致"))
    return errors


def validate_content_cancellation_events(source: str, cancellation: dict, events: list):
    errors = []
    cancel_event = next(
        (
            event
            for event in reversed(events)
            if isinstance(event, dict) and event.get("action") == "cancel"
        ),
        None,
    )
    expected = {
        "at": cancellation.get("cancelled_at"),
        "actor": cancellation.get("cancelled_by"),
        "note": cancellation.get("reason"),
    }
    if cancel_event is None or any(
        cancel_event.get(field) != value for field, value in expected.items()
    ):
        errors.append(Diagnostic(source, "cancellation 与 cancel event 不一致"))
    return errors


def validate_approval_events(source: str, approval: dict, events: list):
    errors = []
    review_event = next(
        (
            event
            for event in reversed(events)
            if isinstance(event, dict) and event.get("action") == "submit_review"
        ),
        None,
    )
    expected_review = {
        "at": approval.get("requested_at"),
        "actor": approval.get("requested_by"),
        "artifact": approval.get("artifact"),
        "artifact_hash": approval.get("artifact_hash"),
    }
    if review_event is None or any(
        review_event.get(field) != value for field, value in expected_review.items()
    ):
        errors.append(Diagnostic(source, "approval 与 submit_review event 不一致"))

    approval_status = approval.get("status")
    if approval_status not in APPROVAL_DECISIONS:
        return errors
    decision_event = next(
        (
            event
            for event in reversed(events)
            if isinstance(event, dict) and event.get("action") == "approval_decision"
        ),
        None,
    )
    expected_decision = {
        "at": approval.get("decided_at"),
        "actor": approval.get("decided_by"),
        "decision": approval_status,
        "artifact": approval.get("artifact"),
        "artifact_hash": approval.get("artifact_hash"),
        "note": approval.get("note"),
    }
    if decision_event is None or any(
        decision_event.get(field) != value for field, value in expected_decision.items()
    ):
        errors.append(Diagnostic(source, "approval 与 approval_decision event 不一致"))
    return errors


def validate_record(
    source: str,
    directory_id: str,
    record: dict,
    known_roles: dict,
    package: Path,
):
    errors = []
    required_types = {
        "schema_version": int,
        "record_type": str,
        "content_id": str,
        "title": str,
        "status": str,
        "created_at": str,
        "actor": str,
        "events": list,
    }
    for field, expected in required_types.items():
        if field not in record:
            errors.append(Diagnostic(source, f"字段 {field} 缺失"))
            continue
        value = record[field]
        valid_type = isinstance(value, expected)
        if expected is int and isinstance(value, bool):
            valid_type = False
        if not valid_type:
            type_name = "整数" if expected is int else expected.__name__
            errors.append(Diagnostic(source, f"字段 {field} 必须是{type_name}"))

    for field in ("source", "summary"):
        if field in record and not is_nonempty_string(record[field]):
            errors.append(Diagnostic(source, f"字段 {field} 必须是非空字符串"))
    if "target_date" in record and not valid_date(record["target_date"]):
        errors.append(Diagnostic(source, "字段 target_date 必须是 YYYY-MM-DD"))
    if "main_draft" in record and record["main_draft"] != MAIN_DRAFT_NAME:
        errors.append(Diagnostic(source, f"字段 main_draft 必须是 {MAIN_DRAFT_NAME}"))

    schema_version = record.get("schema_version")
    if type(schema_version) is int and schema_version != SCHEMA_VERSION:
        errors.append(Diagnostic(source, f"未知 schema_version：{schema_version}"))
    if isinstance(record.get("record_type"), str) and record["record_type"] != "content":
        errors.append(Diagnostic(source, "字段 record_type 必须是 content"))

    content_id = record.get("content_id")
    if isinstance(content_id, str):
        if not CONTENT_ID_RE.fullmatch(content_id):
            errors.append(Diagnostic(source, "字段 content_id 格式非法"))
        if content_id != directory_id:
            errors.append(Diagnostic(source, "字段 content_id 与固定目录名不一致"))
    if isinstance(record.get("title"), str) and not record["title"].strip():
        errors.append(Diagnostic(source, "字段 title 必须是非空字符串"))

    status = record.get("status")
    if isinstance(status, str) and status not in CONTENT_STATUSES:
        errors.append(
            Diagnostic(source, f"未知 status「{status}」：只能是 {'、'.join(CONTENT_STATUSES)}")
        )
    if status in ("drafting", "reviewing", "ready"):
        if record.get("main_draft") != MAIN_DRAFT_NAME:
            errors.append(Diagnostic(source, f"状态 {status} 要求固定主稿 {MAIN_DRAFT_NAME}"))
        draft = package / MAIN_DRAFT_NAME
        if draft.is_symlink():
            errors.append(Diagnostic(source, f"{MAIN_DRAFT_NAME} 不能是 symlink"))
        elif not draft.is_file():
            errors.append(Diagnostic(source, f"缺少固定主稿：{MAIN_DRAFT_NAME}"))

    approval = record.get("approval")
    if approval is not None:
        errors.extend(validate_approval(source, approval, status, known_roles, package))
    elif status in ("reviewing", "ready"):
        errors.append(Diagnostic(source, f"状态 {status} 要求 approval 元数据"))

    cancellation = record.get("cancellation")
    if status == "cancelled":
        if not isinstance(cancellation, dict):
            errors.append(Diagnostic(source, "cancelled 内容要求 cancellation 元数据"))
        else:
            if not valid_offset_time(cancellation.get("cancelled_at")):
                errors.append(
                    Diagnostic(
                        source,
                        "cancellation cancelled_at 必须是 offset-aware ISO 8601 时间",
                    )
                )
            if cancellation.get("cancelled_by") != "gm":
                errors.append(Diagnostic(source, "cancellation cancelled_by 必须是 gm"))
            if not is_nonempty_string(cancellation.get("reason")):
                errors.append(Diagnostic(source, "cancellation reason 不能为空"))
    elif cancellation is not None:
        errors.append(Diagnostic(source, "只有 cancelled 内容可以包含 cancellation"))

    block = record.get("block")
    if block is not None:
        if not isinstance(block, dict):
            errors.append(Diagnostic(source, "字段 block 必须是 object"))
        else:
            if not is_nonempty_string(block.get("reason")):
                errors.append(Diagnostic(source, "block reason 不能为空"))
            if not valid_offset_time(block.get("at")):
                errors.append(
                    Diagnostic(source, "block at 必须是 offset-aware ISO 8601 时间")
                )
            by = block.get("by")
            if not isinstance(by, str) or by not in known_roles:
                errors.append(Diagnostic(source, "block by 使用非法 actor"))

    created_at = record.get("created_at")
    if isinstance(created_at, str) and not valid_offset_time(created_at):
        errors.append(Diagnostic(source, "字段 created_at 必须是 offset-aware ISO 8601 时间"))
    actor = record.get("actor")
    if isinstance(actor, str):
        if not actor.strip():
            errors.append(Diagnostic(source, "字段 actor 必须是非空字符串"))
        elif actor not in known_roles:
            errors.append(Diagnostic(source, f"非法 actor「{actor}」：不在 roles.json 中"))

    events = record.get("events")
    if isinstance(events, list):
        if not events:
            errors.append(Diagnostic(source, "字段 events 至少要有一个 create event"))
        else:
            for index, event in enumerate(events):
                errors.extend(validate_event(source, index, event, known_roles))
            create_event = events[0]
            if isinstance(create_event, dict):
                if create_event.get("action") != "create":
                    errors.append(Diagnostic(source, "第一个 event 必须是 create"))
                if isinstance(created_at, str) and create_event.get("at") != created_at:
                    errors.append(Diagnostic(source, "create event 的 at 必须与 created_at 一致"))
                if isinstance(actor, str) and create_event.get("actor") != actor:
                    errors.append(Diagnostic(source, "create event 的 actor 必须与顶层 actor 一致"))
                if create_event.get("to_status") != "proposed":
                    errors.append(Diagnostic(source, "create event 的 to_status 必须是 proposed"))

            previous_status = "proposed"
            for index, event in enumerate(events[1:], start=1):
                if not isinstance(event, dict):
                    continue
                from_status = event.get("from_status")
                if from_status != previous_status:
                    errors.append(
                        Diagnostic(
                            source,
                            f"第 {index + 1} 个 event 的事件状态链断裂："
                            f"from_status 应为 {previous_status}",
                        )
                    )
                to_status = event.get("to_status")
                if to_status in CONTENT_STATUSES:
                    previous_status = to_status
            if status in CONTENT_STATUSES and previous_status != status:
                errors.append(
                    Diagnostic(source, "事件状态链的最终状态与顶层 status 不一致")
                )
            if isinstance(approval, dict):
                errors.extend(validate_approval_events(source, approval, events))
            if isinstance(cancellation, dict):
                errors.extend(
                    validate_content_cancellation_events(source, cancellation, events)
                )
            errors.extend(validate_content_block_events(source, block, events))
    return errors


def validate_event(source: str, index: int, event, known_roles: dict):
    errors = []
    label = f"第 {index + 1} 个 event"
    if not isinstance(event, dict):
        return [Diagnostic(source, f"{label} 必须是 object")]
    for field in ("action", "at", "actor"):
        if field not in event:
            errors.append(Diagnostic(source, f"{label} 字段 {field} 缺失"))
        elif not isinstance(event[field], str):
            errors.append(Diagnostic(source, f"{label} 字段 {field} 必须是字符串"))
    at = event.get("at")
    if isinstance(at, str) and not valid_offset_time(at):
        errors.append(Diagnostic(source, f"{label} 的 at 必须是 offset-aware ISO 8601 时间"))
    actor = event.get("actor")
    if isinstance(actor, str) and actor not in known_roles:
        errors.append(Diagnostic(source, f"{label} 使用非法 actor「{actor}」"))

    action = event.get("action")
    known_actions = (
        "create",
        "transition",
        "submit_review",
        "approval_decision",
        "close",
        "cancel",
        "block",
        "unblock",
    )
    if isinstance(action, str) and action not in known_actions:
        errors.append(Diagnostic(source, f"{label} 使用未知 action「{action}」"))
    expected_actors = {
        "transition": "content",
        "submit_review": "content",
        "approval_decision": "gm",
        "close": "gm",
        "cancel": "gm",
    }
    expected_actor = expected_actors.get(action)
    if expected_actor is not None and actor != expected_actor:
        errors.append(
            Diagnostic(source, f"{label} {action} actor 必须是 {expected_actor}")
        )
    if action in ("block", "unblock") and actor not in BLOCK_ACTORS:
        errors.append(Diagnostic(source, f"{label} {action} actor 必须是 gm 或 content"))
    if action in (
        "transition",
        "submit_review",
        "approval_decision",
        "close",
        "cancel",
        "block",
        "unblock",
    ):
        for field in ("from_status", "to_status"):
            value = event.get(field)
            if value not in CONTENT_STATUSES:
                errors.append(Diagnostic(source, f"{label} 字段 {field} 是非法内容状态"))
    if action == "cancel" and not is_nonempty_string(event.get("note")):
        errors.append(Diagnostic(source, f"{label} cancel 必须记录 note 说明原因"))
    if action in ("submit_review", "approval_decision"):
        if event.get("artifact") != MAIN_DRAFT_NAME:
            errors.append(Diagnostic(source, f"{label} artifact 必须是 {MAIN_DRAFT_NAME}"))
        if not isinstance(event.get("artifact_hash"), str) or not ARTIFACT_HASH_RE.fullmatch(
            event["artifact_hash"]
        ):
            errors.append(Diagnostic(source, f"{label} artifact_hash 非法"))
    if action == "approval_decision":
        decision = event.get("decision")
        if decision not in APPROVAL_DECISIONS:
            errors.append(Diagnostic(source, f"{label} decision 非法"))
        if decision in ("changes_requested", "rejected") and not is_nonempty_string(
            event.get("note")
        ):
            errors.append(Diagnostic(source, f"{label} 的 {decision} 必须记录 note"))
    return errors


def validate_publication_approval(
    source: str,
    approval,
    publication_status,
    known_roles: dict,
    package: Path,
):
    errors = []
    if not isinstance(approval, dict):
        return [Diagnostic(source, "字段 approval 必须是 object")]
    for field in (
        "status",
        "requested_at",
        "requested_by",
        "artifact",
        "artifact_hash",
    ):
        if not is_nonempty_string(approval.get(field)):
            errors.append(Diagnostic(source, f"approval 字段 {field} 缺失"))

    approval_status = approval.get("status")
    if isinstance(approval_status, str) and approval_status not in APPROVAL_STATUSES:
        errors.append(Diagnostic(source, f"未知 approval status「{approval_status}」"))
    requested_at = approval.get("requested_at")
    if isinstance(requested_at, str) and not valid_offset_time(requested_at):
        errors.append(Diagnostic(source, "approval requested_at 必须是 offset-aware ISO 8601 时间"))
    requested_by = approval.get("requested_by")
    if isinstance(requested_by, str) and requested_by not in known_roles:
        errors.append(Diagnostic(source, f"approval 使用非法 actor「{requested_by}」"))
    if isinstance(requested_by, str) and requested_by != "content":
        errors.append(Diagnostic(source, "渠道稿审核请求 actor 必须是 content"))
    if approval.get("artifact") != CHANNEL_DRAFT_NAME:
        errors.append(Diagnostic(source, f"approval artifact 必须是 {CHANNEL_DRAFT_NAME}"))

    expected_hash = approval.get("artifact_hash")
    if isinstance(expected_hash, str) and not ARTIFACT_HASH_RE.fullmatch(expected_hash):
        errors.append(Diagnostic(source, "approval artifact_hash 必须是 sha256:<64 位十六进制>"))
    draft = package / CHANNEL_DRAFT_NAME
    if draft.is_symlink():
        errors.append(Diagnostic(source, f"{CHANNEL_DRAFT_NAME} 不能是 symlink"))
    elif not draft.is_file():
        errors.append(Diagnostic(source, f"缺少固定渠道稿：{CHANNEL_DRAFT_NAME}"))
    elif (
        approval_status in ("pending", "approved")
        and isinstance(expected_hash, str)
        and ARTIFACT_HASH_RE.fullmatch(expected_hash)
    ):
        try:
            current_hash = artifact_hash(draft)
        except WorkflowError as error:
            errors.append(Diagnostic(source, str(error)))
        else:
            if current_hash != expected_hash:
                errors.append(
                    Diagnostic(
                        source,
                        f"stale approval：{CHANNEL_DRAFT_NAME} 已在审核后修改",
                    )
                )

    if approval_status == "pending":
        if publication_status != "reviewing":
            errors.append(Diagnostic(source, "pending approval 要求 publication 为 reviewing"))
    elif approval_status in APPROVAL_DECISIONS:
        for field in ("decided_at", "decided_by"):
            if not is_nonempty_string(approval.get(field)):
                errors.append(Diagnostic(source, f"approval 字段 {field} 缺失"))
        decided_at = approval.get("decided_at")
        if isinstance(decided_at, str) and not valid_offset_time(decided_at):
            errors.append(Diagnostic(source, "approval decided_at 必须是 offset-aware ISO 8601 时间"))
        decided_by = approval.get("decided_by")
        if isinstance(decided_by, str) and decided_by not in known_roles:
            errors.append(Diagnostic(source, f"approval 使用非法 actor「{decided_by}」"))
        if isinstance(decided_by, str) and decided_by != "gm":
            errors.append(Diagnostic(source, "渠道稿审批决定 actor 必须是 gm"))
        if approval_status == "approved" and publication_status not in (
            "reviewing",
            "scheduled",
            "published",
            "reviewed",
            "cancelled",
        ):
            errors.append(Diagnostic(source, "approved approval 要求 publication 已完成审核"))
        if approval_status in ("changes_requested", "rejected"):
            if publication_status != "adapting":
                errors.append(Diagnostic(source, f"{approval_status} 后 publication 必须回到 adapting"))
            if not is_nonempty_string(approval.get("note")):
                errors.append(Diagnostic(source, f"{approval_status} 必须记录 note"))
    return errors


def validate_publication_event(source: str, index: int, event, known_roles: dict):
    errors = []
    label = f"第 {index + 1} 个 publication event"
    if not isinstance(event, dict):
        return [Diagnostic(source, f"{label} 必须是 object")]
    for field in ("action", "at", "actor"):
        if field not in event:
            errors.append(Diagnostic(source, f"{label} 字段 {field} 缺失"))
        elif not isinstance(event[field], str):
            errors.append(Diagnostic(source, f"{label} 字段 {field} 必须是字符串"))
    at = event.get("at")
    if isinstance(at, str) and not valid_offset_time(at):
        errors.append(Diagnostic(source, f"{label} 的 at 必须是 offset-aware ISO 8601 时间"))
    actor = event.get("actor")
    if isinstance(actor, str) and actor not in known_roles:
        errors.append(Diagnostic(source, f"{label} 使用非法 actor「{actor}」"))
    action = event.get("action")
    known_actions = (
        "create",
        "submit_review",
        "approval_decision",
        "schedule",
        "reschedule",
        "publish",
        "review",
        "cancel",
    )
    if isinstance(action, str) and action not in known_actions:
        errors.append(Diagnostic(source, f"{label} 使用未知 action「{action}」"))
    expected_actors = {
        "create": "gm",
        "submit_review": "content",
        "approval_decision": "gm",
        "schedule": "gm",
        "reschedule": "gm",
        "publish": "gm",
        "cancel": "gm",
    }
    expected_actor = expected_actors.get(action)
    if expected_actor is not None and actor != expected_actor:
        errors.append(
            Diagnostic(source, f"{label} {action} actor 必须是 {expected_actor}")
        )
    if action in known_actions[1:]:
        for field in ("from_status", "to_status"):
            if event.get(field) not in PUBLICATION_STATUSES:
                errors.append(Diagnostic(source, f"{label} 字段 {field} 是非法 publication 状态"))
    if action in ("submit_review", "approval_decision"):
        if event.get("artifact") != CHANNEL_DRAFT_NAME:
            errors.append(Diagnostic(source, f"{label} artifact 必须是 {CHANNEL_DRAFT_NAME}"))
        artifact_hash_value = event.get("artifact_hash")
        if not isinstance(artifact_hash_value, str) or not ARTIFACT_HASH_RE.fullmatch(
            artifact_hash_value
        ):
            errors.append(Diagnostic(source, f"{label} artifact_hash 非法"))
    if action == "approval_decision":
        decision = event.get("decision")
        if decision not in APPROVAL_DECISIONS:
            errors.append(Diagnostic(source, f"{label} decision 非法"))
        if decision in ("changes_requested", "rejected") and not is_nonempty_string(
            event.get("note")
        ):
            errors.append(Diagnostic(source, f"{label} 的 {decision} 必须记录 note"))
    if action in ("schedule", "reschedule"):
        if not planned_time_matches_timezone(
            event.get("planned_at"),
            event.get("timezone"),
        ):
            errors.append(Diagnostic(source, f"{label} planned_at 与 timezone 非法或不一致"))
    if action == "publish":
        if event.get("to_status") != "published":
            errors.append(Diagnostic(source, f"{label} publish event 的 to_status 必须是 published"))
        if not valid_offset_time(event.get("published_at")):
            errors.append(Diagnostic(source, f"{label} published_at 必须是 offset-aware ISO 8601 时间"))
        if not valid_public_url(event.get("url")):
            errors.append(Diagnostic(source, f"{label} url 必须是 HTTP(S) URL"))
        external_id = event.get("external_id")
        if external_id is not None and not is_nonempty_string(external_id):
            errors.append(Diagnostic(source, f"{label} external_id 不能为空"))
    if action == "review":
        if event.get("from_status") != "published" or event.get("to_status") != "reviewed":
            errors.append(Diagnostic(source, f"{label} review 状态必须是 published → reviewed"))
        if event.get("conclusion") not in REVIEW_CONCLUSIONS:
            errors.append(Diagnostic(source, f"{label} conclusion 非法"))
        if not is_nonempty_string(event.get("next_action")):
            errors.append(Diagnostic(source, f"{label} next_action 不能为空"))
        if not isinstance(event.get("metric_windows"), list):
            errors.append(Diagnostic(source, f"{label} metric_windows 必须是数组"))
        exception_reason = event.get("exception_reason")
        if exception_reason is None and actor != "growth":
            errors.append(Diagnostic(source, f"{label} 正常复盘 actor 必须是 growth"))
        if exception_reason is not None:
            if actor != "gm":
                errors.append(Diagnostic(source, f"{label} 数据例外 actor 必须是 gm"))
            if not is_nonempty_string(exception_reason):
                errors.append(Diagnostic(source, f"{label} exception_reason 不能为空"))
    if action in ("reschedule", "cancel") and not is_nonempty_string(event.get("note")):
        errors.append(Diagnostic(source, f"{label} {action} 必须记录 note"))
    return errors


def validate_publication_record(
    source: str,
    directory_id: str,
    parent_content_id: str,
    record: dict,
    known_roles: dict,
    known_channels: dict,
    package: Path,
):
    errors = []
    required_types = {
        "schema_version": int,
        "record_type": str,
        "publication_id": str,
        "content_id": str,
        "channel": str,
        "status": str,
        "created_at": str,
        "actor": str,
        "channel_draft": str,
        "events": list,
    }
    for field, expected in required_types.items():
        if field not in record:
            errors.append(Diagnostic(source, f"字段 {field} 缺失"))
            continue
        value = record[field]
        valid_type = isinstance(value, expected)
        if expected is int and isinstance(value, bool):
            valid_type = False
        if not valid_type:
            type_name = "整数" if expected is int else expected.__name__
            errors.append(Diagnostic(source, f"字段 {field} 必须是{type_name}"))

    schema_version = record.get("schema_version")
    if type(schema_version) is int and schema_version != SCHEMA_VERSION:
        errors.append(Diagnostic(source, f"未知 schema_version：{schema_version}"))
    if isinstance(record.get("record_type"), str) and record["record_type"] != "publication":
        errors.append(Diagnostic(source, "字段 record_type 必须是 publication"))

    publication_id = record.get("publication_id")
    if isinstance(publication_id, str):
        if not PUBLICATION_ID_RE.fullmatch(publication_id):
            errors.append(Diagnostic(source, "字段 publication_id 格式非法"))
        if publication_id != directory_id:
            errors.append(Diagnostic(source, "字段 publication_id 与固定目录名不一致"))
    content_id = record.get("content_id")
    if isinstance(content_id, str) and content_id != parent_content_id:
        errors.append(
            Diagnostic(
                source,
                f"断裂 content_id「{content_id}」：与所属内容包不一致",
            )
        )
    channel = record.get("channel")
    if isinstance(channel, str):
        if channel not in known_channels:
            errors.append(Diagnostic(source, f"未知 channel「{channel}」"))
        elif not known_channels[channel]:
            errors.append(Diagnostic(source, f"channel「{channel}」已停用"))

    status = record.get("status")
    if isinstance(status, str) and status not in PUBLICATION_STATUSES:
        errors.append(
            Diagnostic(
                source,
                f"未知 publication status「{status}」：只能是 "
                + "、".join(PUBLICATION_STATUSES),
            )
        )
    if record.get("channel_draft") != CHANNEL_DRAFT_NAME:
        errors.append(Diagnostic(source, f"字段 channel_draft 必须是 {CHANNEL_DRAFT_NAME}"))
    required = record.get("required", True)
    if not isinstance(required, bool):
        errors.append(Diagnostic(source, "字段 required 必须是 boolean"))
    required_windows = record.get("required_metric_windows", [])
    if not isinstance(required_windows, list):
        errors.append(Diagnostic(source, "字段 required_metric_windows 必须是数组"))
        required_windows = []
    else:
        if any(
            not isinstance(window, str) or not METRIC_WINDOW_RE.fullmatch(window)
            for window in required_windows
        ):
            errors.append(Diagnostic(source, "required_metric_windows 含非法窗口"))
        if len(required_windows) != len(set(required_windows)):
            errors.append(Diagnostic(source, "required_metric_windows 不能重复"))
        if required is False and required_windows:
            errors.append(Diagnostic(source, "可选 publication 不能声明 required_metric_windows"))
    draft = package / CHANNEL_DRAFT_NAME
    if draft.is_symlink():
        errors.append(Diagnostic(source, f"{CHANNEL_DRAFT_NAME} 不能是 symlink"))
    elif not draft.is_file():
        errors.append(Diagnostic(source, f"缺少固定渠道稿：{CHANNEL_DRAFT_NAME}"))

    approval = record.get("approval")
    if approval is not None:
        errors.extend(
            validate_publication_approval(
                source,
                approval,
                status,
                known_roles,
                package,
            )
        )
    elif status in ("reviewing", "scheduled", "published", "reviewed"):
        errors.append(Diagnostic(source, f"状态 {status} 要求 approval 元数据"))

    schedule = record.get("schedule")
    if schedule is not None:
        if not isinstance(schedule, dict):
            errors.append(Diagnostic(source, "字段 schedule 必须是 object"))
        else:
            if not planned_time_matches_timezone(
                schedule.get("planned_at"),
                schedule.get("timezone"),
            ):
                errors.append(Diagnostic(source, "schedule planned_at 与 timezone 非法或不一致"))
            updated_at = schedule.get("updated_at")
            if not valid_offset_time(updated_at):
                errors.append(Diagnostic(source, "schedule updated_at 必须是 offset-aware ISO 8601 时间"))
            updated_by = schedule.get("updated_by")
            if updated_by != "gm":
                errors.append(Diagnostic(source, "schedule updated_by 必须是 gm"))
    elif status in ("scheduled", "published", "reviewed"):
        errors.append(Diagnostic(source, f"{status} publication 要求 schedule 元数据"))

    publication = record.get("publication")
    if status in ("published", "reviewed"):
        if not isinstance(publication, dict):
            errors.append(Diagnostic(source, f"{status} publication 要求 publication 发布事实"))
        else:
            if not valid_offset_time(publication.get("published_at")):
                errors.append(Diagnostic(source, "publication published_at 必须是 offset-aware ISO 8601 时间"))
            if not valid_public_url(publication.get("url")):
                errors.append(Diagnostic(source, "publication url 必须是 HTTP(S) URL"))
            if not valid_offset_time(publication.get("recorded_at")):
                errors.append(Diagnostic(source, "publication recorded_at 必须是 offset-aware ISO 8601 时间"))
            if publication.get("recorded_by") != "gm":
                errors.append(Diagnostic(source, "publication recorded_by 必须是 gm"))
            external_id = publication.get("external_id")
            if external_id is not None and not is_nonempty_string(external_id):
                errors.append(Diagnostic(source, "publication external_id 不能为空"))
    elif publication is not None:
        errors.append(Diagnostic(source, "只有 published 或 reviewed publication 可以包含 publication 发布事实"))

    review = record.get("review")
    if status == "reviewed":
        if not isinstance(review, dict):
            errors.append(Diagnostic(source, "reviewed publication 要求 review 元数据"))
        else:
            if review.get("status") != "done":
                errors.append(Diagnostic(source, "review status 必须是 done"))
            if review.get("conclusion") not in REVIEW_CONCLUSIONS:
                errors.append(Diagnostic(source, "review conclusion 非法"))
            if not is_nonempty_string(review.get("next_action")):
                errors.append(Diagnostic(source, "review next_action 不能为空"))
            if not valid_offset_time(review.get("recorded_at")):
                errors.append(Diagnostic(source, "review recorded_at 必须是 offset-aware ISO 8601 时间"))
            windows = review.get("metric_windows")
            if not isinstance(windows, list) or any(
                not isinstance(window, str) or not METRIC_WINDOW_RE.fullmatch(window)
                for window in (windows or [])
            ):
                errors.append(Diagnostic(source, "review metric_windows 必须是合法窗口数组"))
            exception_reason = review.get("exception_reason")
            expected_actor = "gm" if exception_reason is not None else "growth"
            if review.get("recorded_by") != expected_actor:
                errors.append(Diagnostic(source, f"review recorded_by 必须是 {expected_actor}"))
            if exception_reason is not None and not is_nonempty_string(exception_reason):
                errors.append(Diagnostic(source, "review exception_reason 不能为空"))
    elif review is not None:
        errors.append(Diagnostic(source, "只有 reviewed publication 可以包含 review"))

    cancellation = record.get("cancellation")
    if status == "cancelled":
        if not isinstance(cancellation, dict):
            errors.append(Diagnostic(source, "cancelled publication 要求 cancellation 元数据"))
        else:
            if not valid_offset_time(cancellation.get("cancelled_at")):
                errors.append(Diagnostic(source, "cancellation cancelled_at 必须是 offset-aware ISO 8601 时间"))
            if cancellation.get("cancelled_by") != "gm":
                errors.append(Diagnostic(source, "cancellation cancelled_by 必须是 gm"))
            if not is_nonempty_string(cancellation.get("reason")):
                errors.append(Diagnostic(source, "cancellation reason 不能为空"))
    elif cancellation is not None:
        errors.append(Diagnostic(source, "只有 cancelled publication 可以包含 cancellation"))

    created_at = record.get("created_at")
    if isinstance(created_at, str) and not valid_offset_time(created_at):
        errors.append(Diagnostic(source, "字段 created_at 必须是 offset-aware ISO 8601 时间"))
    actor = record.get("actor")
    if isinstance(actor, str):
        if actor not in known_roles:
            errors.append(Diagnostic(source, f"非法 actor「{actor}」：不在 roles.json 中"))
        elif actor != "gm":
            errors.append(Diagnostic(source, "publication create actor 必须是 gm"))

    events = record.get("events")
    if isinstance(events, list):
        if not events:
            errors.append(Diagnostic(source, "字段 events 至少要有一个 create event"))
        else:
            for index, event in enumerate(events):
                errors.extend(
                    validate_publication_event(source, index, event, known_roles)
                )
            create_event = events[0]
            if isinstance(create_event, dict):
                if create_event.get("action") != "create":
                    errors.append(Diagnostic(source, "第一个 publication event 必须是 create"))
                if isinstance(created_at, str) and create_event.get("at") != created_at:
                    errors.append(Diagnostic(source, "create event 的 at 必须与 created_at 一致"))
                if isinstance(actor, str) and create_event.get("actor") != actor:
                    errors.append(Diagnostic(source, "create event 的 actor 必须与顶层 actor 一致"))
                if create_event.get("to_status") != "adapting":
                    errors.append(Diagnostic(source, "create event 的 to_status 必须是 adapting"))

            previous_status = "adapting"
            for index, event in enumerate(events[1:], start=1):
                if not isinstance(event, dict):
                    continue
                if event.get("from_status") != previous_status:
                    errors.append(
                        Diagnostic(
                            source,
                            f"第 {index + 1} 个 publication event 的事件状态链断裂："
                            f"from_status 应为 {previous_status}",
                        )
                    )
                to_status = event.get("to_status")
                if to_status in PUBLICATION_STATUSES:
                    previous_status = to_status
            if status in PUBLICATION_STATUSES and previous_status != status:
                errors.append(
                    Diagnostic(
                        source,
                        "publication 事件状态链的最终状态与顶层 status 不一致",
                    )
                )
            if isinstance(approval, dict):
                errors.extend(validate_approval_events(source, approval, events))
            if isinstance(schedule, dict):
                schedule_event = next(
                    (
                        event
                        for event in reversed(events)
                        if isinstance(event, dict)
                        and event.get("action") in ("schedule", "reschedule")
                    ),
                    None,
                )
                if schedule_event is None or any(
                    (
                        schedule_event.get("planned_at") != schedule.get("planned_at"),
                        schedule_event.get("timezone") != schedule.get("timezone"),
                        schedule_event.get("at") != schedule.get("updated_at"),
                        schedule_event.get("actor") != schedule.get("updated_by"),
                    )
                ):
                    errors.append(Diagnostic(source, "schedule 与排期 event 不一致"))
            if isinstance(publication, dict):
                publish_event = next(
                    (
                        event
                        for event in reversed(events)
                        if isinstance(event, dict) and event.get("action") == "publish"
                    ),
                    None,
                )
                if publish_event is None or any(
                    (
                        publish_event.get("at") != publication.get("recorded_at"),
                        publish_event.get("actor") != publication.get("recorded_by"),
                        publish_event.get("published_at") != publication.get("published_at"),
                        publish_event.get("url") != publication.get("url"),
                        publish_event.get("external_id") != publication.get("external_id"),
                    )
                ):
                    errors.append(Diagnostic(source, "publication 发布事实与 publish event 不一致"))
            if isinstance(review, dict):
                review_event = next(
                    (
                        event
                        for event in reversed(events)
                        if isinstance(event, dict) and event.get("action") == "review"
                    ),
                    None,
                )
                if review_event is None or any(
                    (
                        review_event.get("at") != review.get("recorded_at"),
                        review_event.get("actor") != review.get("recorded_by"),
                        review_event.get("conclusion") != review.get("conclusion"),
                        review_event.get("next_action") != review.get("next_action"),
                        review_event.get("metric_windows") != review.get("metric_windows"),
                        review_event.get("exception_reason") != review.get("exception_reason"),
                    )
                ):
                    errors.append(Diagnostic(source, "review 与 review event 不一致"))
            if isinstance(cancellation, dict):
                cancel_event = next(
                    (
                        event
                        for event in reversed(events)
                        if isinstance(event, dict) and event.get("action") == "cancel"
                    ),
                    None,
                )
                if cancel_event is None or any(
                    (
                        cancel_event.get("at") != cancellation.get("cancelled_at"),
                        cancel_event.get("actor") != cancellation.get("cancelled_by"),
                        cancel_event.get("note") != cancellation.get("reason"),
                    )
                ):
                    errors.append(Diagnostic(source, "cancellation 与 cancel event 不一致"))
    return errors


def scan_content_records(root: Path):
    root = ensure_instance(root)
    content_root = root / CONTENT_DIR
    records = []
    publication_records = []
    errors = []
    warnings = []
    if not content_root.exists():
        return root, records, publication_records, errors, warnings
    if content_root.is_symlink() or not content_root.is_dir():
        return (
            root,
            records,
            publication_records,
            [Diagnostic(CONTENT_DIR.as_posix(), "内容根目录不能是 symlink，且必须是目录")],
            warnings,
        )

    known_roles = configured_roles(root)
    known_channels = configured_channels(root)
    with os.scandir(content_root) as scanner:
        entries = sorted(scanner, key=lambda entry: entry.name)
    for entry in entries:
        source_dir = (CONTENT_DIR / entry.name).as_posix()
        if entry.is_symlink():
            errors.append(Diagnostic(source_dir, "内容包不能是 symlink"))
            continue
        if not entry.is_dir(follow_symlinks=False):
            continue
        content_package = Path(entry.path)
        card = content_package / CARD_NAME
        source = (CONTENT_DIR / entry.name / CARD_NAME).as_posix()
        if card.is_symlink():
            errors.append(Diagnostic(source, "内容卡不能是 symlink"))
            continue
        if not card.is_file():
            publications = content_package / PUBLICATIONS_DIR_NAME
            if publications.is_symlink():
                errors.append(
                    Diagnostic(
                        (CONTENT_DIR / entry.name / PUBLICATIONS_DIR_NAME).as_posix(),
                        "publications 目录不能是 symlink",
                    )
                )
            elif publications.is_dir() and any(publications.iterdir()):
                errors.append(Diagnostic(source, "publication 引用缺失内容卡"))
            else:
                warnings.append(Diagnostic(source, "内容包缺少内容卡，跳过"))
            continue
        record, card_errors = parse_frontmatter(card, source)
        errors.extend(card_errors)
        if record is None:
            continue
        errors.extend(
            validate_record(source, entry.name, record, known_roles, content_package)
        )
        records.append(ContentRecord(source, record))

        publications = content_package / PUBLICATIONS_DIR_NAME
        publications_source = (
            CONTENT_DIR / entry.name / PUBLICATIONS_DIR_NAME
        ).as_posix()
        if publications.is_symlink():
            errors.append(Diagnostic(publications_source, "publications 目录不能是 symlink"))
            continue
        if not publications.exists():
            continue
        if not publications.is_dir():
            errors.append(Diagnostic(publications_source, "publications 必须是目录"))
            continue
        with os.scandir(publications) as publication_scanner:
            publication_entries = sorted(
                publication_scanner,
                key=lambda publication_entry: publication_entry.name,
            )
        for publication_entry in publication_entries:
            publication_source_dir = (
                CONTENT_DIR
                / entry.name
                / PUBLICATIONS_DIR_NAME
                / publication_entry.name
            )
            if publication_entry.is_symlink():
                errors.append(
                    Diagnostic(publication_source_dir.as_posix(), "publication 包不能是 symlink")
                )
                continue
            if not publication_entry.is_dir(follow_symlinks=False):
                continue
            publication_package = Path(publication_entry.path)
            publication_card = publication_package / PUBLICATION_CARD_NAME
            publication_source = (
                publication_source_dir / PUBLICATION_CARD_NAME
            ).as_posix()
            if publication_card.is_symlink():
                errors.append(Diagnostic(publication_source, "发布卡不能是 symlink"))
                continue
            if not publication_card.is_file():
                warnings.append(Diagnostic(publication_source, "publication 包缺少发布卡，跳过"))
                continue
            publication, publication_errors = parse_frontmatter(
                publication_card,
                publication_source,
            )
            errors.extend(publication_errors)
            if publication is None:
                continue
            errors.extend(
                validate_publication_record(
                    publication_source,
                    publication_entry.name,
                    entry.name,
                    publication,
                    known_roles,
                    known_channels,
                    publication_package,
                )
            )
            publication_records.append(
                PublicationRecord(publication_source, publication)
            )

    by_id = {}
    for record in records:
        content_id = record.data.get("content_id")
        if not isinstance(content_id, str):
            continue
        by_id.setdefault(content_id, []).append(record.source)
    for content_id, sources in sorted(by_id.items()):
        if len(sources) < 2:
            continue
        joined = "、".join(sources)
        for source in sources:
            errors.append(Diagnostic(source, f"重复 content_id「{content_id}」：{joined}"))

    publications_by_id = {}
    for record in publication_records:
        publication_id = record.data.get("publication_id")
        if not isinstance(publication_id, str):
            continue
        publications_by_id.setdefault(publication_id, []).append(record.source)
    for publication_id, sources in sorted(publications_by_id.items()):
        if len(sources) < 2:
            continue
        joined = "、".join(sources)
        for source in sources:
            errors.append(
                Diagnostic(
                    source,
                    f"重复 publication_id「{publication_id}」：{joined}",
                )
            )

    content_statuses = {
        record.data.get("content_id"): record.data.get("status")
        for record in records
        if isinstance(record.data.get("content_id"), str)
    }
    for publication in publication_records:
        if publication.data.get("status") != "scheduled":
            continue
        content_id = publication.data.get("content_id")
        if content_statuses.get(content_id) != "ready":
            errors.append(
                Diagnostic(
                    publication.source,
                    "scheduled publication 引用的内容必须保持 ready",
                )
            )
    return root, records, publication_records, errors, warnings


def print_diagnostics(errors, warnings):
    for warning in warnings:
        print(f"警告：{warning.source}：{warning.message}")
    for error in errors:
        print(f"错误：{error.source}：{error.message}", file=sys.stderr)


def validate_content(root: Path):
    root, records, publications, errors, warnings = scan_content_records(root)
    growth = scan_growth_records(root, publications)
    errors.extend(growth.errors)
    warnings.extend(growth.warnings)
    if errors:
        print_diagnostics(errors, warnings)
        return 1
    print_diagnostics([], warnings)
    print(
        f"校验通过：{len(records)} 条内容记录，"
        f"{len(publications)} 条 publication 记录，"
        f"{len(growth.catalog)} 个指标定义"
    )
    return 0


# ---------- 状态转换与审批 ----------


def load_content_for_transition(root: Path, content_id: str, allow_stale=False):
    root = ensure_instance(root)
    if not CONTENT_ID_RE.fullmatch(content_id):
        raise WorkflowError(f"content_id 格式非法：{content_id}")
    content_root = root / CONTENT_DIR
    if content_root.is_symlink() or not content_root.is_dir():
        raise WorkflowError(f"内容根目录不能是 symlink，且必须是目录：{CONTENT_DIR}")
    package = content_root / content_id
    if package.is_symlink() or not package.is_dir():
        raise WorkflowError(f"内容包不存在或不是安全目录：{CONTENT_DIR / content_id}")
    card = package / CARD_NAME
    if card.is_symlink() or not card.is_file():
        raise WorkflowError(f"内容卡不存在或是 symlink：{CONTENT_DIR / content_id / CARD_NAME}")
    source = (CONTENT_DIR / content_id / CARD_NAME).as_posix()
    record, body, parse_errors = parse_card_document(card, source)
    if parse_errors:
        raise WorkflowError("；".join(error.message for error in parse_errors))
    errors = validate_record(source, content_id, record, configured_roles(root), package)
    if allow_stale:
        errors = [error for error in errors if "stale approval" not in error.message]
    if errors:
        raise WorkflowError("；".join(f"{error.source}：{error.message}" for error in errors))
    return root, package, card, record, body


def load_publication_for_transition(
    root: Path,
    publication_id: str,
    allow_stale=False,
):
    root = ensure_instance(root)
    if not PUBLICATION_ID_RE.fullmatch(publication_id):
        raise WorkflowError(f"publication_id 格式非法：{publication_id}")
    content_root = root / CONTENT_DIR
    if content_root.is_symlink() or not content_root.is_dir():
        raise WorkflowError(f"内容根目录不能是 symlink，且必须是目录：{CONTENT_DIR}")

    matches = []
    with os.scandir(content_root) as scanner:
        content_entries = sorted(scanner, key=lambda entry: entry.name)
    for entry in content_entries:
        if entry.is_symlink():
            raise WorkflowError(f"内容包不能是 symlink：{CONTENT_DIR / entry.name}")
        if not entry.is_dir(follow_symlinks=False):
            continue
        publications = Path(entry.path) / PUBLICATIONS_DIR_NAME
        if publications.is_symlink():
            raise WorkflowError(
                f"publications 目录不能是 symlink："
                f"{CONTENT_DIR / entry.name / PUBLICATIONS_DIR_NAME}"
            )
        if not publications.is_dir():
            continue
        candidate = publications / publication_id
        if candidate.exists() or candidate.is_symlink():
            matches.append((entry.name, candidate))
    if not matches:
        raise WorkflowError(f"找不到 publication：{publication_id}")
    if len(matches) > 1:
        raise WorkflowError(f"重复 publication_id：{publication_id}")

    content_id, package = matches[0]
    if package.is_symlink() or not package.is_dir():
        raise WorkflowError(f"publication 包不存在或不是安全目录：{publication_id}")
    _root, _content_package, _content_card, content, _content_body = (
        load_content_for_transition(root, content_id, allow_stale=allow_stale)
    )
    card = package / PUBLICATION_CARD_NAME
    if card.is_symlink() or not card.is_file():
        raise WorkflowError(f"发布卡不存在或是 symlink：{card.relative_to(root)}")
    source = card.relative_to(root).as_posix()
    record, body, parse_errors = parse_card_document(card, source)
    if parse_errors:
        raise WorkflowError("；".join(error.message for error in parse_errors))
    errors = validate_publication_record(
        source,
        publication_id,
        content_id,
        record,
        configured_roles(root),
        configured_channels(root),
        package,
    )
    if allow_stale:
        errors = [error for error in errors if "stale approval" not in error.message]
    if errors:
        raise WorkflowError("；".join(f"{error.source}：{error.message}" for error in errors))
    return root, content, package, card, record, body


def transition_publication(
    root: Path,
    publication_id: str,
    to_status: str | None,
    decision: str | None,
    actor_arg: str | None,
    note_arg: str | None,
    planned_at_arg: str | None,
    timezone_arg: str | None,
    actual_at_arg: str | None,
    url_arg: str | None,
    external_id_arg: str | None,
    conclusion_arg: str | None,
    next_action_arg: str | None,
    exception_reason_arg: str | None,
):
    actor = resolve_actor(ensure_instance(root), actor_arg)
    note = require_text("note", note_arg)
    planned_at = require_text("planned_at", planned_at_arg)
    timezone_name = require_text("timezone", timezone_arg)
    actual_at = require_text("actual_at", actual_at_arg)
    publication_url = require_text("url", url_arg)
    external_id = require_text("external_id", external_id_arg)
    conclusion = require_text("conclusion", conclusion_arg)
    next_action = require_text("next_action", next_action_arg)
    exception_reason = require_text("exception_reason", exception_reason_arg)
    allow_stale = to_status in ("reviewing", "cancelled")
    root, content, package, card, record, body = load_publication_for_transition(
        root,
        publication_id,
        allow_stale=allow_stale,
    )
    current_status = record["status"]
    now = datetime.now(timezone.utc).isoformat(timespec="microseconds")
    draft = package / CHANNEL_DRAFT_NAME

    # 阻塞是硬闸门：受阻内容不再往前走。记录既成事实（已发布、复盘）与取消仍然放行，
    # 否则外部发布的事实会因为漏记阻塞而丢在系统外。
    if isinstance(content.get("block"), dict) and to_status not in (
        "published",
        "reviewed",
        "cancelled",
    ):
        raise WorkflowError("内容处于 blocked 状态，请先解除阻塞")

    if decision is not None:
        if actor != "gm":
            raise WorkflowError("渠道稿审批决定 actor 必须是 gm")
        if current_status != "reviewing" or record.get("approval", {}).get("status") != "pending":
            raise WorkflowError("只有 reviewing 且 approval=pending 的 publication 可以记录审批决定")
        if decision in ("changes_requested", "rejected") and note is None:
            raise WorkflowError(f"{decision} 必须记录 note")
        current_hash = artifact_hash(draft)
        requested_hash = record["approval"]["artifact_hash"]
        if current_hash != requested_hash:
            raise WorkflowError(f"stale approval：{CHANNEL_DRAFT_NAME} 已在审核请求后修改")
        next_status = "reviewing" if decision == "approved" else "adapting"
        approval = dict(record["approval"])
        approval.update(
            {
                "status": decision,
                "decided_at": now,
                "decided_by": actor,
            }
        )
        if note is not None:
            approval["note"] = note
        else:
            approval.pop("note", None)
        record["approval"] = approval
        event = {
            "action": "approval_decision",
            "at": now,
            "actor": actor,
            "from_status": current_status,
            "to_status": next_status,
            "decision": decision,
            "artifact": CHANNEL_DRAFT_NAME,
            "artifact_hash": current_hash,
        }
        if note is not None:
            event["note"] = note
        record["status"] = next_status
        record["events"].append(event)
        write_atomic(card, render_card(record, body))
        return next_status, actor

    if to_status == "reviewing":
        if actor != "content":
            raise WorkflowError("渠道稿审核请求 actor 必须是 content")
        if current_status not in ("adapting", "reviewing"):
            raise WorkflowError("只有 adapting 或稿件已变更的 reviewing publication 可以请求审核")
        current_hash = artifact_hash(draft)
        if current_status == "reviewing":
            reviewed_hash = record.get("approval", {}).get("artifact_hash")
            if current_hash == reviewed_hash:
                raise WorkflowError("reviewing publication 的渠道稿未变更，无需重新请求审核")
        record["status"] = "reviewing"
        record["approval"] = {
            "status": "pending",
            "requested_at": now,
            "requested_by": actor,
            "artifact": CHANNEL_DRAFT_NAME,
            "artifact_hash": current_hash,
        }
        event = {
            "action": "submit_review",
            "at": now,
            "actor": actor,
            "from_status": current_status,
            "to_status": "reviewing",
            "artifact": CHANNEL_DRAFT_NAME,
            "artifact_hash": current_hash,
        }
        if note is not None:
            event["note"] = note
        record["events"].append(event)
        write_atomic(card, render_card(record, body))
        return "reviewing", actor

    if to_status == "published":
        if actor != "gm":
            raise WorkflowError("确认发布 actor 必须是 gm")
        if current_status != "scheduled":
            raise WorkflowError("只有 scheduled publication 可以确认发布")
        if actual_at is None or publication_url is None:
            raise WorkflowError("确认发布必须提供 --actual-at 与 --url")
        if not valid_offset_time(actual_at):
            raise WorkflowError("actual_at 必须是 offset-aware ISO 8601 时间")
        if not valid_public_url(publication_url):
            raise WorkflowError("url 必须是 HTTP(S) URL")
        record["publication"] = {
            "published_at": actual_at,
            "url": publication_url,
            "recorded_at": now,
            "recorded_by": actor,
        }
        if external_id is not None:
            record["publication"]["external_id"] = external_id
        record["status"] = "published"
        event = {
            "action": "publish",
            "at": now,
            "actor": actor,
            "from_status": current_status,
            "to_status": "published",
            "published_at": actual_at,
            "url": publication_url,
        }
        if external_id is not None:
            event["external_id"] = external_id
        record["events"].append(event)
        write_atomic(card, render_card(record, body))
        return "published", actor

    if to_status == "reviewed":
        if current_status != "published":
            raise WorkflowError("只有 published publication 可以完成复盘")
        if conclusion not in REVIEW_CONCLUSIONS:
            raise WorkflowError("conclusion 必须是 continue、iterate、stop 或 inconclusive")
        if next_action is None:
            raise WorkflowError("完成复盘必须提供 --next-action")
        if exception_reason is None and actor != "growth":
            raise WorkflowError("正常 publication 复盘 actor 必须是 growth")
        if exception_reason is not None and actor != "gm":
            raise WorkflowError("数据不可得例外必须由 gm 记录")

        catalog, catalog_errors = load_metric_catalog(root, configured_channels(root))
        if catalog_errors:
            raise WorkflowError(
                "；".join(f"{error.source}：{error.message}" for error in catalog_errors)
            )
        _metrics_path, metrics, _metrics_body, metric_errors = load_publication_metrics(
            package,
            publication_id,
            content["content_id"],
            record["channel"],
            catalog,
        )
        if metric_errors:
            raise WorkflowError(
                "；".join(f"{error.source}：{error.message}" for error in metric_errors)
            )
        snapshots = metrics.get("snapshots", []) if isinstance(metrics, dict) else []
        existing_windows = sorted(
            {
                snapshot.get("window")
                for snapshot in snapshots
                if isinstance(snapshot, dict) and isinstance(snapshot.get("window"), str)
            }
        )
        required_windows = record.get("required_metric_windows", [])
        missing_windows = [
            window for window in required_windows if window not in existing_windows
        ]
        if missing_windows and exception_reason is None:
            raise WorkflowError(
                "缺少必需指标窗口：" + "、".join(missing_windows)
            )
        referenced_windows = [
            window for window in required_windows if window in existing_windows
        ]
        if not required_windows:
            referenced_windows = existing_windows
        review = {
            "status": "done",
            "conclusion": conclusion,
            "next_action": next_action,
            "metric_windows": referenced_windows,
            "recorded_at": now,
            "recorded_by": actor,
        }
        if exception_reason is not None:
            review["exception_reason"] = exception_reason
        event = {
            "action": "review",
            "at": now,
            "actor": actor,
            "from_status": "published",
            "to_status": "reviewed",
            "conclusion": conclusion,
            "next_action": next_action,
            "metric_windows": referenced_windows,
        }
        if exception_reason is not None:
            event["exception_reason"] = exception_reason
        record["review"] = review
        record["status"] = "reviewed"
        record["events"].append(event)
        write_atomic(card, render_card(record, body))
        return "reviewed", actor

    if to_status == "cancelled":
        if actor != "gm":
            raise WorkflowError("取消 publication 的 actor 必须是 gm")
        if current_status not in ("adapting", "reviewing", "scheduled"):
            raise WorkflowError("只有发布前的 publication 可以取消")
        if note is None:
            raise WorkflowError("取消 publication 必须记录 note")
        if record.get("approval", {}).get("status") != "approved":
            record.pop("approval", None)
        record["cancellation"] = {
            "cancelled_at": now,
            "cancelled_by": actor,
            "reason": note,
        }
        record["status"] = "cancelled"
        record["events"].append(
            {
                "action": "cancel",
                "at": now,
                "actor": actor,
                "from_status": current_status,
                "to_status": "cancelled",
                "note": note,
            }
        )
        write_atomic(card, render_card(record, body))
        return "cancelled", actor

    if to_status == "scheduled":
        if actor != "gm":
            raise WorkflowError("publication 排期 actor 必须是 gm")
        if planned_at is None or timezone_name is None:
            raise WorkflowError("进入 scheduled 必须提供 --planned-at 与 --timezone")
        if not planned_time_matches_timezone(planned_at, timezone_name):
            raise WorkflowError("planned_at 必须是 offset-aware ISO 8601，且与 timezone 一致")
        if content.get("status") != "ready":
            raise WorkflowError("引用内容必须保持 ready 才能排期")
        if current_status == "scheduled":
            if note is None:
                raise WorkflowError("重新排期必须记录 note")
            previous_schedule = record["schedule"]
            record["schedule"] = {
                "planned_at": planned_at,
                "timezone": timezone_name,
                "updated_at": now,
                "updated_by": actor,
            }
            record["events"].append(
                {
                    "action": "reschedule",
                    "at": now,
                    "actor": actor,
                    "from_status": "scheduled",
                    "to_status": "scheduled",
                    "previous_planned_at": previous_schedule["planned_at"],
                    "previous_timezone": previous_schedule["timezone"],
                    "planned_at": planned_at,
                    "timezone": timezone_name,
                    "note": note,
                }
            )
            write_atomic(card, render_card(record, body))
            return "scheduled", actor
        if current_status != "reviewing" or record.get("approval", {}).get("status") != "approved":
            raise WorkflowError("只有取得有效 approved 渠道稿审批的 publication 可以进入 scheduled")
        current_hash = artifact_hash(draft)
        if current_hash != record["approval"]["artifact_hash"]:
            raise WorkflowError(f"stale approval：{CHANNEL_DRAFT_NAME} 已在审批后修改")
        record["schedule"] = {
            "planned_at": planned_at,
            "timezone": timezone_name,
            "updated_at": now,
            "updated_by": actor,
        }
        record["status"] = "scheduled"
        event = {
            "action": "schedule",
            "at": now,
            "actor": actor,
            "from_status": current_status,
            "to_status": "scheduled",
            "planned_at": planned_at,
            "timezone": timezone_name,
        }
        if note is not None:
            event["note"] = note
        record["events"].append(event)
        write_atomic(card, render_card(record, body))
        return "scheduled", actor

    raise WorkflowError(f"Issue #4 不支持 publication 转换到状态：{to_status}")


def publication_close_blockers(root: Path, content_id: str, package: Path):
    """关闭内容前列出仍会阻塞的 publication：只算必需项。"""
    publications_root = package / PUBLICATIONS_DIR_NAME
    if publications_root.is_symlink():
        raise WorkflowError("publications 目录不能是 symlink")
    if not publications_root.exists():
        return []
    if not publications_root.is_dir():
        raise WorkflowError("publications 必须是目录")
    known_roles = configured_roles(root)
    known_channels = configured_channels(root)
    blockers = []
    with os.scandir(publications_root) as scanner:
        entries = sorted(scanner, key=lambda entry: entry.name)
    for entry in entries:
        if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
            continue
        publication_id = entry.name
        if not PUBLICATION_ID_RE.fullmatch(publication_id):
            continue
        publication_package = Path(entry.path)
        card = publication_package / PUBLICATION_CARD_NAME
        source = card.relative_to(root).as_posix()
        if card.is_symlink() or not card.is_file():
            blockers.append(f"{publication_id}（缺少发布卡）")
            continue
        record, _body, parse_errors = parse_card_document(card, source)
        if parse_errors:
            blockers.append(f"{publication_id}（发布卡无法解析）")
            continue
        errors = validate_publication_record(
            source,
            publication_id,
            content_id,
            record,
            known_roles,
            known_channels,
            publication_package,
        )
        if errors:
            blockers.append(f"{publication_id}（{errors[0].message}）")
            continue
        if record.get("required", True) is False:
            continue
        status = record.get("status")
        if status in ("reviewed", "cancelled"):
            continue
        blockers.append(f"{publication_id}（{status}）")
    return blockers


def block_content(
    root: Path,
    content_id: str,
    reason_arg: str | None,
    actor_arg: str | None,
):
    """记录内容阻塞：阻塞是内容卡上的独立对象，不是生命周期状态。"""
    root = ensure_instance(root)
    actor = resolve_actor(root, actor_arg)
    if actor not in BLOCK_ACTORS:
        raise WorkflowError("记录内容阻塞的 actor 必须是 gm 或 content")
    reason = require_text("reason", reason_arg)
    if reason is None:
        raise WorkflowError("记录阻塞必须提供 reason 说明原因")
    root, _package, card, record, body = load_content_for_transition(root, content_id)
    status = record["status"]
    if status in ("closed", "cancelled"):
        raise WorkflowError(f"{status} 内容不再接受阻塞记录")
    if isinstance(record.get("block"), dict):
        raise WorkflowError("内容已被阻塞，先解除阻塞再重新记录")
    now = datetime.now(timezone.utc).isoformat(timespec="microseconds")
    record["block"] = {"reason": reason, "at": now, "by": actor}
    record["events"].append(
        {
            "action": "block",
            "at": now,
            "actor": actor,
            "from_status": status,
            "to_status": status,
            "note": reason,
        }
    )
    write_atomic(card, render_card(record, body))
    return "blocked", actor


def unblock_content(
    root: Path,
    content_id: str,
    note_arg: str | None,
    actor_arg: str | None,
):
    root = ensure_instance(root)
    actor = resolve_actor(root, actor_arg)
    if actor not in BLOCK_ACTORS:
        raise WorkflowError("解除内容阻塞的 actor 必须是 gm 或 content")
    note = require_text("note", note_arg)
    root, _package, card, record, body = load_content_for_transition(root, content_id)
    if not isinstance(record.get("block"), dict):
        raise WorkflowError("内容没有被阻塞，无需解除")
    if record["block"].get("by") == "gm" and actor != "gm":
        raise WorkflowError("gm 记录的阻塞只能由 gm 解除")
    status = record["status"]
    now = datetime.now(timezone.utc).isoformat(timespec="microseconds")
    record.pop("block", None)
    event = {
        "action": "unblock",
        "at": now,
        "actor": actor,
        "from_status": status,
        "to_status": status,
    }
    if note is not None:
        event["note"] = note
    record["events"].append(event)
    write_atomic(card, render_card(record, body))
    return "unblocked", actor


def transition_content(
    root: Path,
    content_id: str,
    to_status: str | None,
    decision: str | None,
    actor_arg: str | None,
    note_arg: str | None,
):
    actor = resolve_actor(ensure_instance(root), actor_arg)
    note = require_text("note", note_arg)
    allow_stale = to_status == "reviewing"
    root, package, card, record, body = load_content_for_transition(
        root, content_id, allow_stale=allow_stale
    )
    current_status = record["status"]
    now = datetime.now(timezone.utc).isoformat(timespec="microseconds")

    # 阻塞是硬闸门：受阻内容不再往前走，只能解除阻塞或作废。
    if isinstance(record.get("block"), dict) and to_status != "cancelled":
        raise WorkflowError("内容处于 blocked 状态，请先解除阻塞")

    if decision is not None:
        if actor != "gm":
            raise WorkflowError("审批决定 actor 必须是 gm")
        if current_status != "reviewing" or record.get("approval", {}).get("status") != "pending":
            raise WorkflowError("只有 reviewing 且 approval=pending 的内容可以记录审批决定")
        if decision in ("changes_requested", "rejected") and note is None:
            raise WorkflowError(f"{decision} 必须记录 note")
        draft = package / MAIN_DRAFT_NAME
        current_hash = artifact_hash(draft)
        requested_hash = record["approval"]["artifact_hash"]
        if current_hash != requested_hash:
            raise WorkflowError(f"stale approval：{MAIN_DRAFT_NAME} 已在审核请求后修改")
        next_status = "ready" if decision == "approved" else "drafting"
        approval = dict(record["approval"])
        approval.update(
            {
                "status": decision,
                "decided_at": now,
                "decided_by": actor,
            }
        )
        if note is not None:
            approval["note"] = note
        else:
            approval.pop("note", None)
        record["approval"] = approval
        event = {
            "action": "approval_decision",
            "at": now,
            "actor": actor,
            "from_status": current_status,
            "to_status": next_status,
            "decision": decision,
            "artifact": MAIN_DRAFT_NAME,
            "artifact_hash": current_hash,
        }
        if note is not None:
            event["note"] = note
        record["status"] = next_status
        record["events"].append(event)
        write_atomic(card, render_card(record, body))
        return next_status, actor

    if to_status == "ready":
        raise WorkflowError("ready 只能由 gm 记录 approved 审批决定后进入")
    if to_status == "closed":
        if actor != "gm":
            raise WorkflowError("关闭内容 actor 必须是 gm")
        if current_status != "ready":
            raise WorkflowError("只有 ready 内容可以关闭")
        blockers = publication_close_blockers(root, content_id, package)
        if blockers:
            raise WorkflowError(
                "仍有必需 publication 未复盘或未带原因取消：" + "；".join(blockers)
            )
        record["status"] = "closed"
        event = {
            "action": "close",
            "at": now,
            "actor": actor,
            "from_status": current_status,
            "to_status": "closed",
        }
        if note is not None:
            event["note"] = note
        record["events"].append(event)
        write_atomic(card, render_card(record, body))
        return "closed", actor
    if to_status == "cancelled":
        if actor != "gm":
            raise WorkflowError("取消内容 actor 必须是 gm")
        if current_status not in ("proposed", "drafting"):
            raise WorkflowError("只有 proposed 或 drafting 内容可以取消")
        if note is None:
            raise WorkflowError("取消内容必须记录 note 说明原因")
        record["status"] = "cancelled"
        record["cancellation"] = {
            "cancelled_at": now,
            "cancelled_by": actor,
            "reason": note,
        }
        record["events"].append(
            {
                "action": "cancel",
                "at": now,
                "actor": actor,
                "from_status": current_status,
                "to_status": "cancelled",
                "note": note,
            }
        )
        write_atomic(card, render_card(record, body))
        return "cancelled", actor
    if actor != "content":
        raise WorkflowError("内容状态转换 actor 必须是 content")
    if to_status == "drafting":
        if current_status != "proposed":
            raise WorkflowError(
                f"只有 proposed 内容可以进入 drafting（当前 {current_status}）"
            )
        draft = package / MAIN_DRAFT_NAME
        if draft.is_symlink():
            raise WorkflowError(f"{MAIN_DRAFT_NAME} 不能是 symlink")
        created_draft = False
        if not draft.exists():
            write_atomic(draft, f"# {record['title']}\n")
            created_draft = True
        elif not draft.is_file():
            raise WorkflowError(f"{MAIN_DRAFT_NAME} 必须是普通文件")
        record["main_draft"] = MAIN_DRAFT_NAME
        record["status"] = "drafting"
        event = {
            "action": "transition",
            "at": now,
            "actor": actor,
            "from_status": current_status,
            "to_status": "drafting",
        }
        if note is not None:
            event["note"] = note
        record["events"].append(event)
        try:
            write_atomic(card, render_card(record, body))
        except OSError:
            if created_draft:
                try:
                    draft.unlink()
                except OSError:
                    pass
            raise
        return "drafting", actor

    if to_status == "reviewing":
        if current_status not in ("drafting", "ready"):
            raise WorkflowError("只有 drafting 或稿件已变更的 ready 内容可以请求审核")
        draft = package / MAIN_DRAFT_NAME
        current_hash = artifact_hash(draft)
        if current_status == "ready":
            approved_hash = record.get("approval", {}).get("artifact_hash")
            if current_hash == approved_hash:
                raise WorkflowError("ready 内容的主稿未变更，无需重新请求审核")
        record["status"] = "reviewing"
        record["approval"] = {
            "status": "pending",
            "requested_at": now,
            "requested_by": actor,
            "artifact": MAIN_DRAFT_NAME,
            "artifact_hash": current_hash,
        }
        event = {
            "action": "submit_review",
            "at": now,
            "actor": actor,
            "from_status": current_status,
            "to_status": "reviewing",
            "artifact": MAIN_DRAFT_NAME,
            "artifact_hash": current_hash,
        }
        if note is not None:
            event["note"] = note
        record["events"].append(event)
        write_atomic(card, render_card(record, body))
        return "reviewing", actor

    raise WorkflowError(f"Issue #3 不支持转换到状态：{to_status}")


# ---------- 生成视图 ----------


def markdown_cell(value):
    if value is None or value == "":
        return "—"
    text = str(value)
    return (
        text.replace("\\", "\\\\")
        .replace("|", "\\|")
        .replace("\r\n", "\n")
        .replace("\r", "\n")
        .replace("\n", "<br>")
    )


def record_sort_key(item: ContentRecord):
    """按创建时间排序；时间解析不了时退回字符串，保证顺序稳定。"""
    created_at = item.data.get("created_at")
    if isinstance(created_at, str):
        try:
            parsed = datetime.fromisoformat(created_at)
        except ValueError:
            parsed = None
        if parsed is not None and parsed.tzinfo is not None:
            return (0, parsed, item.data["content_id"])
    return (1, created_at if isinstance(created_at, str) else "", item.data["content_id"])


def calendar_split(records: list[ContentRecord]):
    """把活跃内容分成待排期与已排期两节。

    spec：没有目标日期的选题进「待排期选题」，有目标日期的内容进「已排期内容」。
    已关闭和已取消的内容是历史，不再占用当前运营视图。
    """
    active = [
        item for item in records if item.data.get("status") not in HISTORY_STATUSES
    ]
    unscheduled = sorted(
        (item for item in active if not item.data.get("target_date")),
        key=record_sort_key,
    )
    scheduled = sorted(
        (item for item in active if item.data.get("target_date")),
        key=lambda item: (str(item.data.get("target_date")), record_sort_key(item)),
    )
    return unscheduled, scheduled


def calendar_rows(items: list[ContentRecord]) -> list[str]:
    lines = [
        "| 内容 ID | 标题 | 目标日期 | 来源 | 摘要 | 状态 | 内容卡 |",
        "|---|---|---|---|---|---|---|",
    ]
    for item in items:
        record = item.data
        content_id = record["content_id"]
        link = f"[打开](../content/{content_id}/{CARD_NAME})"
        lines.append(
            "| {} | {} | {} | {} | {} | {} | {} |".format(
                markdown_cell(content_id),
                markdown_cell(record["title"]),
                markdown_cell(record.get("target_date")),
                markdown_cell(record.get("source")),
                markdown_cell(record.get("summary")),
                markdown_cell(record["status"]),
                link,
            )
        )
    lines.append("")
    return lines


def render_calendar(records: list[ContentRecord]):
    unscheduled, scheduled = calendar_split(records)
    lines = [
        "# 选题日历",
        "",
        f"> **{GENERATED_MARKER}**",
        "> 由 `tools/opc-workflow build` 从 `knowledge/content/*/内容卡.md` 生成。请勿手工编辑。",
        "",
        CALENDAR_UNSCHEDULED_HEADING,
        "",
    ]
    if unscheduled:
        lines.extend(calendar_rows(unscheduled))
    else:
        lines.extend(["当前没有待排期的内容。", ""])
    lines.extend([CALENDAR_SCHEDULED_HEADING, ""])
    if scheduled:
        lines.extend(calendar_rows(scheduled))
    else:
        lines.extend(["当前没有已排期的内容。", ""])
    return "\n".join(lines)


def publication_sort_key(item: PublicationRecord):
    created_at = item.data.get("created_at")
    if isinstance(created_at, str):
        try:
            parsed = datetime.fromisoformat(created_at)
        except ValueError:
            parsed = None
        if parsed is not None and parsed.tzinfo is not None:
            return (0, parsed, item.data["publication_id"])
    return (
        1,
        created_at if isinstance(created_at, str) else "",
        item.data["publication_id"],
    )


def metric_summary(
    record: dict,
    catalog: dict,
    snapshots: list,
):
    definitions = sorted(
        (
            definition
            for definition in catalog.values()
            if definition.get("scope") == "publication"
            and record.get("channel") in definition.get("channels", ())
        ),
        key=lambda definition: definition.get("key", ""),
    )
    if not definitions:
        return "—"
    if not snapshots:
        return "缺失"
    lines = []
    for snapshot in snapshots:
        if not isinstance(snapshot, dict):
            continue
        values = snapshot.get("values")
        if not isinstance(values, dict):
            values = {}
        cells = []
        for definition in definitions:
            key = definition["key"]
            if key not in values:
                cells.append(f"{key}=缺失")
                continue
            value = values[key]
            if isinstance(value, dict) and value.get("available") is False:
                cells.append(f"{key}=不可得")
            else:
                cells.append(f"{key}={value}")
        lines.append(f"{snapshot.get('window')}: " + "、".join(cells))
    return "；".join(lines)


def review_summary(record: dict):
    review = record.get("review")
    if not isinstance(review, dict):
        return "未复盘"
    parts = [str(review.get("conclusion") or "")]
    next_action = review.get("next_action")
    if next_action:
        parts.append(str(next_action))
    text = "：".join(part for part in parts if part)
    return text or "已复盘"


def render_channel_snapshots(channel: str, observations: list):
    selected = sorted(
        (
            observation
            for observation in observations
            if isinstance(observation, dict) and observation.get("channel") == channel
        ),
        key=lambda observation: (
            observation.get("observed_at") or "",
            observation.get("recorded_at") or "",
        ),
    )
    lines = ["## 渠道账号观测", ""]
    if not selected:
        lines.extend(["当前没有该渠道的账号级观测。", ""])
        return lines
    lines.extend(
        [
            "| 观测时间 | 指标 | 数值 | 来源 |",
            "|---|---|---|---|",
        ]
    )
    for observation in selected:
        values = observation.get("values")
        if not isinstance(values, dict):
            continue
        for key, value in sorted(values.items()):
            if isinstance(value, dict) and value.get("available") is False:
                rendered = f"不可得（{value.get('reason')}）"
            else:
                rendered = str(value)
            lines.append(
                "| {} | {} | {} | {} |".format(
                    markdown_cell(observation.get("observed_at")),
                    markdown_cell(key),
                    markdown_cell(rendered),
                    markdown_cell(observation.get("source")),
                )
            )
    lines.append("")
    return lines


def render_channel_publications(
    channel: str,
    publications: list[PublicationRecord],
    contents: list[ContentRecord],
    growth: GrowthScan,
):
    titles = {
        content.data.get("content_id"): content.data.get("title")
        for content in contents
    }
    selected = sorted(
        (
            publication
            for publication in publications
            if publication.data.get("channel") == channel
        ),
        key=publication_sort_key,
    )
    lines = [
        f"# {channel} 发布记录",
        "",
        f"> **{GENERATED_MARKER}**",
        "> 由 `tools/opc-workflow build` 从 canonical publication cards 生成。请勿手工编辑。",
        "",
    ]
    if not selected:
        lines.extend(["当前没有该渠道的 publication。", ""])
        lines.extend(render_channel_snapshots(channel, growth.channel_snapshots))
        return "\n".join(lines)
    lines.extend(
        [
            "| Publication ID | Content ID | 标题 | 状态 | 计划时间 | 时区 | 审批 | 实际发布时间 | 发布 URL | 指标摘要 | 复盘 | 指标记录 | 发布卡 | 渠道稿 |",
            "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|",
        ]
    )
    for item in selected:
        record = item.data
        content_id = record["content_id"]
        publication_id = record["publication_id"]
        package_link = (
            f"../../content/{content_id}/{PUBLICATIONS_DIR_NAME}/"
            f"{publication_id}/{PUBLICATION_CARD_NAME}"
        )
        draft_link = (
            f"../../content/{content_id}/{PUBLICATIONS_DIR_NAME}/"
            f"{publication_id}/{CHANNEL_DRAFT_NAME}"
        )
        schedule = record.get("schedule")
        if not isinstance(schedule, dict):
            schedule = {}
        approval = record.get("approval")
        if not isinstance(approval, dict):
            approval = {}
        publication_fact = record.get("publication")
        if not isinstance(publication_fact, dict):
            publication_fact = {}
        metrics_link = "—"
        if publication_id in growth.publication_metrics:
            metrics_link = (
                f"[打开](../../content/{content_id}/{PUBLICATIONS_DIR_NAME}/"
                f"{publication_id}/{PUBLICATION_METRICS_NAME})"
            )
        lines.append(
            "| {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | [打开]({}) | [打开]({}) |".format(
                markdown_cell(publication_id),
                markdown_cell(content_id),
                markdown_cell(titles.get(content_id)),
                markdown_cell(record["status"]),
                markdown_cell(schedule.get("planned_at")),
                markdown_cell(schedule.get("timezone")),
                markdown_cell(approval.get("status")),
                markdown_cell(publication_fact.get("published_at")),
                markdown_cell(publication_fact.get("url")),
                markdown_cell(
                    metric_summary(
                        record,
                        growth.catalog,
                        growth.publication_metrics.get(publication_id, []),
                    )
                ),
                markdown_cell(review_summary(record)),
                metrics_link,
                package_link,
                draft_link,
            )
        )
    lines.append("")
    lines.extend(render_channel_snapshots(channel, growth.channel_snapshots))
    return "\n".join(lines)


def write_atomic(path: Path, text: str):
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=path.parent,
            prefix=".opc-workflow-calendar-",
            delete=False,
        ) as handle:
            temporary = Path(handle.name)
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        temporary = None
    finally:
        if temporary is not None:
            try:
                temporary.unlink()
            except FileNotFoundError:
                pass


def build_calendar(root: Path):
    root, records, publications, errors, warnings = scan_content_records(root)
    growth = scan_growth_records(root, publications)
    errors.extend(growth.errors)
    warnings.extend(growth.warnings)
    _task_records, task_errors = scan_task_cards(root)
    errors.extend(task_errors)
    if errors:
        print_diagnostics(errors, warnings)
        return 1
    business = ensure_local_directory(root, BUSINESS_DIR)
    targets = [(business / CALENDAR_NAME, render_calendar(records), GENERATED_MARKER)]
    channels = configured_channels(root)
    for channel, enabled in channels.items():
        if not enabled:
            continue
        channel_dir = ensure_local_directory(root, BUSINESS_DIR / channel)
        targets.append(
            (
                channel_dir / "发布记录.md",
                render_channel_publications(channel, publications, records, growth),
                GENERATED_MARKER,
            )
        )
    dashboard_target = business / DASHBOARD_NAME
    try:
        dashboard_rendered = render_dashboard_cache(
            root, records, publications, growth, errors, warnings
        )
    except Exception as error:  # 看板生成失败要说清楚，不能抛 traceback 给 owner
        print(f"错误：看板契约：{error}", file=sys.stderr)
        return 1
    targets.append(
        (
            dashboard_target,
            dashboard_rendered,
            DASHBOARD_MARKER,
        )
    )

    for target, _rendered, marker in targets:
        if target.is_symlink():
            print(f"错误：生成目标不能是 symlink：{target.relative_to(root)}", file=sys.stderr)
            return 1
        if not target.exists():
            continue
        if not target.is_file():
            print(f"错误：生成目标必须是文件：{target.relative_to(root)}", file=sys.stderr)
            return 1
        try:
            existing = target.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            existing = ""
        if marker not in existing:
            print(
                f"错误：{target.relative_to(root)} 不是生成文件，拒绝覆盖既有内容。"
                "请先人工确认并迁移，或删除该文件后重新生成。",
                file=sys.stderr,
            )
            return 1

    for target, rendered, _marker in targets:
        if target.exists() and target.is_file():
            try:
                if target.read_text(encoding="utf-8") == rendered:
                    continue
            except (OSError, UnicodeError):
                pass
        write_atomic(target, rendered)
    print_diagnostics([], warnings)
    unscheduled, scheduled = calendar_split(records)
    print(
        f"已生成选题日历：{len(unscheduled)} 条待排期内容、{len(scheduled)} 条已排期内容；"
        f"渠道发布记录：{len(publications)} 条 publication；"
        f"看板缓存：{dashboard_target.relative_to(root).as_posix()}"
    )
    return 0


# ---------- 任务卡 ----------


def derive_task_id(assignee: str, created_at: str, task: str) -> str:
    """按承接角色 + 时间 + 任务文本派生稳定 ID。

    与旧收件箱条目的派生思路一致：同一张卡改措辞时 ID 不漂移，
    不同任务的 ID 不撞车。
    """
    digest = hashlib.sha256(
        "|".join([assignee, created_at, task]).encode("utf-8")
    ).hexdigest()
    return f"task-{digest[:12]}"


def task_title(task: str) -> str:
    """标题取任务详情的第一行：长需求不会把标题撑爆。"""
    text = task.strip()
    if not text:
        return ""
    first = text.splitlines()[0].strip()
    if len(first) > TASK_TITLE_MAX:
        first = first[:TASK_TITLE_MAX].rstrip() + "…"
    return first


def render_task_body(record: dict) -> str:
    """正文只留人类可读摘要；长文本只放 frontmatter 字段。"""
    return "# 任务卡\n\n{}｜状态：{}\n".format(
        record.get("title", ""), record.get("state", "")
    )


def render_task_card(record: dict) -> str:
    return "---\n{}\n---\n\n{}".format(
        json.dumps(record, ensure_ascii=False, indent=2),
        render_task_body(record),
    )


def task_card_source(task_id: str) -> str:
    return (TASK_DIR / f"{task_id}.md").as_posix()


def validate_task_record(
    source: str,
    record: dict,
    known_roles: dict,
    file_stem: str | None = None,
):
    """校验任务卡。完成态必须同时有完成时间与结果，缺一就是半个完成态。"""
    errors = []
    errors.extend(validate_record_header(source, record, "task"))

    task_id = record.get("task_id")
    if not is_nonempty_string(task_id):
        errors.append(Diagnostic(source, "task_id 必须是非空字符串"))
    elif not TASK_ID_RE.fullmatch(task_id):
        errors.append(Diagnostic(source, "task_id 必须形如 task-<小写字母数字>"))
    elif file_stem is not None and task_id != file_stem:
        errors.append(
            Diagnostic(source, f"任务卡文件名与 task_id「{task_id}」不一致")
        )

    # 除上述字段外，任务卡只认约定的固定集合。多出来的字段多半是手工改卡时
    # 写歪了位置，留着会成为另一份隐藏事实，校验阶段就要挡住。
    for field in sorted(set(record) - TASK_FIELDS):
        errors.append(Diagnostic(source, f"未知字段 {field}"))

    for field in ("title", "task"):
        if not is_nonempty_string(record.get(field)):
            errors.append(Diagnostic(source, f"字段 {field} 必须是非空字符串"))
    for field in ("requester", "assignee"):
        value = record.get(field)
        if not is_nonempty_string(value):
            errors.append(Diagnostic(source, f"字段 {field} 必须是非空字符串"))
        elif value not in known_roles:
            errors.append(Diagnostic(source, f"{field} 使用非法角色「{value}」"))
    for field in ("reference", "acceptance", "next", "terminal"):
        if not isinstance(record.get(field), str):
            errors.append(Diagnostic(source, f"字段 {field} 必须是字符串"))
    # 终点是卡上的边界，缺了它就没人能判断链条停没停。
    if isinstance(record.get("terminal"), str) and not record["terminal"].strip():
        errors.append(Diagnostic(source, "字段 terminal 必须是非空字符串"))
    # 链边非空时必须指向一个真实角色——手工改卡写歪了要挡住。
    next_role = record.get("next")
    if isinstance(next_role, str) and next_role.strip() and next_role not in known_roles:
        errors.append(Diagnostic(source, f"next 使用非法角色「{next_role}」"))

    if not valid_offset_time(record.get("created_at")):
        errors.append(
            Diagnostic(source, "created_at 必须是 offset-aware ISO 8601 时间")
        )
    state = record.get("state")
    if state not in TASK_STATES:
        errors.append(
            Diagnostic(source, f"state 必须是 {'、'.join(TASK_STATES)} 之一")
        )

    completed_at = record.get("completed_at")
    if completed_at is not None and not valid_offset_time(completed_at):
        errors.append(
            Diagnostic(source, "completed_at 必须是 offset-aware ISO 8601 时间")
        )
    result = record.get("result")
    if result is not None and not isinstance(result, str):
        errors.append(Diagnostic(source, "result 必须是字符串"))
    cancel_reason = record.get("cancel_reason")
    if cancel_reason is not None and not isinstance(cancel_reason, str):
        errors.append(Diagnostic(source, "cancel_reason 必须是字符串"))

    events = record.get("events")
    if not isinstance(events, list) or not events:
        errors.append(Diagnostic(source, "events 必须是非空数组"))
        events = []
    for index, event in enumerate(events):
        label = f"第 {index + 1} 个 event"
        if not isinstance(event, dict):
            errors.append(Diagnostic(source, f"{label} 必须是 object"))
            continue
        if event.get("action") not in TASK_EVENT_ACTIONS:
            errors.append(
                Diagnostic(source, f"{label} 使用未知 action「{event.get('action')}」")
            )
        if not valid_offset_time(event.get("at")):
            errors.append(
                Diagnostic(source, f"{label} 的 at 必须是 offset-aware ISO 8601 时间")
            )
        actor = event.get("actor")
        if not is_nonempty_string(actor):
            errors.append(Diagnostic(source, f"{label} 字段 actor 缺失"))
        elif actor not in known_roles:
            errors.append(Diagnostic(source, f"{label} 使用非法 actor「{actor}」"))

    completes = [
        event
        for event in events
        if isinstance(event, dict) and event.get("action") == "complete"
    ]
    cancels = [
        event
        for event in events
        if isinstance(event, dict) and event.get("action") == "cancel"
    ]
    if state == "done":
        if not is_nonempty_string(completed_at):
            errors.append(Diagnostic(source, "完成态缺少完成时间"))
        if not is_nonempty_string(result):
            errors.append(Diagnostic(source, "完成态缺少结果"))
        if len(completes) != 1:
            errors.append(Diagnostic(source, "完成态必须恰好有一条完成事实"))
    elif completes:
        errors.append(Diagnostic(source, "未完成的任务卡不能有完成事实"))
    if state == "cancelled":
        if not is_nonempty_string(cancel_reason):
            errors.append(Diagnostic(source, "撤销的任务卡必须写明撤销原因"))
        if len(cancels) != 1:
            errors.append(Diagnostic(source, "撤销的任务卡必须恰好有一条撤销事实"))
    elif cancels:
        errors.append(Diagnostic(source, "未撤销的任务卡不能有撤销事实"))
    return errors


def scan_task_cards(root: Path):
    """读任务卡目录。一张卡一次派工，完成态是卡上的事实。"""
    directory = root / TASK_DIR
    tasks = []
    errors = []
    if not directory.exists():
        return tasks, errors
    if directory.is_symlink() or not directory.is_dir():
        return tasks, [
            Diagnostic(TASK_DIR.as_posix(), "任务目录不能是 symlink，且必须是目录")
        ]
    known_roles = configured_roles(root)
    for path in sorted(directory.glob("*.md")):
        source = (TASK_DIR / path.name).as_posix()
        if path.is_symlink():
            errors.append(Diagnostic(source, "任务卡不能是 symlink"))
            continue
        if not path.is_file():
            continue
        record, parse_errors = parse_frontmatter(path, source, "任务卡")
        errors.extend(parse_errors)
        if record is None:
            continue
        errors.extend(
            validate_task_record(source, record, known_roles, path.stem)
        )
        tasks.append(TaskRecord(source, record))

    by_id = {}
    for task in tasks:
        task_id = task.data.get("task_id")
        if not isinstance(task_id, str):
            continue
        by_id.setdefault(task_id, []).append(task.source)
    for task_id, sources in sorted(by_id.items()):
        if len(sources) < 2:
            continue
        joined = "、".join(sources)
        for source in sources:
            errors.append(
                Diagnostic(source, f"重复 task_id「{task_id}」：{joined}")
            )
    return tasks, errors


def load_task_card(root: Path, task_id: str):
    """读单张任务卡。卡本身不合法时直接拒绝，不带着半个事实往下走。"""
    task_id = optional_text(task_id)
    if not TASK_ID_RE.fullmatch(task_id):
        raise WorkflowError(f"任务 ID「{task_id}」非法：必须形如 task-<小写字母数字>")
    path = root / TASK_DIR / f"{task_id}.md"
    source = task_card_source(task_id)
    if path.is_symlink():
        raise WorkflowError(f"任务卡不能是 symlink：{source}")
    if not path.is_file():
        raise WorkflowError(f"任务卡不存在：{source}")
    record, parse_errors = parse_frontmatter(path, source, "任务卡")
    if parse_errors:
        raise WorkflowError("；".join(error.message for error in parse_errors))
    if record is None:
        raise WorkflowError(f"任务卡无法解析：{source}")
    problems = validate_task_record(
        source, record, configured_roles(root), task_id
    )
    if problems:
        raise WorkflowError("；".join(problem.message for problem in problems))
    return record, path, source


def authorize_task_write(record, actor, action):
    """核对写这张卡的人：完成只有承接角色，撤销限发起方与承接角色。

    与 resolve_actor 同一个信任边界：工具无法自证调用者是谁，这些检查防的是
    误用（角色越权改别人的卡），不是伪造。
    """
    assignee = record.get("assignee")
    requester = record.get("requester")
    if action == "complete" and actor != assignee:
        raise WorkflowError(
            f"只有承接角色「{assignee}」能写完成态：actor「{actor}」不能写这张卡"
        )
    if action == "cancel" and actor not in (assignee, requester):
        raise WorkflowError(
            f"只有承接角色「{assignee}」或发起方「{requester}」能撤销这张卡："
            f"actor「{actor}」不能撤"
        )


def create_task(
    root: Path,
    assignee: str | None,
    task: str | None,
    acceptance: str | None,
    title: str | None,
    reference: str | None,
    next_role: str | None,
    terminal: str | None,
    task_id: str | None,
    actor_arg: str | None,
):
    """创建任务卡：一次派工一张卡，卡上写明验收、链边与终点。"""
    root = ensure_instance(root)
    actor = resolve_actor(root, actor_arg)
    roles = configured_roles(root)

    # 派工只有编排者能做：角色之间不自行开卡。
    if actor != ORCHESTRATOR_ROLE:
        raise WorkflowError(
            f"派工只有编排者能做：actor「{actor}」不能建任务卡，"
            f"请让编排者「{ORCHESTRATOR_ROLE}」派工"
        )

    assignee = required_text("承接角色", assignee)
    if assignee not in roles:
        raise WorkflowError(f"承接角色「{assignee}」必须是 roles.json 中的 role key")
    if not roles[assignee]:
        raise WorkflowError(f"承接角色「{assignee}」在 roles.json 里已停用")
    task = required_text("任务详情", task)
    acceptance = required_text("验收标准", acceptance)
    title = optional_text(title) or task_title(task)
    reference = optional_text(reference) or "-"
    next_role = optional_text(next_role)
    # 终点必填：链条停在哪是卡上的边界，缺了它就没人能判断这条链停没停。
    # 链边可以留空——那是「链条到此为止」的写法，完成后通知编排者。
    terminal = required_text("终点", terminal)
    if next_role and next_role not in roles:
        raise WorkflowError(f"链边「{next_role}」必须是 roles.json 中的 role key")

    now = datetime.now(timezone.utc)
    created_at = now.isoformat(timespec="microseconds")
    explicit_id = optional_text(task_id)
    if explicit_id:
        if not TASK_ID_RE.fullmatch(explicit_id):
            raise WorkflowError(
                f"任务 ID「{explicit_id}」非法：必须形如 task-<小写字母数字>"
            )
        new_id = explicit_id
    else:
        new_id = derive_task_id(assignee, created_at, task)

    ensure_local_directory(root, TASK_DIR)
    path = root / TASK_DIR / f"{new_id}.md"
    if path.exists():
        raise WorkflowError(f"任务卡已存在：{task_card_source(new_id)}")

    record = {
        "schema_version": SCHEMA_VERSION,
        "record_type": "task",
        "task_id": new_id,
        "title": title,
        "requester": actor,
        "assignee": assignee,
        "created_at": created_at,
        "state": "open",
        "reference": reference,
        "task": task,
        "acceptance": acceptance,
        "next": next_role,
        "terminal": terminal,
        "events": [
            {
                "action": "create",
                "at": created_at,
                "actor": actor,
                "to_state": "open",
            }
        ],
        "completed_at": None,
        "result": None,
        "cancel_reason": None,
    }
    problems = validate_task_record(
        task_card_source(new_id), record, roles, new_id
    )
    if problems:
        raise WorkflowError("；".join(problem.message for problem in problems))
    write_atomic(path, render_task_card(record))
    return new_id, assignee, task_card_source(new_id), actor


def complete_task(
    root: Path,
    task_id: str,
    result: str | None,
    completed_at: str | None,
    actor_arg: str | None,
):
    """完成任务卡：完成时间与结果一起写，缺一项就拒绝，不写半个完成态。"""
    root = ensure_instance(root)
    actor = resolve_actor(root, actor_arg)
    record, path, source = load_task_card(root, task_id)
    authorize_task_write(record, actor, "complete")
    state = record.get("state")
    result_text = optional_text(result)

    if state == "done":
        if result_text and result_text != record.get("result"):
            raise WorkflowError(
                f"任务卡「{record['task_id']}」已是完成态，不能改写结果"
            )
        # 幂等：重复完成不产生第二条完成事实，卡也不被重写。
        return record["task_id"], "done", actor, False
    if state == "cancelled":
        raise WorkflowError(f"任务卡「{record['task_id']}」已撤销，不能完成")
    if not result_text:
        raise WorkflowError("完成任务卡必须给出结果：缺结果就写不出完成态")

    if completed_at is None:
        at = datetime.now(timezone.utc).isoformat(timespec="microseconds")
    else:
        at = optional_text(completed_at)
        if not at:
            raise WorkflowError("完成时间不能为空：缺完成时间就写不出完成态")
        if not valid_offset_time(at):
            raise WorkflowError("完成时间必须是 offset-aware ISO 8601 时间")

    events = list(record.get("events") or [])
    events.append(
        {
            "action": "complete",
            "at": at,
            "actor": actor,
            "from_state": "open",
            "to_state": "done",
        }
    )
    updated = dict(record)
    updated["state"] = "done"
    updated["completed_at"] = at
    updated["result"] = result_text
    updated["events"] = events
    problems = validate_task_record(
        source, updated, configured_roles(root), record["task_id"]
    )
    if problems:
        raise WorkflowError("；".join(problem.message for problem in problems))
    write_atomic(path, render_task_card(updated))
    return record["task_id"], "done", actor, True


def cancel_task(
    root: Path,
    task_id: str,
    reason: str | None,
    actor_arg: str | None,
):
    """撤销任务卡：撤销写回任务卡并留原因，重启后没人会把旧任务捞回来重做。"""
    root = ensure_instance(root)
    actor = resolve_actor(root, actor_arg)
    record, path, source = load_task_card(root, task_id)
    authorize_task_write(record, actor, "cancel")
    state = record.get("state")
    reason_text = optional_text(reason)

    if state == "cancelled":
        return record["task_id"], "cancelled", actor, False
    if state == "done":
        raise WorkflowError(f"任务卡「{record['task_id']}」已完成，不能撤销")
    if not reason_text:
        raise WorkflowError("撤销任务卡必须给出原因")

    at = datetime.now(timezone.utc).isoformat(timespec="microseconds")
    events = list(record.get("events") or [])
    events.append(
        {
            "action": "cancel",
            "at": at,
            "actor": actor,
            "from_state": "open",
            "to_state": "cancelled",
            "reason": reason_text,
        }
    )
    updated = dict(record)
    updated["state"] = "cancelled"
    updated["cancel_reason"] = reason_text
    updated["events"] = events
    problems = validate_task_record(
        source, updated, configured_roles(root), record["task_id"]
    )
    if problems:
        raise WorkflowError("；".join(problem.message for problem in problems))
    write_atomic(path, render_task_card(updated))
    return record["task_id"], "cancelled", actor, True


def task_sort_key(task: dict):
    created = parse_timestamp(task.get("created_at"))
    return (
        TASK_STATE_ORDER.get(task.get("state"), len(TASK_STATE_ORDER)),
        created or datetime.min.replace(tzinfo=timezone.utc),
        task.get("task_id") or "",
    )


def list_task_cards(root: Path, assignee: str | None, state: str | None):
    """列出任务卡：可按承接角色与状态过滤。"""
    root = ensure_instance(root)
    assignee = optional_text(assignee)
    state = optional_text(state)
    if state and state not in TASK_STATES:
        raise WorkflowError(f"状态「{state}」非法：必须是 {'、'.join(TASK_STATES)}")
    roles = configured_roles(root)
    if assignee and assignee not in roles:
        raise WorkflowError(f"承接角色「{assignee}」必须是 roles.json 中的 role key")
    tasks, errors = scan_task_cards(root)
    if errors:
        raise WorkflowError("；".join(error.message for error in errors))
    selected = [
        task
        for task in tasks
        if (not assignee or task.data.get("assignee") == assignee)
        and (not state or task.data.get("state") == state)
    ]
    return sorted(selected, key=lambda task: task_sort_key(task.data))


def show_task_card(root: Path, task_id: str):
