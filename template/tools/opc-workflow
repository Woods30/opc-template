    unblock_parser.add_argument("content_id", help="稳定 content_id")
    unblock_parser.add_argument("--note", help="解除阻塞的说明")
    unblock_parser.add_argument("--actor", help="记录 actor；必须是 gm 或 content")

    subparsers.add_parser("validate", help="校验 canonical 内容卡")
    subparsers.add_parser("build", help="校验并原子生成选题日历")

    create_task_parser = subparsers.add_parser(
        "create-task",
        help="创建任务卡：一次派工一张卡",
    )
    create_task_parser.add_argument("--assignee", required=True, help="承接角色")
    create_task_parser.add_argument("--task", required=True, help="任务详情正文")
    create_task_parser.add_argument("--acceptance", help="验收标准（必填）")
    create_task_parser.add_argument("--title", help="任务卡标题；默认取任务详情第一行")
    create_task_parser.add_argument("--reference", help="业务引用；没有则填 -")
    create_task_parser.add_argument("--next", help="链边：完成后交给谁；留空表示链条到此为止")
    create_task_parser.add_argument("--terminal", help="终点：链条停在哪（必填）")
    create_task_parser.add_argument(
        "--task-id",
        help="显式任务 ID；默认按承接角色 + 时间 + 任务文本派生",
    )
    create_task_parser.add_argument(
        "--actor",
        help="roles.json 中的 role key；默认取 OPC_ROLE 或 content",
    )

    complete_task_parser = subparsers.add_parser(
        "complete-task",
        help="完成任务卡：完成时间与结果一起写",
    )
    complete_task_parser.add_argument("task_id", help="任务 ID")
    complete_task_parser.add_argument("--result", help="完成结果")
    complete_task_parser.add_argument(
        "--completed-at",
        help="完成时间（offset-aware ISO 8601）；默认取当前时间",
    )
    complete_task_parser.add_argument(
        "--actor",
        help="roles.json 中的 role key；默认取 OPC_ROLE 或 content",
    )

    cancel_task_parser = subparsers.add_parser(
        "cancel-task",
        help="撤销任务卡：撤销写回任务卡并留原因",
    )
    cancel_task_parser.add_argument("task_id", help="任务 ID")
    cancel_task_parser.add_argument("--reason", help="撤销原因")
    cancel_task_parser.add_argument(
        "--actor",
        help="roles.json 中的 role key；默认取 OPC_ROLE 或 content",
    )

    list_tasks_parser = subparsers.add_parser("list-tasks", help="列出任务卡")
    list_tasks_parser.add_argument("--assignee", help="只看某个承接角色的任务")
    list_tasks_parser.add_argument(
        "--state",
        choices=TASK_STATES,
        help="只看某个状态的任务",
    )

    show_task_parser = subparsers.add_parser("show-task", help="读单张任务卡")
    show_task_parser.add_argument("task_id", help="任务 ID")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    root = instance_root()
    try:
        if args.command == "create-content":
            content_id, path, actor = create_content(
                root,
                args.title,
                args.source,
                args.summary,
                args.target_date,
                args.actor,
            )
            print(f"已创建 {content_id}（actor={actor}）：{path}")
            return 0
        if args.command == "create-publication":
            publication_id, path, actor = create_publication(
                root,
                args.content_id,
                args.channel,
                args.actor,
                args.required_window,
                args.optional,
            )
            print(f"已创建 {publication_id}（actor={actor}）：{path}")
            return 0
        if args.command == "transition":
            if PUBLICATION_ID_RE.fullmatch(args.content_id):
                status, actor = transition_publication(
                    root,
                    args.content_id,
                    args.to,
                    args.decision,
                    args.actor,
                    args.note,
                    args.planned_at,
                    args.timezone,
                    args.actual_at,
                    args.url,
                    args.external_id,
                    args.conclusion,
                    args.next_action,
                    args.exception_reason,
                )
            else:
                if any(
                    value is not None
                    for value in (
                        args.planned_at,
                        args.timezone,
                        args.actual_at,
                        args.url,
                        args.external_id,
                    )
                ):
                    raise WorkflowError("内容状态转换不接受 publication 时间或发布参数")
                status, actor = transition_content(
                    root,
                    args.content_id,
                    args.to,
                    args.decision,
                    args.actor,
                    args.note,
                )
            print(f"已更新 {args.content_id} → {status}（actor={actor}）")
            return 0
        if args.command == "block":
            state, actor = block_content(
                root,
                args.content_id,
                args.reason,
                args.actor,
            )
            print(f"已更新 {args.content_id} → {state}（actor={actor}）")
            return 0
        if args.command == "unblock":
            state, actor = unblock_content(
                root,
                args.content_id,
                args.note,
                args.actor,
            )
            print(f"已更新 {args.content_id} → {state}（actor={actor}）")
            return 0
        if args.command == "record-metrics":
            path = record_publication_metrics(
                root,
                args.publication_id,
                args.window,
                args.observed_at,
                args.source,
                args.values,
                args.actor,
            )
            print(f"已记录指标窗口：{path}")
            return 0
        if args.command == "record-channel-snapshot":
            path = record_channel_snapshot(
                root,
                args.channel,
                args.observed_at,
                args.source,
                args.values,
                args.actor,
            )
            print(f"已记录渠道快照：{path}")
            return 0
        if args.command == "validate":
            return validate_content(root)
        if args.command == "create-task":
            task_id, assignee, path, actor = create_task(
                root,
                args.assignee,
                args.task,
                args.acceptance,
                args.title,
                args.reference,
                args.next,
                args.terminal,
                args.task_id,
                args.actor,
            )
            print(f"已创建 {task_id}（assignee={assignee}）：{path}")
            return 0
        if args.command == "complete-task":
            task_id, state, actor, changed = complete_task(
                root,
                args.task_id,
                args.result,
                args.completed_at,
                args.actor,
            )
            print(
                f"已更新 {task_id} → {state}（actor={actor}）"
                if changed
                else f"{task_id} 已是 {state}，未重复写入（actor={actor}）"
            )
            return 0
        if args.command == "cancel-task":
            task_id, state, actor, changed = cancel_task(
                root,
                args.task_id,
                args.reason,
                args.actor,
            )
            print(
                f"已更新 {task_id} → {state}（actor={actor}）"
                if changed
                else f"{task_id} 已是 {state}，未重复写入（actor={actor}）"
            )
            return 0
        if args.command == "list-tasks":
            tasks = list_task_cards(root, args.assignee, args.state)
            for task in tasks:
                data = task.data
                print(
                    "{}  {}  {}  {}".format(
                        data.get("task_id", ""),
                        data.get("state", ""),
                        data.get("assignee", ""),
                        data.get("title", ""),
                    )
                )
            return 0
        if args.command == "show-task":
            sys.stdout.write(show_task_card(root, args.task_id))
            return 0
        if args.command == "build":
            return build_calendar(root)
    except WorkflowError as error:
        print(f"错误：{error}", file=sys.stderr)
        return 1
    except OSError as error:
        print(f"错误：写入失败：{error}", file=sys.stderr)
        return 1
    return 2


if __name__ == "__main__":
    sys.exit(main())
