# ---------- 基础读取 ----------


def read_json(path: Path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as error:
        raise WorkflowError(f"缺少文件：{path}") from error
    except (OSError, json.JSONDecodeError) as error:
        raise WorkflowError(f"无法读取 JSON：{path}：{error}") from error


def instance_root() -> Path:
    """实例根 = 工具所在目录的父目录。工具只在实例里工作。"""
    return Path(__file__).resolve().parent.parent


def ensure_instance(root: Path):
    root = root.resolve()
    metadata_path = root / ".opc" / "instance.json"
    if not metadata_path.is_file():
        raise WorkflowError(f"目标不是 OPC 实例（缺少 {metadata_path}）：{root}")
    metadata = read_json(metadata_path)
    if not isinstance(metadata, dict) or metadata.get("kind") != "opc-instance":
        raise WorkflowError(f"目标不是 OPC 实例：{root}")
    return root


def configured_roles(root: Path):
    payload = read_json(root / "roles.json")
    roles = payload.get("roles") if isinstance(payload, dict) else None
    if not isinstance(roles, list):
        raise WorkflowError(f"roles.json 的 roles 必须是数组：{root / 'roles.json'}")
    known = {}
    for role in roles:
        if isinstance(role, dict) and isinstance(role.get("name"), str):
            known[role["name"]] = bool(role.get("enabled"))
    return known


def configured_channels(root: Path):
    return {
        channel_id: detail["enabled"]
        for channel_id, detail in configured_channel_details(root).items()
    }


def configured_channel_details(root: Path):
    payload = read_json(root / "channels.json")
    channels = payload.get("channels") if isinstance(payload, dict) else None
    if not isinstance(channels, list):
        raise WorkflowError(
            f"channels.json 的 channels 必须是数组：{root / 'channels.json'}"
        )
    details = {}
    for channel in channels:
        if not isinstance(channel, dict) or not isinstance(channel.get("id"), str):
            continue
        channel_id = channel["id"]
        if not CHANNEL_ID_RE.fullmatch(channel_id):
            raise WorkflowError(
                f"channels.json 使用非法 channel id「{channel_id}」"
            )
        if channel_id in details:
            raise WorkflowError(f"channels.json 使用重复 channel id「{channel_id}」")
        name = channel.get("name")
        details[channel_id] = {
            "name": name if isinstance(name, str) and name else channel_id,
            "enabled": bool(channel.get("enabled")),
        }
    return details


def require_text(label: str, value: str | None):
    if value is None:
        return None
    value = value.strip()
    if not value:
        raise WorkflowError(f"{label}不能为空")
    return value


def optional_text(value: str | None):
    """可选文本：空值归一成空串，不报错。"""
    if value is None:
        return ""
    return value.strip()


def required_text(label: str, value: str | None):
    """必填文本：空值直接拒绝，错误消息说清缺哪个字段。"""
    text = optional_text(value)
    if not text:
        raise WorkflowError(f"{label}不能为空")
    return text


def valid_offset_time(value):
    if not isinstance(value, str):
        return False
    try:
        parsed = datetime.fromisoformat(value)
    except ValueError:
        return False
    return parsed.tzinfo is not None and parsed.utcoffset() is not None


def instant_key(value):
    try:
        return datetime.fromisoformat(value)
    except (TypeError, ValueError):
        return value


def valid_date(value):
    if not isinstance(value, str) or not DATE_RE.fullmatch(value):
        return False
    try:
        date.fromisoformat(value)
    except ValueError:
        return False
    return True


def valid_timezone(value):
    if not is_nonempty_string(value):
        return False
    try:
        ZoneInfo(value)
    except (ZoneInfoNotFoundError, ValueError):
        return False
    return True


def planned_time_matches_timezone(planned_at, timezone_name):
    if not valid_offset_time(planned_at) or not valid_timezone(timezone_name):
        return False
    parsed = datetime.fromisoformat(planned_at)
    return parsed.utcoffset() == parsed.astimezone(ZoneInfo(timezone_name)).utcoffset()


def is_nonempty_string(value):
    return isinstance(value, str) and bool(value.strip())


def valid_public_url(value):
    if not is_nonempty_string(value):
        return False
    parsed = urlparse(value)
    return parsed.scheme in ("http", "https") and bool(parsed.netloc)


def artifact_hash(path: Path):
    try:
        payload = path.read_bytes()
    except OSError as error:
        raise WorkflowError(f"无法读取审核稿件：{path}：{error}") from error
    return "sha256:" + hashlib.sha256(payload).hexdigest()


# ---------- 创建 ----------


def new_content_id(now: datetime):
    return "content-{}-{}".format(
        now.strftime("%Y%m%d-%H%M%S%f"),
        secrets.token_hex(4),
    )


def new_publication_id(now: datetime):
    return "publication-{}-{}".format(
        now.strftime("%Y%m%d-%H%M%S%f"),
        secrets.token_hex(4),
    )


def ensure_local_directory(root: Path, relative: Path):
    current = root
    for part in relative.parts:
        current = current / part
        if current.is_symlink():
            raise WorkflowError(f"目录不能是 symlink：{current.relative_to(root)}")
        if current.exists() and not current.is_dir():
            raise WorkflowError(f"路径必须是目录：{current.relative_to(root)}")
        current.mkdir(exist_ok=True)
        if not current.resolve().is_relative_to(root):
            raise WorkflowError(f"目录越出实例：{current.relative_to(root)}")
    return current


def resolve_actor(root: Path, actor: str | None):
    """决定 actor：显式参数优先，其次 OPC_ROLE，最后默认 content。

    注意信任边界：OPC_ROLE 由角色启动器导出，但调用方自己也能设置它，
    所以这条检查防的是「误用」（拿 --actor 写别人），不是「伪造」。
    actor 是内容卡的归属记录，不是授权；权限由 owner 为每个角色选择的
    CLI 原生模式与用户级配置控制。
    """
    environment_role = (os.environ.get("OPC_ROLE") or "").strip()
    requested = require_text("actor", actor)
    if requested and environment_role and requested != environment_role:
        raise WorkflowError(
            f"actor「{requested}」与当前角色 OPC_ROLE「{environment_role}」不一致，拒绝冒充"
        )
    chosen = requested or environment_role or DEFAULT_ACTOR
    roles = configured_roles(root)
    if chosen not in roles:
        raise WorkflowError(f"非法 actor「{chosen}」：必须是 roles.json 中的 role key")
    if not roles[chosen]:
        raise WorkflowError(f"actor「{chosen}」在 roles.json 里已停用")
    return chosen


def create_content(
    root: Path,
    title: str,
    source: str | None,
    summary: str | None,
    target_date: str | None,
    actor: str | None,
):
    root = ensure_instance(root)
    title = require_text("标题", title)
    source = require_text("来源", source)
    summary = require_text("摘要", summary)
    target_date = require_text("目标日期", target_date)
    if target_date is not None and not valid_date(target_date):
        raise WorkflowError("目标日期必须是 YYYY-MM-DD")
    actor = resolve_actor(root, actor)

    content_root = ensure_local_directory(root, CONTENT_DIR)
    while True:
        now = datetime.now(timezone.utc)
        content_id = new_content_id(now)
        package = content_root / content_id
        try:
            package.mkdir()
        except FileExistsError:
            continue
        break

    created_at = now.isoformat(timespec="microseconds")
    record = {
        "schema_version": SCHEMA_VERSION,
        "record_type": "content",
        "content_id": content_id,
        "title": title,
        "status": "proposed",
        "created_at": created_at,
        "actor": actor,
        "events": [
            {
                "action": "create",
                "at": created_at,
                "actor": actor,
                "to_status": "proposed",
            }
        ],
    }
    if source is not None:
        record["source"] = source
    if summary is not None:
        record["summary"] = summary
    if target_date is not None:
        record["target_date"] = target_date

    card = package / CARD_NAME
    body = "---\n{}\n---\n\n# 内容卡\n".format(
        json.dumps(record, ensure_ascii=False, indent=2)
    )
    try:
        card.write_text(body, encoding="utf-8")
    except OSError:
        try:
            package.rmdir()
        except OSError:
            pass
        raise

    relative = card.relative_to(root)
    return content_id, relative.as_posix(), actor


def create_publication(
    root: Path,
    content_id: str,
    channel: str,
    actor_arg: str | None,
    required_windows: list[str] | None = None,
    optional: bool = False,
):
    root = ensure_instance(root)
    actor = resolve_actor(root, actor_arg)
    if actor != "gm":
        raise WorkflowError("创建 publication 的 actor 必须是 gm")
    channel = require_text("channel", channel)
    channels = configured_channels(root)
    if channel not in channels:
        raise WorkflowError(f"未知 channel「{channel}」：必须来自 channels.json")
    if not channels[channel]:
        raise WorkflowError(f"channel「{channel}」在 channels.json 里已停用")
    required_windows = required_windows or []
    if any(not METRIC_WINDOW_RE.fullmatch(window) for window in required_windows):
        raise WorkflowError("required window 必须形如 48h、7d 或 2w")
    if len(required_windows) != len(set(required_windows)):
        raise WorkflowError("required metric windows 不能重复")
    if optional and required_windows:
        raise WorkflowError("可选 publication 不能声明 required metric windows")

    root, _content_package, _card, content, _body = load_content_for_transition(
        root, content_id
    )
    if content.get("status") != "ready":
        raise WorkflowError("只有 ready 内容可以创建 publication")
    if isinstance(content.get("block"), dict):
        raise WorkflowError("内容处于 blocked 状态，请先解除阻塞")

    publications = ensure_local_directory(
        root,
        CONTENT_DIR / content_id / PUBLICATIONS_DIR_NAME,
    )
    while True:
        now = datetime.now(timezone.utc)
        publication_id = new_publication_id(now)
        package = publications / publication_id
        try:
            package.mkdir()
        except FileExistsError:
            continue
        break

    created_at = now.isoformat(timespec="microseconds")
    record = {
        "schema_version": SCHEMA_VERSION,
        "record_type": "publication",
        "publication_id": publication_id,
        "content_id": content_id,
        "channel": channel,
        "status": "adapting",
        "created_at": created_at,
        "actor": actor,
        "channel_draft": CHANNEL_DRAFT_NAME,
        "required": not optional,
        "required_metric_windows": required_windows,
        "events": [
            {
                "action": "create",
                "at": created_at,
                "actor": actor,
                "to_status": "adapting",
            }
        ],
    }
    draft = package / CHANNEL_DRAFT_NAME
    card = package / PUBLICATION_CARD_NAME
    body = "---\n{}\n---\n\n# 发布卡\n".format(
        json.dumps(record, ensure_ascii=False, indent=2)
    )
    try:
        write_atomic(draft, f"# {content['title']}（{channel}）\n")
        write_atomic(card, body)
    except OSError:
        for created in (card, draft):
            try:
                created.unlink()
            except FileNotFoundError:
                pass
        try:
            package.rmdir()
        except OSError:
            pass
        raise

    relative = card.relative_to(root)
    return publication_id, relative.as_posix(), actor


