# ---------------------------------------------------------------- 仓库读取


def git_tracked_files(root):
    """仓库里的文件列表：已跟踪的 + 未被忽略的未跟踪文件。

    只看已跟踪文件会让「刚 add 进来还没提交」的业务文件逃过检查，所以把
    未忽略的未跟踪文件也算进来。不在 git 仓库里就退回文件系统遍历。
    """
    try:
        out = subprocess.run(
            ["git", "-C", root, "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
            check=True, capture_output=True,
        ).stdout
        names = [n for n in out.decode("utf-8", "replace").split("\0") if n]
        if names:
            return names
    except (OSError, subprocess.CalledProcessError):
        pass
    names = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in (".git", ".opc", "__pycache__")]
        for fn in filenames:
            full = os.path.join(dirpath, fn)
            names.append(os.path.relpath(full, root))
    return names


def read_text(path):
    """读文本；二进制返回 None。"""
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except OSError:
        return None
    if b"\0" in raw[:8192]:
        return None
    return raw.decode("utf-8", "replace")


def safe_join(root, rel):
    """把策略里的相对路径接到 root 下，并保证结果仍在 root 之内。

    策略是数据文件，里面的路径不该被当成可信输入：绝对路径、`..` 成分
    都可能让读取跑到仓库之外。返回 None 表示这个路径不合法。
    """
    if not rel or not isinstance(rel, str):
        return None
    if rel.startswith("/") or os.path.isabs(rel):
        return None
    parts = rel.replace("\\", "/").split("/")
    if any(p == ".." for p in parts):
        return None
    full = os.path.normpath(os.path.join(root, rel))
    root_abs = os.path.abspath(root)
    if full != root_abs and not full.startswith(root_abs + os.sep):
        return None
    return full


def code_without_comments(text):
    """去掉整行注释，只留代码。用来判断「守卫逻辑真的在」而不是「注释里提到过」。"""
    if not text:
        return ""
    return "\n".join(
        line for line in text.splitlines() if not line.strip().startswith("#")
    )


def load_policy(root):
    """读载荷清单。模版侧读 template/install-manifest.json；实例侧读 mechanism 快照。"""
    payload = payload_root(root)
    path = os.path.join(payload, MANIFEST_REL)
    if not os.path.isfile(path):
        return load_instance_policy(root)
    try:
        with open(path, encoding="utf-8") as fh:
            raw = json.load(fh)
    except (OSError, ValueError) as exc:
        return None, "读不了 {}：{}".format(MANIFEST_REL, exc)
    try:
        mech = raw.get("mechanism", {})
        rules = []
        for rel in mech.get("dirs", []):
            rules.append(Rule(rel.rstrip("/") + "/", "managed"))
        for rel in mech.get("files", []):
            rules.append(Rule(rel, "managed"))
        starters = raw.get("starters", {})
        for spec in starters.get("files", []):
            rules.append(Rule(spec["source"], "starter"))
        for spec in starters.get("dirs", []):
            # 目录型起始材料可以先声明后落地（如 `skills/`）：目录不在就不起作用。
            rules.append(Rule(spec["source"].rstrip("/") + "/", "starter", optional=True))
        for spec in raw.get("config", []):
            rules.append(Rule(spec["target"], "merge"))
        for seed in raw.get("seeds", []):
            rules.append(Rule(seed["source"], "seeds"))
        ui = raw.get("ui", {})
        for mod in ui.get("mods", []):
            rules.append(Rule("mods/{}/".format(mod), "ui"))
        for layout in ui.get("layouts", []):
            rules.append(Rule(layout["source"], "ui"))
            if layout.get("asset"):
                rules.append(Rule(layout["asset"], "ui"))
        rules.append(Rule("seeds/", "seeds"))
        rules.append(Rule("knowledge/", "local"))
        rules.append(Rule(".opc/", "local"))
        rules.append(Rule(MANIFEST_REL, "template-only"))
        return Policy(
            version=int(raw.get("version", 0)),
            rules=rules,
            seeds=raw.get("seeds", []),
            merge_configs=raw.get("config", []),
            seed_rules=raw.get("seedRules", {}),
            proposal_dir=raw.get("proposalDir", "knowledge/work/*/template-proposals"),
            proposal_sections=raw.get("proposalSections", []),
            raw=raw,
        ), None
    except (KeyError, TypeError, ValueError) as exc:
        return None, "{} 结构不对：{}".format(MANIFEST_REL, exc)


def load_instance_policy(root):
    """实例侧没有完整清单：从 .opc/mechanism.json 取提案口径。"""
    path = os.path.join(root, ".opc", "mechanism.json")
    raw = {}
    if os.path.isfile(path):
        try:
            with open(path, encoding="utf-8") as fh:
                raw = (json.load(fh) or {}).get("policy", {})
        except (OSError, ValueError):
            raw = {}
    if not raw:
        return None, "实例缺少 .opc/mechanism.json 的 policy 快照"
    return Policy(
        version=int(raw.get("manifestVersion", 1)),
        rules=[],
        seeds=[],
        merge_configs=[],
        seed_rules={},
        proposal_dir=raw.get("proposalDir", "knowledge/work/*/template-proposals"),
        proposal_sections=raw.get("proposalSections", []),
        raw=raw,
    ), None


def instance_metadata(root):
    """读实例元数据。不是合法实例就返回 None。

    「是不是实例」不能只看文件在不在——放一个空的 .opc/instance.json 就能
    把模版侧的检查全部关掉。所以要求它是合法 JSON 且 kind == opc-instance。
    """
    path = os.path.join(root, ".opc", "instance.json")
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict) or data.get("kind") != "opc-instance":
        return None
    return data


def lint_mode(root):
    """判断这次 lint 跑在哪一侧：模版仓库还是实例。

    两侧的规则集完全分开，互不串场：

    实例  根目录有合法的 .opc/instance.json（kind == opc-instance）。
    模版  其余情况：模版仓库有 .opc-template-repo 标记；标记被误删时，
          根下有载荷清单（template/install-manifest.json）也算模版仓库。

    顺序很重要：标记优先于实例元数据——装了标记的目录就是模版仓库，
    实例元数据不能把模版侧的规则关掉；反过来，一个自称实例的目录如果
    连实例元数据都拿不出合法结果，就按模版仓库算，宁可多查也不放过。
    """
    if os.path.isfile(os.path.join(root, MARKER_REL)):
        return MODE_TEMPLATE
    if instance_metadata(root) is not None:
        return MODE_INSTANCE
    if os.path.isfile(os.path.join(root, PAYLOAD_REL, MANIFEST_REL)):
        return MODE_TEMPLATE
    return MODE_INSTANCE


def is_template_repo(root):
    """是不是模版仓库（lint_mode 的布尔写法）。"""
    return lint_mode(root) == MODE_TEMPLATE


def classify(policy, rel_path):
    """最长前缀优先匹配。返回 (mode, rule) 或 (None, None)。"""
    best = None
    best_len = -1
    for rule in policy.rules:
        m = rule.match
        if m.endswith("/"):
            hit = rel_path.startswith(m)
        else:
            hit = rel_path == m
        if hit and len(m) > best_len:
            best = rule
            best_len = len(m)
    return (best.mode, best) if best else (None, None)


def find_proposals(root, policy):
    """提案文件：模版侧 docs/proposals/，实例侧 policy.proposalDir 的展开。"""
    found = []
    docs = os.path.join(root, "docs", "proposals")
    if os.path.isdir(docs):
        for fn in sorted(os.listdir(docs)):
            if fn.endswith(".md") and fn != "README.md":
                found.append(os.path.join("docs", "proposals", fn))
        if found:
            return found
    pattern = policy.proposal_dir
    if pattern.startswith("docs/"):
        base = os.path.join(root, "docs", "proposals")
        if os.path.isdir(base):
            for fn in sorted(os.listdir(base)):
                if fn.endswith(".md"):
                    found.append(os.path.join("docs", "proposals", fn))
        return found
    # knowledge/work/*/template-proposals/*.md
    work = os.path.join(root, "knowledge", "work")
    if not os.path.isdir(work):
        return found
    for role in sorted(os.listdir(work)):
        pdir = os.path.join(work, role, "template-proposals")
        if not os.path.isdir(pdir):
            continue
        for fn in sorted(os.listdir(pdir)):
            if fn.endswith(".md"):
                found.append(os.path.join("knowledge", "work", role, "template-proposals", fn))
    return found


def load_private_words(root, explicit):
    """私词表。每行一个词；`re:` 前缀按正则；`#` 开头是注释。"""
    candidates = []
    if explicit:
        candidates.append(explicit)
    else:
        candidates.append(os.path.join(root, ".opc", "private-words.txt"))
        candidates.append(os.path.expanduser("~/.config/opc/private-words.txt"))
    for path in candidates:
        if not path or not os.path.isfile(path):
            continue
        words = []
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                words.append(line)
        if words:
            return words, os.path.abspath(path)
    return [], None


