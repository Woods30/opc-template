def check_l10_policy_refs(root, policy):
    c = Check("L10", "清单引用的文件必须存在", source="install-manifest.json")
    payload = payload_root(root)
    for seed in policy.seeds:
        path = safe_join(payload, seed["source"])
        if path is None:
            c.status = STATUS_FAIL
            c.detail.append("种子源路径不合法：{}".format(seed["source"]))
        elif not os.path.isfile(path):
            c.status = STATUS_FAIL
            c.detail.append("种子源不存在：{}".format(seed["source"]))
    for rule in policy.rules:
