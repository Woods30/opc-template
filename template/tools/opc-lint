def template_side_paths(policy, tracked):
    """实例里「来自模版一侧」的文件路径。

    实例模式下私词检查只看这些：业务文件里出现真实品牌名是正常的，
    模版托管的文件里出现才是污染。
    """
    if policy is None:
        return set()
    prefixes = [r.match for r in policy.rules if r.mode in ("managed", "merge", "seeds")]
    out = set()
    for rel in tracked:
        for m in prefixes:
            if m.endswith("/"):
                if rel.startswith(m):
                    out.add(rel)
                    break
            elif rel == m:
                out.add(rel)
                break
    return out


