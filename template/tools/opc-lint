def resolve_inside(root, rel):
    """把相对路径接到 root 下，并保证展开软链接后仍在 root 之内。

    口径与实例侧 lib.sh 的 opc_safe_rel_path 一致：相对路径、不含 ..，
    软链接展开后仍在实例内。返回 None 表示路径不合法。
    """
    if not rel or not isinstance(rel, str):
        return None
    rel = rel.replace("\\", "/")
    if rel.startswith("/") or os.path.isabs(rel):
        return None
    parts = [p for p in rel.split("/") if p not in ("", ".")]
    if any(p == ".." for p in parts):
        return None
    root_real = os.path.realpath(root)
    full = os.path.realpath(os.path.join(root, *parts))
    if full != root_real and not full.startswith(root_real + os.sep):
        return None
    return full


def legal_skill_name(name):
    """技能名是否合法。

    口径与 lib.sh 的 opc_safe_skill_name 一致：普通标识符，且不含 ..。
    """
    if not isinstance(name, str) or not RE_SKILL_NAME.match(name):
        return False
    return ".." not in name


def instance_roles(root):
    """读实例的 roles.json。返回 (角色列表, 错误信息)。

    角色列表为 None 表示读不了（错误信息里说明原因）。
    """
    path = os.path.join(root, "roles.json")
    if not os.path.isfile(path):
        return None, "实例里没有 roles.json"
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError) as exc:
        return None, "roles.json 读不了：{}".format(exc)
    roles = data.get("roles")
    if not isinstance(roles, list):
        return None, "roles.json 缺 roles 数组"
    return roles, None


def enabled_roles(roles):
    return [r for r in roles if r.get("enabled")]


def selected_skills(roles):
    """启用角色选中的技能名（去重，保持 roles.json 里的顺序）。

    只算启用角色：停用角色的技能不会进任何 hc 模板。
    """
    names = []
    for role in enabled_roles(roles):
        for name in role.get("skills") or []:
            if name not in names:
                names.append(name)
    return names


