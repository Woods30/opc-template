def check_l37_no_inbox_dispatch(root):
    """规约里不再把收件箱当派工总线，也没有空闲时的自持回路。

    收件箱已退休：任务卡才是派工来源。规约再把收件箱说成派工总线或待办
    来源，角色就会去一个不存在的目录找活；写「空闲时主动检查」这类自持
    回路，角色就会在没有 owner 指令时自己开工。

    判定按分句做，并认否定：「不读别人的收件箱」是在禁止，不是在派工。
    """
    c = Check("L37", "规约不用收件箱派工", source="AGENTS.md 与 agents/*/AGENTS.md")
    payload = payload_root(root)
    targets = []
    root_rules = os.path.join(payload, "AGENTS.md")
    if os.path.isfile(root_rules):
        targets.append(root_rules)
    agents_dir = os.path.join(payload, "agents")
    if os.path.isdir(agents_dir):
        for name in sorted(os.listdir(agents_dir)):
            path = os.path.join(agents_dir, name, "AGENTS.md")
            if os.path.isfile(path):
                targets.append(path)
    fails = []
    for path in targets:
        text = read_text(path)
        if text is None:
            continue
        label = os.path.relpath(path, payload)
        for clause in split_clauses(text):
            has_inbox = bool(RE_INBOX.search(clause))
            if has_inbox:
                for match in RE_INBOX_SOURCE.finditer(clause):
                    if clause_action_negated(clause, match.start()):
                        continue
                    fails.append("{}：把收件箱当成了派工或待办来源：{}"
                                 .format(label, clause[:50]))
                    break
                for match in RE_SELF_SCAN.finditer(clause):
                    if clause_action_negated(clause, match.start()):
                        continue
                    fails.append("{}：拿收件箱当巡检对象：{}".format(label, clause[:50]))
                    break
            if RE_IDLE.search(clause):
                for match in RE_ACTIVE_SCAN.finditer(clause):
                    if clause_action_negated(clause, match.start()):
                        continue
                    fails.append("{}：空闲时的自持回路：{}".format(label, clause[:50]))
                    break
    c.detail.extend(fails)
    if fails:
        c.status = STATUS_FAIL
    return c


def check_l38_instance_model(root):
    """实例里的模型名要合法。

    字符集与安装器一致（bin/opc_lib/install.py 的 MODEL_RE）：模型名会被
    拼进启动命令行交给 CLI 解析，奇怪字符会变成往命令行里塞东西的路。
    字段缺失是合法状态——旧实例没有这个字段，按该 CLI 的默认模型跑。
    """
    c = Check("L38", "实例模型名合法", source="roles.json")
    roles, err = instance_roles(root)
    if roles is None:
        c.status = STATUS_SKIP
        c.detail.append("{}，跳过".format(err))
        return c
    for role in roles:
        if "model" not in role:
            continue
        model = role.get("model")
        name = role.get("name", "")
        if not isinstance(model, str):
            c.status = STATUS_FAIL
            c.detail.append("角色 {} 的 model 不是字符串".format(name))
            continue
        if not model:
            continue
        if not RE_MODEL_VALUE.fullmatch(model):
            c.status = STATUS_FAIL
            c.detail.append("角色 {} 的模型名不合法：{}（只允许字母数字与 . _ : / -）"
                             .format(name, model))
    return c


def _cell_key(text):
    """表格单元格的比较键：去掉空白与反引号。"""
    return re.sub(r"\s+", "", (text or "").strip().strip("`"))


def parse_team_registry(text):
    """名册里的角色注册表。返回 (表头, 数据行) ；取不到返回 None。"""
    lines = (text or "").splitlines()
    start = None
    for index, line in enumerate(lines):
        if line.strip() == TEAM_REGISTRY_HEADING:
            start = index + 1
            break
    if start is None:
        return None
    header = None
    rows = []
    for line in lines[start:]:
        stripped = line.strip()
        if stripped.startswith("## "):
            break
        if not stripped.startswith("|"):
            continue
        cells = [cell.strip() for cell in stripped.strip("|").split("|")]
        if header is None:
            header = cells
            continue
        if all(set(cell) <= set("-: ") for cell in cells):
            continue
        rows.append(cells)
    if header is None:
        return None
    return header, rows


def check_l39_team_registry(root):
    """实例名册里的角色注册表要能派工。

    每个角色行的 CLI、模型、权限模式、所在 tab 四格必须填实：缺一格，
    编排者就起不来会话、或者不知道把任务卡交给谁。模型留空时安装器写的
    是「默认模型」，所以这一格永远不该是空的。

    名册还不存在的实例按跳过处理——没装过的实例不该被这一步拦住。
    """
    c = Check("L39", "名册角色注册表格式合法", source="knowledge/team.md")
    path = os.path.join(root, "knowledge", "team.md")
    if not os.path.isfile(path):
        c.status = STATUS_SKIP
        c.detail.append("实例里没有 knowledge/team.md，跳过")
        return c
    text = read_text(path)
    if text is None:
        c.status = STATUS_FAIL
        c.detail.append("knowledge/team.md 不是可读文本")
        return c
    parsed = parse_team_registry(text)
    if parsed is None:
        c.status = STATUS_FAIL
        c.detail.append("knowledge/team.md 里没有「{}」小节下的注册表".format(
            TEAM_REGISTRY_HEADING))
        return c
    header, rows = parsed
    index_of = {}
    for position, cell in enumerate(header):
        index_of.setdefault(_cell_key(cell), position)
    fails = []
    for label, key in TEAM_REQUIRED_COLUMNS:
        if key not in index_of:
            fails.append("注册表缺少「{}」列：{}".format(label, "|".join(header)))
    if fails:
        c.status = STATUS_FAIL
        c.detail.extend(fails)
        return c
    role_column = index_of.get(_cell_key("角色"), 0)
    for row in rows:
        role = row[role_column] if role_column < len(row) else "?"
        for label, key in TEAM_REQUIRED_COLUMNS:
            position = index_of[key]
            value = row[position] if position < len(row) else ""
            if not _cell_key(value):
                fails.append("角色 {} 的「{}」是空的".format(role, label))
    c.detail.extend(fails)
    if fails:
        c.status = STATUS_FAIL
    return c


