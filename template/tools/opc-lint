RE_BIG_NUMBER = re.compile(r"\b\d{3,}\b")
# 字面量拆开写，免得这条规则命中它自己的源码
RE_LOCAL_PATH = re.compile(r"/User" + r"s/|/home/[a-z][a-z0-9_-]*/")
RE_PLACEHOLDER = re.compile(r"TODO|<[^<>\n]{2,}>", re.IGNORECASE)
RE_CHECKBOX = re.compile(r"^\s*-\s*\[[ xX]\]", re.MULTILINE)
# 取材范围：角色必须被写明「只在本实例目录内取材」。
# 少了这条，角色会顺着 `hc ls` 里别的终端的 cwd 去读别的实例目录。
#
# 这是一条安全约束，不能靠散文里出现关键词来判定：
#   - 规范句式必须逐字出现，且落在行首的加粗项目符号上（锚定匹配）；
#   - 文件里出现与它冲突的表述同样算违规。
#
# 冲突检测不枚举「坏句式」——中文改写无穷无尽，枚举必然漏。
# 改成反向判定：某个分句提到实例外的地方，又带着「读/看」类动词，
# 而这个分句里没有绑定到该动作的限制说法（不得/不读…），
# 也没有绑定到该动作的授权说法（先向 gm 说明并拿到授权），一律判违规。
# 认不出来的说法默认拦下，不默认放过。
#
# 判定按**分句**做，不按整句：例外必须与动作落在同一个分句里，
# 否则「不要读本实例的稿子，可以读别的实例」会被前半句的「不要」蒙混过关。
SCOPE_DIRECTIVE = "只在本实例目录内取材"
RE_INSTANCE_SCOPE = re.compile(
    r"^\s*-\s+\*\*" + re.escape(SCOPE_DIRECTIVE) + r"\*\*", re.MULTILINE)
# 直接否定规范句式本身（「不必只在本实例目录内取材」）
RE_DIRECTIVE_NEGATION = re.compile(
    r"(不用|不必|无需|不需要|不要|禁止|勿)[^。\n]{0,12}只在本实例")
# 实例外的地点：这些词出现的地方，所在分句就要自证「不读」或「先授权」
RE_OUT_OF_SCOPE = re.compile(
    r"实例(?:目录)?外|实例之外|其他实例|别的实例|其它实例|兄弟实例|同类实例"
    r"|旧实例|历史实例")
# 读与看的动作
RE_PERMISSION = re.compile(r"读(?:取)?|打开|访问|查看|看|取材|参考|进入|搜索|搜")
# 放行说法：分句里出现这些字，说明它在授权某个动作
RE_PERMISSIVE = re.compile(r"可以|允许|能够|能|随意|尽管")
# 限制说法：否定词必须绑在这个动作上——中间只允许「去/再」和少数修饰词，
# 否则「不必犹豫读别的实例」会被误当成禁止。
_VERB = r"(?:读(?:取)?|打开|访问|查看|看|取材|参考|进入|搜索|搜)"
_NEG_WORD = r"(?:不得|不能|不许|禁止|不要|不必|不用|无需|勿|不)"
RE_NEGATED_PERMISSION = re.compile(
    _NEG_WORD + r"(?:去|再)?(?:擅自|随意|直接)?" + _VERB)
# 授权说法：必须与动作同分句（先向 gm 说明并拿到授权）
RE_AUTH_GATE = re.compile(
    r"授权|批准|许可|先向[^。\n]{0,12}(说明|报|问)|经[^。\n]{0,8}(同意|批准)")

PERMISSION_MODES = {"default", "manual", "auto", "acceptEdits", "plan", "dontAsk",
                    "bypassPermissions"}
RE_ROLE_NAME = re.compile(r"^[a-z][a-z0-9_-]{0,19}$")

# 角色启动小节里必须出现的正面指令：
#   普通角色 —— 等 gm 派工；gm 自己 —— 先与 owner 对齐方向。
# 关键词出现不等于说了这句话：「不用等 gm 派工」里同样有「等 gm 派工」，
# 意思正好相反。所以命中之后还要看它前面有没有否定词，并且单列分句里
# 隔着几个字的否定也算——「没必要自己先开一稿再等 gm 派工」同样是否定。
NEGATION_MARKERS = ("不需要", "没必要", "不用", "无需", "不必", "不要", "不能",
                    "不得", "不应", "不可", "禁止", "无权", "拒绝", "别", "甭")
# 单字否定词（「别」）夹在别的词里容易误判（区别、分别），所以只要求它们
# 紧贴关键词；多字否定词才放宽到同一分句。
CLAUSE_NEGATIONS = ("不需要", "没必要", "不用", "无需", "不必", "不要", "不能",
                    "不得", "不应", "不可", "禁止", "无权", "拒绝")
RE_NEGATED_TAIL = re.compile(
    "(?:" + "|".join(NEGATION_MARKERS) + r")(?:再|先|就|才|自己|自行|自选)?$")
RE_NEGATED_DISPATCH = re.compile(
    "(?:" + "|".join(CLAUSE_NEGATIONS) + r")[^。\n；;，,]{0,16}等[^。\n；;]{0,12}派工")
RE_NEGATED_OWNER = re.compile(
    "(?:" + "|".join(CLAUSE_NEGATIONS)
    + r")[^。\n；;，,]{0,16}(?:与|和|跟)[^。\n；;]{0,10}owner[^。\n；;]{0,10}对齐")
RE_DISPATCH = re.compile(r"等[^。\n；;]{0,12}派工")
RE_OWNER_ALIGN = re.compile(r"(?:与|和|跟)[^。\n；;]{0,10}owner[^。\n；;]{0,10}对齐")
RE_STARTUP_HEADING = re.compile(r"^#{1,6}[ \t]*启动不自主开工[ \t]*$", re.MULTILINE)
# 同一条正面指令所在的那句里又让角色自己开工，一样是自相矛盾：
# 「等 gm 派工后再自己开题」既有「等 gm 派工」，也没有否定词。
RE_AUTONOMY = re.compile(r"(?:自己|自行|直接)(?:开题|开工|找活|决定|做主|上手)|自选选题")
SENTENCE_BREAKS = "。！？\n；;"

