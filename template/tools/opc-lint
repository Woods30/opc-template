def default_root():
    """从脚本位置推导仓库根：template/tools/opc-lint → 仓库根；实例里就是实例根。"""
    here = DEFAULT_ROOT
    if os.path.basename(here) == PAYLOAD_REL:
        return os.path.dirname(here)
    return here


def payload_root(root):
    """载荷根：模版仓库是 <root>/template，实例里就是实例根。"""
    candidate = os.path.join(root, PAYLOAD_REL)
    if os.path.isfile(os.path.join(candidate, MANIFEST_REL)):
        return candidate
    return root

