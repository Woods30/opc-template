TEAM_REGISTRY_HEADING = "## 角色注册表"
# 名册注册表里必须填实的四格：没有 CLI 就起不来会话，没有模型与权限档
# 就不知道用哪套配置，没有 tab 就不知道把任务卡交给谁。
TEAM_REQUIRED_COLUMNS = (
    ("CLI", "CLI"),
    ("模型", "模型"),
    ("权限模式", "权限模式"),
    ("所在 tab", "所在tab"),
)


def check_l35_template_model_empty(root):
    """模版里的角色配置不写死模型名。

    模版是公开的、多实例共用的：写死一个模型名等于替所有实例做了同一个
    决定，而这个决定会过期（网关改名、模型下线、实例想换一个）。模版侧
    一律留空，由实例自己选；留空表示用该 CLI 的默认模型。
    """
    c = Check("L35", "模版角色配置不写死模型名", source="roles.json")
    payload = payload_root(root)
    path = os.path.join(payload, "roles.json")
    if not os.path.isfile(path):
        c.status = STATUS_FAIL
        c.detail.append("找不到 roles.json")
        return c
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError) as exc:
        c.status = STATUS_FAIL
        c.detail.append("roles.json 读不了：{}".format(exc))
        return c
    roles = data.get("roles")
    if not isinstance(roles, list) or not roles:
        c.status = STATUS_FAIL
        c.detail.append("roles.json 里没有角色")
        return c
    for role in roles:
        name = role.get("name", "")
        if "model" not in role:
            c.status = STATUS_FAIL
            c.detail.append("角色 {} 没有 model 字段：模版侧要显式留空，表示用该 CLI 的默认模型"
                             .format(name))
        elif role.get("model") != "":
            c.status = STATUS_FAIL
            c.detail.append("角色 {} 写死了模型名 {}：模版只定机制，模型由实例自己选"
                             .format(name, role.get("model")))
    return c


def check_l36_no_literal_model(root, payload_tracked):
    """模版载荷里不出现写死的模型名。

    只认形态不认名字：命令行里跟了一个具体模型名就算命中。这里不列任何
    厂商或模型名——列出来就等于把名字写进模版，这条规则自己先违规。
