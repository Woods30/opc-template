RE_ROLE_STARTUP_HEADING = re.compile(r"^##[ \t]*启动[ \t]*$", re.MULTILINE)


def role_startup_section(text):
    """取角色模板里「## 启动」小节的正文；没有这一节返回 None。"""
    if not text:
        return None
    m = RE_ROLE_STARTUP_HEADING.search(text)
    if not m:
        return None
    body = text[m.end():]
    next_section = body.find("\n## ")
    if next_section >= 0:
        body = body[:next_section]
    return body


def sentence_bounds(text, index):
    """index 所在那一句的起止位置。句号、换行、分号都算句子边界。"""
    start = 0
    for ch in SENTENCE_BREAKS:
        pos = text.rfind(ch, 0, index)
        if pos + 1 > start:
            start = pos + 1
    end = len(text)
    for ch in SENTENCE_BREAKS:
        pos = text.find(ch, index)
        if pos != -1 and pos < end:
            end = pos
    return start, end


def startup_instruction(section, pattern, negation):
    """小节里有没有一条没被否定的正面指令。

    光出现关键词不算：「不用等 gm 派工」里也有「等 gm 派工」，意思正好相反。
    所以每处命中都要看它前面对不对得上否定词，整段分句里出现的否定也算，
    指令后面同一句里再让角色自己开工也算。

    返回 (有正面表述, 有被否定的表述)。调用方只要看到否定的表述就判失败：
    同一小节里前后矛盾，读的人只会记住对自己有利的那句。
    """
    positive = False
    negated = negation.search(section) is not None
    for m in pattern.finditer(section):
        head = section[max(0, m.start() - 8):m.start()].strip()
        _, end = sentence_bounds(section, m.start())
        if RE_NEGATED_TAIL.search(head) or RE_AUTONOMY.search(section[m.end():end]):
            negated = True
            continue
        positive = True
    return positive, negated


def check_l17_role_startup(root):
    """角色启动不自主开工：先汇报现状，等 gm 派工（gm 自己先与 owner 对齐）。

    只在模版侧跑。实例里的角色正文归 owner 管，lint 不拦内容。
    """
    c = Check("L17", "角色启动不自主开工", source="AGENTS.md 与 agents/*.md")
    payload = payload_root(root)
    fails = []

    rules = read_text(os.path.join(payload, "AGENTS.md"))
    if rules is None:
        fails.append("找不到 AGENTS.md")
    elif not RE_STARTUP_HEADING.search(rules):
        fails.append("AGENTS.md 缺少「启动不自主开工」小节：角色启动后先汇报现状，再等 gm 派工")

    roles_path = os.path.join(payload, "roles.json")
    try:
        with open(roles_path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError) as exc:
        c.status = STATUS_FAIL
        c.detail.append("roles.json 读不了：{}".format(exc))
        return c

    for role in data.get("roles", []):
        name = role.get("name", "")
        template = role.get("template")
        if not template:
            continue
        path = safe_join(payload, template)
        if path is None:
            fails.append("角色 {} 的模板路径不合法：{}".format(name, template))
            continue
        if not os.path.isfile(path):
            fails.append("角色 {} 的模板文件不存在：{}".format(name, template))
            continue
        text = read_text(path)
        section = role_startup_section(text)
        if section is None:
            fails.append("角色 {} 的模板缺少「## 启动」小节：{}".format(name, template))
            continue
        if name == "gm":
            positive, negated = startup_instruction(section, RE_OWNER_ALIGN, RE_NEGATED_OWNER)
            if negated:
                fails.append("角色 gm 的启动小节出现了否定的表述：必须写明先与 owner 对齐方向")
            elif not positive:
                fails.append("角色 gm 的启动小节必须写明先与 owner 对齐方向")
        else:
            positive, negated = startup_instruction(section, RE_DISPATCH, RE_NEGATED_DISPATCH)
            if negated:
                fails.append("角色 {} 的启动小节出现了否定的表述：必须写明等 gm 派工：{}".format(name, template))
            elif not positive:
                fails.append("角色 {} 的启动小节必须写明等 gm 派工：{}".format(name, template))

    c.detail.extend(fails)
    if fails:
        c.status = STATUS_FAIL
    return c


def check_l18_instance_scope(root):
    """角色只在本实例目录内取材：实例目录外的东西不是本实例的业务。

    不写这条，角色会顺着 `hc ls` 里别的终端的 cwd 找「同类实例」，
    读到别家公司的业务——既越界，也可能把结论串味。

    规范句式要逐字落在行首的加粗项目符号上；同一文件里出现与它冲突的
    表述也算违规——散文里出现关键词不等于这条约束真的写着。
    冲突判定是反向的：提到实例外 + 读/看动词 + 没有限制或授权说法 → 违规。

    只在模版侧跑。实例里的角色正文归 owner 管，lint 不拦内容。
    """
    c = Check("L18", "角色只在本实例内取材", source="AGENTS.md 与 agents/*.md")
    payload = payload_root(root)
    fails = []

    def inspect(label, text):
        """返回违规说明列表：规范句式缺失，或与它冲突。

        判定分两层：
        - 强分隔（。；换行）内，地点主题可以递给后面第一个动作分句，
          所以「别的实例，可以读」也会被抓到；
        - 动作分句的否定与授权必须落在**自己这一分句**里，
          前半句的「不要」豁免不了后半句的放行。
        """
        problems = []
        if text:
            hit = RE_DIRECTIVE_NEGATION.search(text)
            if hit:
                problems.append("{} 有与取材范围冲突的表述（否定规范句式）：{}"
                                .format(label, hit.group(0).strip()))
            for segment in re.split(r"[。；;\n]", text):
                topic = False  # 前面分句点到的「实例外地点」，递给下一个动作分句
                for clause in re.split(r"[，,、]", segment):
                    # 规范句式本身不算「提到实例外又去读」：它正是那条禁令
                    clause = clause.replace(SCOPE_DIRECTIVE, "")
                    has_place = bool(RE_OUT_OF_SCOPE.search(clause))
                    has_action = bool(RE_PERMISSION.search(clause))
                    if not has_action:
                        if has_place:
                            topic = True
                        continue
                    if not (has_place or topic):
                        continue
                    topic = False
                    if RE_NEGATED_PERMISSION.search(clause) or RE_AUTH_GATE.search(clause):
                        continue
                    hint = "（这一句在放行读实例外）" if RE_PERMISSIVE.search(clause) else ""
                    problems.append(
                        "{} 有与取材范围冲突的表述{}：{}".format(
                            label, hint, clause.strip()))
        if not text or not RE_INSTANCE_SCOPE.search(text):
            problems.append(
                "{} 缺少「- **只在本实例目录内取材**」这一条：".format(label)
                + "角色不得顺着别的终端或目录线索去读实例外的路径")
        return problems

    rules = read_text(os.path.join(payload, "AGENTS.md"))
    if rules is None:
        fails.append("找不到 AGENTS.md")
    else:
        fails.extend(inspect("AGENTS.md", rules))

    roles_path = os.path.join(payload, "roles.json")
    try:
        with open(roles_path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError) as exc:
        c.status = STATUS_FAIL
        c.detail.append("roles.json 读不了：{}".format(exc))
        return c

    for role in data.get("roles", []):
        name = role.get("name", "")
        template = role.get("template")
        if not template:
            continue
        path = safe_join(payload, template)
        if path is None:
            fails.append("角色 {} 的模板路径不合法：{}".format(name, template))
            continue
        if not os.path.isfile(path):
            fails.append("角色 {} 的模板文件不存在：{}".format(name, template))
            continue
        text = read_text(path)
        fails.extend(inspect("角色 {} 的模板（{}）".format(name, template), text))

    c.detail.extend(fails)
    if fails:
        c.status = STATUS_FAIL
    return c


