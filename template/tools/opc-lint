RE_INBOX = re.compile(r"收件箱|\binbox\b|knowledge/inbox")
# 把收件箱当成活儿来源的说法。
RE_INBOX_SOURCE = re.compile(
    r"派工|派活|待办|待处理|任务来源|来源|为准|条目|未标记|队列"
    r"|领取|认领|取任务|写进|投递|放到|送达")
# 把收件箱当成巡检对象：自己去翻它不叫自持回路，叫没有派工来源。
RE_SELF_SCAN = re.compile(r"巡检|扫描|轮询|检查|查看|翻")
# 空闲时的自持回路：空闲 + 自己去找活。「空闲时不主动读…」这种写法
# 是禁令，不能当成回路——否定词绑在动作前才算数。
RE_IDLE = re.compile(r"空闲|闲着|闲下来|没事做|无事时|待命")
RE_ACTIVE_SCAN = re.compile(
    r"主动检查|主动巡检|主动扫描|主动查看|主动看|主动读|主动查|主动找"
    r"|自己找|找活|巡检|扫描|轮询|检查")
# 否定词：出现在动作之前就算数（中间允许少量修饰词）。
RE_NEG_BIND = re.compile(
    r"(?:不需要|没必要|不用|无需|不必|不要|不能|不得|不应|不可|禁止"
    r"|无权|拒绝|不是|并非|不|别|勿|甭)"
    r"(?:再|去|先|就|才|主动|自动|定时|定期|自己|自行)?"
    r"[^。；;\n]{0,8}$")


def split_clauses(text):
    """把规约正文切成分句：句号、分号、换行、逗号、顿号都算边界。

    判定必须落在分句上：例外得与动作写在同一句里，否则「不要读收件箱」
    会被前半句的「不要」蒙混过关。
    """
    for segment in re.split(r"[。；;\n]", text or ""):
        for clause in re.split(r"[，,、]", segment):
            clause = clause.strip()
            if clause:
                yield clause


def clause_action_negated(clause, start):
    """动作前有没有绑定到它的否定词。"""
    return bool(RE_NEG_BIND.search(clause[:start]))


