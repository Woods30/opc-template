#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""tools/opc-smoke —— 主流程冒烟检查。

验的是**工具链**通不通，不是这家公司的业务配得对不对。所以它不读实例的
knowledge/：自己在临时目录里造一份最小实例（一个假频道、一个假指标、
一份空名册），把本实例的 tools/opc-workflow 拷进去，走一遍完整闭环：

    create-content → drafting → reviewing → approved → ready
    → create-publication → reviewing → approved → scheduled → published
    → record-metrics → reviewed → closed → build

跑完检查落盘结果（内容卡、publication、指标窗口、看板 JSON），再删掉临时目录。

因此「有些目录可能不存在」不影响冒烟：fixture 自带目录，实例少什么都能跑。
反过来，实例的工具坏了、workflow 改坏了，这里就会红。

三处要点：

1. **每一步有自己的环境**：工作流按「actor 与当前角色 OPC_ROLE 一致」做误用
   检查，冒烟用多个 actor 连调，所以每一步都把继承来的 OPC_ROLE 换成这一步
   自己的 actor；不带 actor 的步骤（如 build）则完全不设这个变量。直接把
   OPC_ROLE 删掉也能跑通，但等于把这条防线绕过去了——冒烟就不再验证它。
2. **实例根向上找**：脚本装在 <实例>/tools/ 下、放在提案目录里评审，都能定位
   到同一个实例；也可用 --instance-root 显式指定。
3. **--keep 真的保留**：保留临时目录并打印路径，便于排查。

用法：
    tools/opc-smoke                    # 跑一遍，退出码 0 表示通过
    tools/opc-smoke --keep             # 保留临时目录，便于排查
    tools/opc-smoke --json             # 输出机器可读的结果
    tools/opc-smoke --instance-root .  # 显式指定实例根
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


CHANNEL = "smoke"
METRIC_KEY = "smoke_read"
DRAFT_TEXT = "# 主稿\n\n冒烟正文。\n"
PUBLICATION_DRAFT_TEXT = "# 渠道稿\n\n冒烟渠道稿。\n"
PLANNED_AT = "2026-11-20T09:00:00+08:00"
ACTUAL_AT = "2026-11-20T09:05:00+08:00"
OBSERVED_AT = "2026-11-22T09:00:00+08:00"


class SmokeError(Exception):
    """冒烟失败：带一句人能看懂的原因。"""


def find_instance_root(start: Path | None = None) -> Path:
    """实例根 = 脚本所在位置的祖先目录，按可信度从高到低认：

    1. 同时含实例标记与工作流工具的目录 —— 真实例；
    2. 只含实例标记的目录 —— 实例在但工作流没了，返回它，好让后面报
       「缺少 tools/opc-workflow」，而不是一句含混的「找不到实例根」；
    3. 只含工作流工具的目录 —— 工具在但实例标记没了。

    从脚本所在目录向上找，所以脚本装在 <实例>/tools/ 下、或者放在提案目录里
    评审，都能定位到同一个实例。
    """
    current = (start or Path(__file__).resolve().parent).resolve()
    candidates = [current, *current.parents]
    for candidate in candidates:
        if ((candidate / ".opc" / "instance.json").is_file()
                and (candidate / "tools" / "opc-workflow").is_file()):
            return candidate
    for candidate in candidates:
        if (candidate / ".opc" / "instance.json").is_file():
            return candidate
    for candidate in candidates:
        if (candidate / "tools" / "opc-workflow").is_file():
            return candidate
    raise SmokeError(
        "找不到实例根（需要 .opc/instance.json 与 tools/opc-workflow）：从 {} 向上没找到".format(current))


def write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def build_fixture(root: Path) -> Path:
    """造一份最小实例：够跑主流程，不多一样。"""
    write(root / ".opc" / "instance.json", json.dumps(
        {"kind": "opc-instance", "version": 1}, ensure_ascii=False))
    write(root / "roles.json", json.dumps(
        {"roles": [
            {"name": "gm", "enabled": True},
            {"name": "content", "enabled": True},
            {"name": "growth", "enabled": True},
        ]}, ensure_ascii=False, indent=2))
    write(root / "channels.json", json.dumps(
        {"channels": [{"id": CHANNEL, "name": "冒烟频道", "enabled": True}]},
        ensure_ascii=False, indent=2))
    write(root / "knowledge" / "business" / "growth" / "指标.md",
          "---\n"
          + json.dumps({
              "schema_version": 1,
              "record_type": "metric_catalog",
              "metrics": [{
                  "key": METRIC_KEY,
                  "label": "冒烟阅读数",
                  "unit": "count",
                  "aggregation": "sum",
                  "scope": "publication",
                  "channels": [CHANNEL],
              }],
          }, ensure_ascii=False, indent=2)
          + "\n---\n\n# 指标目录\n")
    write(root / "knowledge" / "team.md",
          "# 团队名册\n\n| 角色 | 终端名 |\n|---|---|\n| gm | smoke-gm |\n")
    write(root / "knowledge" / "inbox" / "gm.md", "")
    for name in ("content", "decisions"):
        (root / "knowledge" / name).mkdir(parents=True, exist_ok=True)
    return root


def install_workflow(root: Path, source: Path) -> Path:
    """把本实例的 workflow 拷进临时实例。

    workflow 的根目录由脚本位置决定，所以必须拷进去，指向才是临时实例。
    """
    target = root / "tools" / "opc-workflow"
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, target)
    target.chmod(0o755)
    return target


class Runner:
    """按步骤调 workflow，每一步都有自己干净的环境。"""

    def __init__(self, workflow: Path, root: Path, base_env=None):
        self.workflow = workflow
        self.root = root
        self.base_env = dict(os.environ if base_env is None else base_env)
        self.steps = []

    @staticmethod
    def actor_of(args) -> str | None:
        """从命令参数里取 --actor 的值。"""
        for index, value in enumerate(args):
            if value == "--actor" and index + 1 < len(args):
                return args[index + 1]
        return None

    def step_env(self, args) -> dict:
        """这一步要传给子进程的环境。

        OPC_ROLE 是唯一要管的变量：opc-workflow 用它做「actor 与当前角色是否
        一致」的误用检查。冒烟用多个 actor 连调，所以每一步都要把父进程继承来的
        OPC_ROLE 换成这一步自己的 actor；不带 actor 的步骤则完全不设这个变量。
        """
        env = dict(self.base_env)
        env.pop("OPC_ROLE", None)
        actor = self.actor_of(args)
        if actor:
            env["OPC_ROLE"] = actor
        return env

    def run(self, *args):
        result = subprocess.run(
            [sys.executable, str(self.workflow), *args],
            cwd=str(self.root),
            env=self.step_env(args),
            capture_output=True,
            text=True,
        )
        self.steps.append({"args": list(args), "code": result.returncode})
        if result.returncode != 0:
            raise SmokeError("`{}` 失败：{}".format(
                " ".join(args),
                (result.stderr or result.stdout or "").strip()[:300]))
        return result.stdout.strip()


def only_child(path: Path, suffix: str) -> Path:
    """目录里应该只有一个匹配项——冒烟只造一份，多了就说明 id 规则变了。"""
    found = sorted(path.glob("*/" + suffix))
    if len(found) != 1:
        raise SmokeError("{} 下应当恰好有一个 {}，实际有 {} 个".format(
            path, suffix, len(found)))
    return found[0]


def parse_frontmatter(path: Path) -> dict:
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0] != "---":
        raise SmokeError("记录缺少 frontmatter：{}".format(path))
    end = lines.index("---", 1)
    return json.loads("\n".join(lines[1:end]))


def check_dashboard(root: Path) -> dict:
    path = root / "knowledge" / "business" / "dashboard.json"
    if not path.is_file():
        raise SmokeError("build 没有生成看板 JSON：{}".format(path))
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise SmokeError("看板 JSON 读不了：{}".format(error))
    for key in ("contract_version", "counts", "contents", "publications", "team"):
        if key not in payload:
            raise SmokeError("看板 JSON 缺字段：{}".format(key))
    if payload.get("generated") is not True:
        raise SmokeError("看板 JSON 没有标记 generated")
    errors = payload.get("diagnostics", {}).get("errors", [])
    if errors:
        raise SmokeError("看板诊断有错误：{}".format(
            "；".join("{}：{}".format(e.get("source"), e.get("message")) for e in errors)))
    return payload


def run_smoke(root: Path, keep: bool = False) -> dict:
    workflow_source = root / "tools" / "opc-workflow"
    if not workflow_source.is_file():
        raise SmokeError("实例里缺少 tools/opc-workflow：{}".format(workflow_source))

    temp = Path(tempfile.mkdtemp(prefix="opc-smoke-"))
    try:
        instance = build_fixture(temp)
        workflow = install_workflow(instance, workflow_source)
        runner = Runner(workflow, instance)

        runner.run("create-content", "--title", "冒烟选题", "--actor", "content")
        content_id = only_child(instance / "knowledge" / "content", "内容卡.md").parent.name

        runner.run("transition", content_id, "--to", "drafting", "--actor", "content")
        write(instance / "knowledge" / "content" / content_id / "主稿.md", DRAFT_TEXT)
        runner.run("transition", content_id, "--to", "reviewing", "--actor", "content")
        runner.run("transition", content_id, "--decision", "approved", "--actor", "gm")

        runner.run("create-publication", content_id, "--channel", CHANNEL,
                   "--actor", "gm", "--required-window", "48h")
        publications = instance / "knowledge" / "content" / content_id / "publications"
        publication_id = only_child(publications, "渠道稿.md").parent.name

        write(instance / "knowledge" / "content" / content_id / "publications"
              / publication_id / "渠道稿.md", PUBLICATION_DRAFT_TEXT)
        runner.run("transition", publication_id, "--to", "reviewing", "--actor", "content")
        runner.run("transition", publication_id, "--decision", "approved", "--actor", "gm")
        runner.run("transition", publication_id, "--to", "scheduled",
                   "--planned-at", PLANNED_AT, "--timezone", "Asia/Shanghai", "--actor", "gm")
        runner.run("transition", publication_id, "--to", "published",
                   "--actual-at", ACTUAL_AT, "--url", "https://example.com/smoke", "--actor", "gm")
        runner.run("record-metrics", publication_id, "--window", "48h",
                   "--observed-at", OBSERVED_AT, "--source", "opc-smoke",
                   "--values", json.dumps({METRIC_KEY: 1}), "--actor", "growth")
        runner.run("transition", publication_id, "--to", "reviewed",
                   "--conclusion", "continue", "--next-action", "冒烟结束", "--actor", "growth")
        runner.run("transition", content_id, "--to", "closed", "--actor", "gm")

        runner.run("build")

        content_record = parse_frontmatter(
            instance / "knowledge" / "content" / content_id / "内容卡.md")
        if content_record.get("status") != "closed":
            raise SmokeError("内容卡状态应为 closed，实际 {}".format(
                content_record.get("status")))
        publication_record = parse_frontmatter(
            instance / "knowledge" / "content" / content_id / "publications"
            / publication_id / "发布卡.md")
        if publication_record.get("status") != "reviewed":
            raise SmokeError("publication 状态应为 reviewed，实际 {}".format(
                publication_record.get("status")))

        metrics_path = (instance / "knowledge" / "content" / content_id / "publications"
                        / publication_id / "指标.md")
        if not metrics_path.is_file():
            raise SmokeError("指标窗口没有落盘：{}".format(metrics_path))
        windows = [snapshot.get("window")
                   for snapshot in parse_frontmatter(metrics_path).get("snapshots", [])]
        if "48h" not in windows:
            raise SmokeError("指标窗口没有落盘：{}".format(windows))

        calendar = instance / "knowledge" / "business" / "选题日历.md"
        if not calendar.is_file():
            raise SmokeError("build 没有生成选题日历：{}".format(calendar))

        payload = check_dashboard(instance)
        result = {
            "ok": True,
            "steps": len(runner.steps),
            "content_id": content_id,
            "publication_id": publication_id,
            "counts": payload.get("counts", {}),
        }
        if keep:
            result["kept_dir"] = str(temp)
        return result
    finally:
        if not keep:
            shutil.rmtree(temp, ignore_errors=True)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description="OPC 主流程冒烟检查")
    parser.add_argument("--keep", action="store_true", help="保留临时目录，便于排查")
    parser.add_argument("--json", action="store_true", help="输出机器可读的结果")
    parser.add_argument("--instance-root", help="显式指定实例根（默认向上自动找）")
    args = parser.parse_args(argv)

    try:
        root = (Path(args.instance_root).resolve() if args.instance_root
                else find_instance_root())
        result = run_smoke(root, keep=args.keep)
    except SmokeError as error:
        if args.json:
            print(json.dumps({"ok": False, "error": str(error)}, ensure_ascii=False))
        else:
            print("冒烟失败：{}".format(error), file=sys.stderr)
        return 1
    except Exception as error:  # 工具坏了也要说人话，不要甩 traceback
        detail = "{}：{}".format(type(error).__name__, error)
        if args.json:
            print(json.dumps({"ok": False, "error": detail}, ensure_ascii=False))
        else:
            print("冒烟失败：{}".format(detail), file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print("主流程冒烟通过：{} 步（内容 {}，publication {}）".format(
            result["steps"], result["content_id"], result["publication_id"]))
        if result.get("kept_dir"):
            print("保留临时目录：{}".format(result["kept_dir"]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
