{
  "version": 1,
  "name": "opc-template",
  "templateMarker": ".opc-template-repo",
  "modes": {
    "managed": "模版托管的机制与规约：实例没改过就覆盖；实例改过而模版也改了，走三路合并，冲突则不动业务文件",
    "merge": "结构化配置：按 key 并集，只增不改。模版新增的条目并入实例并默认停用，实例已有的条目一个字段都不动",
    "seed": "骨架或说明文档：实例缺失时物化一次，之后归实例所有；模版侧的改进通过 seeds 的 diff 提示，不自动覆盖",
    "seeds": "模版种子源：实例持有快照（覆盖式拷贝），快照同时是业务文件的合并基线",
    "local": "实例自有：永不同步、永不触碰",
    "template-only": "只在模版仓库存在，不进实例"
  },
  "rules": [
    {
      "match": "scripts/",
      "mode": "managed"
    },
    {
      "match": "tools/",
      "mode": "managed"
    },
    {
      "match": "agents/",
      "mode": "managed"
    },
    {
      "match": "layouts/",
      "mode": "managed"
    },
    {
      "match": ".claude/",
      "mode": "managed"
    },
    {
      "match": "AGENTS.md",
      "mode": "managed"
    },
    {
      "match": "LICENSE",
      "mode": "managed"
    },
    {
      "match": "seeds/",
      "mode": "seeds"
    },
    {
      "match": "roles.json",
      "mode": "merge"
    },
    {
      "match": "channels.json",
      "mode": "merge"
    },
    {
      "match": "CLAUDE.md",
      "mode": "seed"
    },
    {
      "match": "README.md",
      "mode": "seed"
    },
    {
      "match": "LESSONS.md",
      "mode": "seed"
    },
    {
      "match": ".gitignore",
      "mode": "seed"
    },
    {
      "match": "INSTANCE.md",
      "mode": "seed",
      "optional": true
    },
    {
      "match": "knowledge/",
      "mode": "local"
    },
    {
      "match": "template.lock.json",
      "mode": "local",
      "optional": true
    },
    {
      "match": "docs/",
      "mode": "template-only"
    },
    {
      "match": ".github/",
      "mode": "template-only"
    },
    {
      "match": ".opc-template-repo",
      "mode": "template-only"
    },
    {
      "match": "sync-policy.json",
      "mode": "template-only"
    }
  ],
  "seeds": [
    {
      "source": "seeds/README.md",
      "target": "README.md"
    },
    {
      "source": "seeds/INSTANCE.md",
      "target": "INSTANCE.md"
    },
    {
      "source": "seeds/knowledge/business/品牌口径.md",
      "target": "knowledge/business/品牌口径.md"
    },
    {
      "source": "seeds/knowledge/business/选题日历.md",
      "target": "knowledge/business/选题日历.md"
    },
    {
      "source": "seeds/knowledge/business/growth/指标.md",
      "target": "knowledge/business/growth/指标.md"
    },
    {
      "source": "seeds/knowledge/business/growth/渠道计划.md",
      "target": "knowledge/business/growth/渠道计划.md"
    },
    {
      "source": "seeds/knowledge/business/growth/转化路径.md",
      "target": "knowledge/business/growth/转化路径.md"
    },
    {
      "source": "seeds/knowledge/business/product/README.md",
      "target": "knowledge/business/product/README.md"
    },
    {
      "source": "seeds/knowledge/business/product/已知问题.md",
      "target": "knowledge/business/product/已知问题.md"
    }
  ],
  "mergeConfigs": [
    {
      "target": "roles.json",
      "source": "roles.json",
      "arrayPath": "roles",
      "key": "name",
      "onNew": "append-disabled"
    },
    {
      "target": "channels.json",
      "source": "channels.json",
      "arrayPath": "channels",
      "key": "id",
      "onNew": "append-disabled"
    }
  ],
  "seedRules": {
    "seeds/README.md": {
      "requirePlaceholder": true,
      "forbid": [
        "http://",
        "https://"
      ]
    },
    "seeds/INSTANCE.md": {
      "requirePlaceholder": true,
      "forbid": [
        "http://",
        "https://"
      ]
    },
    "seeds/knowledge/business/品牌口径.md": {
      "requirePlaceholder": true,
      "forbid": [
        "http://",
        "https://"
      ]
    },
    "seeds/knowledge/business/选题日历.md": {
      "requirePlaceholder": true,
      "forbid": [
        "http://",
        "https://"
      ]
    },
    "seeds/knowledge/business/growth/指标.md": {
      "requirePlaceholder": true,
      "forbid": [
        "http://",
        "https://"
      ]
    },
    "seeds/knowledge/business/growth/渠道计划.md": {
      "requirePlaceholder": true,
      "forbid": [
        "http://",
        "https://"
      ]
    },
    "seeds/knowledge/business/growth/转化路径.md": {
      "requirePlaceholder": true,
      "forbid": [
        "http://",
        "https://"
      ]
    },
    "seeds/knowledge/business/product/README.md": {
      "requirePlaceholder": false,
      "forbid": [
        "http://",
        "https://"
      ]
    },
    "seeds/knowledge/business/product/已知问题.md": {
      "requirePlaceholder": false,
      "forbid": [
        "http://",
        "https://"
      ]
    }
  },
  "proposalDir": "knowledge/work/*/template-proposals",
  "proposalSections": [
    "现象",
    "泛化需求",
    "期望模版改动",
    "影响文件",
    "脱敏自检"
  ]
}
