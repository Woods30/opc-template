def parse_timestamp(value):
    """把记录里的时间字段解析成可比较的 aware datetime；解析不了返回 None。"""
    if not isinstance(value, str):
        return None
    text = value.strip()
    if not text:
        return None
    parsed = None
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        for pattern in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d"):
            try:
                parsed = datetime.strptime(text, pattern)
                break
            except ValueError:
                parsed = None
    if parsed is None:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed


def strip_code(text: str):
    return text.strip().strip("`").strip()


def split_task_fields(text: str):
    """把「发起方：gm | 任务：xxx」拆成字段字典。"""
    fields = {}
    for chunk in text.split("|"):
        for separator in ("：", ":"):
            if separator in chunk:
                key, _, value = chunk.partition(separator)
                fields[key.strip()] = value.strip()
                break
    return fields


def parse_inbox_entry(line: str, role: str, source: str):
    """解析一行派工条目；不是派工条目时返回 None。"""
    stripped = line.strip()
    if not stripped.startswith("- "):
        return None
    body = stripped[2:].strip()
    state = "open"
    if body.startswith("✅"):
        state = "done"
        body = body[1:].strip()
    elif body.startswith("⛔"):
        state = "cancelled"
        body = body[1:].strip()
    start = body.find("[")
    end = body.find("]", start + 1) if start >= 0 else -1
    if start < 0 or end < 0:
        return None
    prefix = body[:start].strip()
    requested_at = body[start + 1:end].strip()
    fields = split_task_fields(body[end + 1:])
    task = fields.get("任务")
    if not task:
        return None
    reason = None
    if state == "cancelled":
        reason = prefix
        if reason.startswith("已撤销"):
            reason = reason[len("已撤销") :].strip()
            reason = reason.lstrip("：:").strip()
        reason = reason.rstrip("-—:： ").strip() or None
    digest = hashlib.sha256(
        "|".join([role, requested_at, task]).encode("utf-8")
    ).hexdigest()
    # 条目可以显式写「任务 ID」：同一任务改措辞或补验收时 ID 不会漂移。
    # 没写时按角色 + 时间 + 任务文本派生，保持旧条目的稳定标识。
    explicit = strip_code(fields.get("任务 ID", ""))
    if re.fullmatch(r"task-[0-9a-z][0-9a-z-]{3,39}", explicit):
        task_id = explicit
    else:
        task_id = f"task-{digest[:12]}"
    reference = strip_code(fields.get("业务引用", "")) or None
    return {
        "task_id": task_id,
        "role": role,
        "requester": fields.get("发起方"),
        "requested_at": requested_at,
        "task": task,
        "acceptance": fields.get("验收"),
        "reference": reference,
        "state": state,
        "reason": reason,
        "source_path": source,
    }


def task_sort_key(task: dict):
    parsed = parse_timestamp(task.get("requested_at"))
    return (
        TASK_STATE_ORDER.get(task.get("state"), len(TASK_STATE_ORDER)),
        0 if parsed is None else 1,
        parsed or datetime.min.replace(tzinfo=timezone.utc),
        task.get("task_id") or "",
    )


def scan_inbox_tasks(root: Path):
    """读 inbox 队列：只有未标记的条目是待办，其余是历史。"""
    inbox = root / INBOX_DIR
    tasks = []
    if inbox.is_symlink() or not inbox.is_dir():
        return tasks
    for path in sorted(inbox.glob("*.md")):
        if path.is_symlink() or not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            continue
        source = path.relative_to(root).as_posix()
        in_fence = False
        for line in text.splitlines():
            if line.strip().startswith("```"):
                in_fence = not in_fence
                continue
            # 收件箱头部有格式示例；围栏代码块里的是说明，不是派工条目。
            if in_fence:
                continue
            entry = parse_inbox_entry(line, path.stem, source)
            if entry is not None:
                tasks.append(entry)
    return sorted(tasks, key=task_sort_key)


def scan_team(root: Path):
    """读名册的第一张表：角色与终端名。"""
    path = root / KNOWLEDGE_DIR / TEAM_NAME
    if path.is_symlink() or not path.is_file():
        return []
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return []
    rows = []
    header = None
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped.startswith("|"):
            if header is not None:
                break
            continue
        cells = [cell.strip() for cell in stripped.strip("|").split("|")]
        if header is None:
            header = cells
            continue
        if all(cell and set(cell) <= set("-: ") for cell in cells):
            continue
        if len(cells) < 2:
            continue
        role = strip_code(cells[0])
        terminal = strip_code(cells[1])
        if not role or not terminal:
            continue
        rows.append({"role": role, "terminal": terminal})
    return rows


def record_block_state(data: dict):
    """内容与 publication 的阻塞状态：布尔或带原因的块。"""
    block = data.get("block")
    if isinstance(block, dict):
        return True, block.get("reason")
    if isinstance(block, bool):
        return block, data.get("block_reason")
    blocked = data.get("blocked")
    if isinstance(blocked, bool):
        return blocked, data.get("block_reason")
    return False, None


def publication_metric_state(data: dict, catalog: dict, windows: list):
    """指标三态：not_applicable / missing / partial / recorded。"""
    channel = data.get("channel")
    definitions = [
        definition
        for definition in catalog.values()
        if definition.get("scope") == "publication"
        and channel in definition.get("channels", ())
    ]
    if not definitions:
        return "not_applicable", False
    if not windows:
        return "missing", True
    values = windows[-1].get("values")
    if not isinstance(values, dict):
        return "missing", True
    missing = [
        definition["key"]
        for definition in sorted(definitions, key=lambda item: item.get("key", ""))
        if definition["key"] not in values
    ]
    if missing:
        return "partial", True
    return "recorded", False


def window_sort_key(window: dict):
    parsed = parse_timestamp(window.get("observed_at"))
    return (
        0 if parsed is None else 1,
        parsed or datetime.min.replace(tzinfo=timezone.utc),
        window.get("window") or "",
    )


def snapshot_sort_key(observation: dict):
    parsed = parse_timestamp(observation.get("observed_at"))
    return (
        0 if parsed is None else 1,
        parsed or datetime.min.replace(tzinfo=timezone.utc),
        observation.get("recorded_at") or "",
    )


def publication_in_scope(entry: dict, as_of):
    """默认视图范围：未完成指标/复盘、待审批、近期发布与近期计划。"""
    if entry.get("needs_metrics") or entry.get("needs_review"):
        return True
    if entry.get("approval_status") == "pending":
        return True
    status = entry.get("status")
    if status in ("published", "reviewed"):
        published_at = parse_timestamp(entry.get("published_at"))
        if published_at is None or as_of is None:
            return False
        return published_at >= as_of - timedelta(days=7)
    if status == "scheduled":
        planned_at = parse_timestamp(entry.get("planned_at"))
        if planned_at is None or as_of is None:
            return True
        return planned_at <= as_of + timedelta(days=30)
    return False


def metric_summary_text(record: dict, catalog: dict, windows: list):
    """看板用的指标摘要：窗口与数值，缺失与不可得分开说。"""
    definitions = sorted(
        (
            definition
            for definition in catalog.values()
            if definition.get("scope") == "publication"
            and record.get("channel") in definition.get("channels", ())
        ),
        key=lambda definition: definition.get("key", ""),
    )
    if not definitions or not windows:
        return ""
    parts = []
    for window in windows:
        values = window.get("values")
        if not isinstance(values, dict):
            values = {}
        cells = []
        for definition in definitions:
            key = definition["key"]
            if key not in values:
                cells.append(f"{key}=缺失")
                continue
            value = values[key]
            if isinstance(value, dict) and value.get("available") is False:
                cells.append(f"{key}=不可得")
            else:
                cells.append(f"{key}={value}")
        parts.append(f"{window.get('window')}：" + "、".join(cells))
    return "；".join(parts)


def dashboard_as_of(contents: list, publications: list, tasks: list, growth: GrowthScan):
    """数据截止时间取所有记录时间的最大值，保证同一份数据算出同一个值。"""
    candidates = []
    for entry in contents:
        candidates.append(entry.get("created_at"))
    for entry in publications:
        candidates.extend(
            [entry.get("created_at"), entry.get("planned_at"), entry.get("published_at")]
        )
    for task in tasks:
        candidates.append(task.get("requested_at"))
    for windows in growth.publication_metrics.values():
        for window in windows:
            candidates.append(window.get("observed_at"))
    for observation in growth.channel_snapshots:
        candidates.append(observation.get("observed_at"))
    parsed = [value for value in (parse_timestamp(item) for item in candidates) if value]
    if not parsed:
        return None
    return max(parsed).isoformat()


def build_dashboard_payload(
    root: Path,
    records: list,
    publications: list,
    growth: GrowthScan,
    errors: list,
    warnings: list,
):
    """只读看板的 JSON 契约：只带元数据，不带正文与哈希。"""
    publications_by_content = {}
    for publication in publications:
        content_id = publication.data.get("content_id")
        publications_by_content.setdefault(content_id, []).append(publication)

    contents = []
    approvals = []
    for item in sorted(records, key=record_sort_key):
        data = item.data
        content_id = data.get("content_id")
        blocked, block_reason = record_block_state(data)
        approval = data.get("approval")
        if not isinstance(approval, dict):
            approval = {}
        related = sorted(
            publications_by_content.get(content_id, []), key=publication_sort_key
        )
        contents.append(
            {
                "content_id": content_id,
                "title": data.get("title"),
                "status": data.get("status"),
                "role": data.get("actor"),
                "priority": data.get("priority"),
                "blocked": blocked,
                "block_reason": block_reason,
                "target_date": data.get("target_date"),
                "created_at": data.get("created_at"),
                "approval_status": approval.get("status"),
                "publication_ids": [
                    publication.data.get("publication_id") for publication in related
                ],
                "source_path": item.source,
                "draft_path": (
                    f"{CONTENT_DIR.as_posix()}/{content_id}/{MAIN_DRAFT_NAME}"
                ),
            }
        )
        if approval.get("status") == "pending":
            approvals.append(
                {
                    "entity": "content",
                    "id": content_id,
                    "artifact": MAIN_DRAFT_NAME,
                    "requested_at": approval.get("requested_at"),
                    "requested_by": approval.get("requested_by"),
                    "source_path": item.source,
                }
            )

    publication_entries = []
    for item in sorted(publications, key=publication_sort_key):
        data = item.data
        publication_id = data.get("publication_id")
        content_id = data.get("content_id")
        schedule = data.get("schedule")
        if not isinstance(schedule, dict):
            schedule = {}
        approval = data.get("approval")
        if not isinstance(approval, dict):
            approval = {}
        fact = data.get("publication")
        if not isinstance(fact, dict):
            fact = {}
        blocked, block_reason = record_block_state(data)
        windows = sorted(
            growth.publication_metrics.get(publication_id, []), key=window_sort_key
        )
        metric_state, needs_metrics = publication_metric_state(
            data, growth.catalog, windows
        )
        review = data.get("review")
        if not isinstance(review, dict):
            review = {}
        needs_review = data.get("status") in ("published", "reviewed") and review.get(
            "status"
        ) not in ("done", "recorded")
        publication_entries.append(
            {
                "publication_id": publication_id,
                "content_id": content_id,
                "channel": data.get("channel"),
                "status": data.get("status"),
                "role": data.get("actor"),
                "priority": data.get("priority"),
                "blocked": blocked,
                "block_reason": block_reason,
                "created_at": data.get("created_at"),
                "planned_at": schedule.get("planned_at"),
                "timezone": schedule.get("timezone"),
                "published_at": fact.get("published_at"),
                "url": fact.get("url"),
                "external_id": fact.get("external_id"),
                "approval_status": approval.get("status"),
                "metrics": {
                    "state": metric_state,
                    "summary": metric_summary_text(data, growth.catalog, windows),
                    "windows": [
                        {
                            "window": window.get("window"),
                            "observed_at": window.get("observed_at"),
                            "source": window.get("source"),
                            "values": window.get("values"),
                        }
                        for window in windows
                    ],
                },
                "needs_metrics": needs_metrics,
                "needs_review": needs_review,
                "review": {
                    "status": review.get("status"),
                    "conclusion": review.get("conclusion"),
                    "recorded_at": review.get("recorded_at"),
                },
                "source_path": item.source,
                "draft_path": (
                    f"{CONTENT_DIR.as_posix()}/{content_id}/"
                    f"{PUBLICATIONS_DIR_NAME}/{publication_id}/{CHANNEL_DRAFT_NAME}"
                ),
                "metrics_path": (
                    f"{CONTENT_DIR.as_posix()}/{content_id}/"
                    f"{PUBLICATIONS_DIR_NAME}/{publication_id}/{PUBLICATION_METRICS_NAME}"
                ),
            }
        )
        if approval.get("status") == "pending":
            approvals.append(
                {
                    "entity": "publication",
                    "id": publication_id,
                    "artifact": CHANNEL_DRAFT_NAME,
                    "requested_at": approval.get("requested_at"),
                    "requested_by": approval.get("requested_by"),
                    "source_path": item.source,
                }
            )

    channel_entries = []
    for channel_id, detail in sorted(configured_channel_details(root).items()):
        if not detail["enabled"]:
            continue
        observations = sorted(
            (
                observation
                for observation in growth.channel_snapshots
                if isinstance(observation, dict)
                and observation.get("channel") == channel_id
            ),
            key=snapshot_sort_key,
        )
        account_metrics = {}
        if observations:
            values = observations[-1].get("values")
            if isinstance(values, dict):
                account_metrics = values
        channel_entries.append(
            {
                "channel": channel_id,
                "name": detail["name"],
                "publication_count": sum(
                    1
                    for entry in publication_entries
                    if entry.get("channel") == channel_id
                ),
                "account_metrics": account_metrics,
            }
        )

    tasks = scan_inbox_tasks(root)
    as_of_text = dashboard_as_of(contents, publication_entries, tasks, growth)
    as_of = parse_timestamp(as_of_text)
    return {
        "contract_version": DASHBOARD_CONTRACT_VERSION,
        "generated": True,
        "read_only": True,
        "as_of": as_of_text,
        "counts": {
            "contents": len(contents),
            "publications": len(publication_entries),
            "tasks": len(tasks),
            "approvals": len(approvals),
            "channels": len(channel_entries),
        },
        "contents": contents,
        "publications": publication_entries,
        "tasks": tasks,
        "approvals": approvals,
        "channels": channel_entries,
        "team": scan_team(root),
        "diagnostics": {
            "errors": [
                {"source": error.source, "message": error.message} for error in errors
            ],
            "warnings": [
                {"source": warning.source, "message": warning.message}
                for warning in warnings
            ],
        },
        "scope": {
            "content_ids": [
                entry["content_id"]
                for entry in contents
                if entry.get("status") not in ("closed", "cancelled")
                or entry.get("blocked")
            ],
            "publication_ids": [
                entry["publication_id"]
                for entry in publication_entries
                if publication_in_scope(entry, as_of)
            ],
            "task_ids": [
                task["task_id"] for task in tasks if task.get("state") == "open"
            ],
            "approval_ids": [approval["id"] for approval in approvals],
        },
    }


def render_dashboard_cache(
    root: Path,
    records: list,
    publications: list,
    growth: GrowthScan,
    errors: list,
    warnings: list,
):
    """渲染看板契约的 JSON 文本；只带元数据，不带正文与哈希。"""
    payload = build_dashboard_payload(
        root, records, publications, growth, errors, warnings
    )
    return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n"


# ---------- CLI ----------


def build_parser():
    parser = argparse.ArgumentParser(description="创建、校验并构建 OPC canonical 内容记录")
    subparsers = parser.add_subparsers(dest="command", required=True)

    create = subparsers.add_parser("create-content", help="创建 proposed 内容卡")
    create.add_argument("--title", required=True, help="选题标题")
    create.add_argument("--source", help="信息来源")
    create.add_argument("--summary", help="内容摘要")
    create.add_argument("--target-date", help="目标日期（YYYY-MM-DD）")
    create.add_argument("--actor", help="roles.json 中的 role key；默认取 OPC_ROLE 或 content")

    create_publication_parser = subparsers.add_parser(
        "create-publication",
        help="为 ready 内容创建渠道 publication",
    )
    create_publication_parser.add_argument("content_id", help="ready 内容的稳定 content_id")
    create_publication_parser.add_argument(
        "--channel",
        required=True,
        help="channels.json 中已启用的 channel key",
    )
    create_publication_parser.add_argument(
        "--actor",
        help="roles.json 中的 role key；创建 publication 必须记为 gm",
    )
    create_publication_parser.add_argument(
        "--required-window",
        action="append",
        default=[],
        help="复盘前必须存在的指标窗口，可重复，例如 48h、7d",
    )
    create_publication_parser.add_argument(
        "--optional",
        action="store_true",
        help="标记为可选 publication，不阻止内容关闭",
    )

    transition = subparsers.add_parser("transition", help="转换内容状态或记录审批决定")
    transition.add_argument("content_id", help="稳定 content_id")
    operation = transition.add_mutually_exclusive_group(required=True)
    operation.add_argument(
        "--to",
        choices=(
            "drafting",
            "reviewing",
            "ready",
            "scheduled",
            "published",
            "reviewed",
            "closed",
            "cancelled",
        ),
    )
    operation.add_argument("--decision", choices=APPROVAL_DECISIONS)
    transition.add_argument("--actor", help="roles.json 中的 role key；默认取 OPC_ROLE 或 content")
    transition.add_argument("--note", help="业务说明；退回、改期或取消时必填")
    transition.add_argument("--planned-at", help="offset-aware ISO 8601 计划发布时间")
    transition.add_argument("--timezone", help="IANA timezone，例如 Asia/Shanghai")
    transition.add_argument("--actual-at", help="offset-aware ISO 8601 实际发布时间")
    transition.add_argument("--url", help="实际发布 URL（HTTP/HTTPS）")
    transition.add_argument("--external-id", help="外部平台的可选发布标识")
    transition.add_argument(
        "--conclusion",
        choices=REVIEW_CONCLUSIONS,
        help="publication 复盘结论",
    )
    transition.add_argument("--next-action", help="publication 复盘的下一项行动")
    transition.add_argument(
        "--exception-reason",
        help="必需指标窗口不可得时由 gm 记录的例外原因",
    )

    record_metrics_parser = subparsers.add_parser(
        "record-metrics",
        help="为已发布 publication 追加指标窗口",
    )
    record_metrics_parser.add_argument("publication_id", help="稳定 publication_id")
    record_metrics_parser.add_argument("--window", required=True, help="指标窗口，例如 48h、7d")
    record_metrics_parser.add_argument("--observed-at", required=True, help="offset-aware ISO 8601 观测时间")
    record_metrics_parser.add_argument("--source", required=True, help="数据来源")
    record_metrics_parser.add_argument("--values", required=True, help="JSON object：metric key → 数值或不可得说明")
    record_metrics_parser.add_argument("--actor", help="记录 actor；必须是 growth")

    channel_snapshot_parser = subparsers.add_parser(
        "record-channel-snapshot",
        help="追加账号级渠道观测",
    )
    channel_snapshot_parser.add_argument("--channel", required=True, help="已启用 channel key")
    channel_snapshot_parser.add_argument("--observed-at", required=True, help="offset-aware ISO 8601 观测时间")
    channel_snapshot_parser.add_argument("--source", required=True, help="数据来源")
    channel_snapshot_parser.add_argument("--values", required=True, help="JSON object：metric key → 数值或不可得说明")
    channel_snapshot_parser.add_argument("--actor", help="记录 actor；必须是 growth")

    subparsers.add_parser("validate", help="校验 canonical 内容卡")
    subparsers.add_parser("build", help="校验并原子生成选题日历")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    root = instance_root()
    try:
        if args.command == "create-content":
            content_id, path, actor = create_content(
                root,
                args.title,
                args.source,
                args.summary,
                args.target_date,
                args.actor,
            )
            print(f"已创建 {content_id}（actor={actor}）：{path}")
            return 0
        if args.command == "create-publication":
            publication_id, path, actor = create_publication(
                root,
                args.content_id,
                args.channel,
                args.actor,
                args.required_window,
                args.optional,
            )
            print(f"已创建 {publication_id}（actor={actor}）：{path}")
            return 0
        if args.command == "transition":
            if PUBLICATION_ID_RE.fullmatch(args.content_id):
                status, actor = transition_publication(
                    root,
                    args.content_id,
                    args.to,
                    args.decision,
                    args.actor,
                    args.note,
                    args.planned_at,
                    args.timezone,
                    args.actual_at,
                    args.url,
                    args.external_id,
                    args.conclusion,
                    args.next_action,
                    args.exception_reason,
                )
            else:
                if any(
                    value is not None
                    for value in (
                        args.planned_at,
                        args.timezone,
                        args.actual_at,
                        args.url,
                        args.external_id,
                    )
                ):
                    raise WorkflowError("内容状态转换不接受 publication 时间或发布参数")
                status, actor = transition_content(
                    root,
                    args.content_id,
                    args.to,
                    args.decision,
                    args.actor,
                    args.note,
                )
            print(f"已更新 {args.content_id} → {status}（actor={actor}）")
            return 0
        if args.command == "record-metrics":
            path = record_publication_metrics(
                root,
                args.publication_id,
                args.window,
                args.observed_at,
                args.source,
                args.values,
                args.actor,
            )
            print(f"已记录指标窗口：{path}")
            return 0
        if args.command == "record-channel-snapshot":
            path = record_channel_snapshot(
                root,
                args.channel,
                args.observed_at,
                args.source,
                args.values,
                args.actor,
            )
            print(f"已记录渠道快照：{path}")
            return 0
        if args.command == "validate":
            return validate_content(root)
        if args.command == "build":
            return build_calendar(root)
    except WorkflowError as error:
        print(f"错误：{error}", file=sys.stderr)
        return 1
    except OSError as error:
        print(f"错误：写入失败：{error}", file=sys.stderr)
        return 1
    return 2


if __name__ == "__main__":
    sys.exit(main())
