def check_content_record(root, content_id):
    card = os.path.join(root, CONTENT_REL, content_id, CARD_NAME)
    source = relative(root, card)
    _real, path_error = safe_path(root, card)
    if path_error:
        return (
            None,
            Check("content-record", "内容记录有效", STATUS_FAIL, [path_error], source),
        )
    if not os.path.isfile(card):
        return (
            None,
            Check(
                "content-record",
                "内容记录有效",
                STATUS_FAIL,
                ["找不到内容卡：{}".format(source)],
                source,
            ),
        )
    record, _body, errors = wf.parse_card_document(Path(card), source)
    if errors:
        return (
            None,
            Check(
                "content-record",
                "内容记录有效",
                STATUS_FAIL,
                [error.message for error in errors],
                source,
            ),
        )
    problems = []
    if record.get("record_type") != "content":
        problems.append("record_type 必须是 content")
    if record.get("content_id") != content_id:
        problems.append(
            "内容卡 content_id「{}」与目录「{}」不一致（引用断裂）".format(
                record.get("content_id"), content_id
            )
        )
    status = record.get("status")
    if status not in wf.CONTENT_STATUSES:
        problems.append("未知 status「{}」".format(status))
    if problems:
        return None, Check("content-record", "内容记录有效", STATUS_FAIL, problems, source)
    return record, Check(
        "content-record",
        "内容记录有效",
        STATUS_OK,
        ["{} · status={}".format(content_id, status)],
        source,
    )


def check_publication_record(root, content_id, publication_id, target):
    card = os.path.join(target.publication_dir, PUBLICATION_CARD_NAME)
    source = relative(root, card)
    _real, path_error = safe_path(root, card)
    if path_error:
