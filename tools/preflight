    )


def check_approval(record, card_source, draft, artifact, allowed_statuses):
    if record is None:
        return Check(
            "approval-valid",
            "审批有效且未失效",
            STATUS_SKIP,
            ["canonical 记录不可用，跳过"],
            card_source,
        )
    approval = record.get("approval")
    if not isinstance(approval, dict):
        return Check(
            "approval-valid",
            "审批有效且未失效",
            STATUS_FAIL,
            ["{}没有审批记录：先提交审核并由 gm 落盘决定".format(artifact)],
            card_source,
        )
    status = approval.get("status")
    if status != "approved":
        return Check(
            "approval-valid",
            "审批有效且未失效",
            STATUS_FAIL,
            ["审批状态是「{}」，发布前需要 approved".format(status or "空")],
            card_source,
        )
    record_status = record.get("status")
    if record_status not in allowed_statuses:
        return Check(
            "approval-valid",
            "审批有效且未失效",
            STATUS_FAIL,
            [
                "approved approval 与当前状态「{}」不符：应为 {}".format(
                    record_status, "、".join(allowed_statuses)
                )
            ],
            card_source,
        )
    if approval.get("artifact") != artifact:
        return Check(
            "approval-valid",
            "审批有效且未失效",
            STATUS_FAIL,
            ["审批覆盖的是「{}」，不是「{}」".format(approval.get("artifact"), artifact)],
            card_source,
        )
    if not draft.exists:
        return Check(
            "approval-valid",
            "审批有效且未失效",
            STATUS_FAIL,
            ["稿件不存在，无法核对审批覆盖的 {}：{}".format(artifact, draft.path)],
            card_source,
        )
    try:
        current = wf.artifact_hash(Path(draft.path))
    except wf.WorkflowError as error:
        return Check(
            "approval-valid",
            "审批有效且未失效",
            STATUS_FAIL,
            [str(error)],
            card_source,
        )
    if approval.get("artifact_hash") != current:
        return Check(
            "approval-valid",
            "审批有效且未失效",
            STATUS_FAIL,
            [
                "审批失效：{} 在审批后已修改（SHA-256 不匹配），需重新提交并重新审批".format(
                    artifact
                )
            ],
            card_source,
        )
    return Check(
        "approval-valid",
        "审批有效且未失效",
        STATUS_OK,
        ["approved 覆盖当前 {}".format(artifact)],
        card_source,
    )


def check_channel(root, target, draft, brand_text, channel_override, publication_record):
    if target.kind == "channel":
        if publication_record is None:
            return Check(
                "channel-match",
                "稿件渠道与 canonical 记录一致",
                STATUS_SKIP,
                ["publication 记录不可用，跳过"],
                relative(root, target.publication_dir),
            )
        channel_id = publication_record.get("channel")
        candidates = channel_candidates(root, channel_id)
        canonical = configured_channel_names(root).get(channel_id) or channel_id
        source = relative(
            root, os.path.join(target.publication_dir, PUBLICATION_CARD_NAME)
        )
    else:
        canonical = brand_main_channel(brand_text)
        if not canonical:
            return Check(
                "channel-match",
                "稿件渠道与 canonical 记录一致",
                STATUS_FAIL,
                ["品牌口径没有「主渠道」，无法核对主稿渠道"],
                os.path.join(BRAND_REL, "# 渠道口径"),
            )
        candidates = {canonical}
        source = os.path.join(BRAND_REL, "# 渠道口径")

    declared = channel_override or draft.channel
    if not declared:
        return Check(
            "channel-match",
            "稿件渠道与 canonical 记录一致",
            STATUS_WARN,
            ["稿件未标注渠道（也没用 --channel），按 canonical 记录核对「{}」".format(canonical)],
            draft.path,
        )
    wanted = {normalize_channel(candidate) for candidate in candidates}
    if normalize_channel(declared) in wanted:
        return Check(
            "channel-match",
            "稿件渠道与 canonical 记录一致",
            STATUS_OK,
            ["两侧都是「{}」".format(canonical)],
            draft.path,
        )
    return Check(
        "channel-match",
        "稿件渠道与 canonical 记录一致",
        STATUS_FAIL,
        ["稿件写「{}」，canonical 记录是「{}」".format(declared, canonical)],
        draft.path,
    )


# ---------- 汇总 ----------


def run_checks(
    root,
    draft_path=None,
    channel_override=None,
    content_id=None,
    publication_id=None,
):
    brand_path = os.path.join(root, BRAND_REL)
    checks = []

    if not os.path.isfile(brand_path):
        return [
            Check(
                "source-missing",
                "源文件存在",
                STATUS_FAIL,
                ["缺少文件：{}".format(brand_path)],
                brand_path,
            )
        ]

    brand_text = read_text(brand_path)
    target = resolve_target(root, draft_path, content_id, publication_id, checks)
    if target is None:
        return checks

    draft = parse_draft(target.draft_path)

    if draft.exists:
        checks.append(Check("draft-exists", "稿件文件存在", STATUS_OK, [draft.path], draft.path))
    else:
        checks.append(
            Check(
                "draft-exists",
                "稿件文件存在",
                STATUS_FAIL,
                ["找不到文件：{}".format(draft.path)],
                draft.path,
            )
        )

    content_record, content_check = check_content_record(root, target.content_id)
    checks.append(content_check)

    publication_record = None
    if target.kind == "channel":
        publication_record, publication_check = check_publication_record(
            root, target.content_id, target.publication_id, target
        )
        checks.append(publication_check)

    if target.kind == "channel":
        checks.append(
            check_approval(
                publication_record,
                relative(
                    root,
                    os.path.join(target.publication_dir, PUBLICATION_CARD_NAME),
                ),
                draft,
                CHANNEL_DRAFT_NAME,
                ("reviewing", "scheduled"),
            )
        )
    else:
        checks.append(
            check_approval(
                content_record,
                relative(root, os.path.join(target.content_dir, CARD_NAME)),
                draft,
                MAIN_DRAFT_NAME,
                ("ready",),
            )
        )

    checks.append(
        check_channel(
            root, target, draft, brand_text, channel_override, publication_record
        )
    )

    terms, table_terms, other_terms = forbidden_terms(brand_text)

    if not draft.exists:
        for check_id, title in (
            ("forbidden-term", "未命中禁用表述"),
            ("term-misuse", "术语表「不说什么」未被误用"),
        ):
            checks.append(
                Check(check_id, title, STATUS_SKIP, ["稿件不存在，跳过"], draft.path)
            )
    else:
        hits, missed = scan_terms(draft, other_terms)
        detail = [
            "第 {} 行命中「{}」：{}".format(number, term, snippet)
            for term, number, snippet in hits
        ]
        checks.append(
            Check(
                "forbidden-term",
                "未命中禁用表述",
                STATUS_FAIL if hits else STATUS_OK,
                detail or ["未命中 {} 个禁用词：{}".format(len(missed), "、".join(missed))],
                os.path.join(BRAND_REL, "# 禁用表述 / # 作者人设"),
            )
        )

        table_hits, table_missed = scan_terms(draft, table_terms)
        detail = [
            "第 {} 行命中「{}」：{}".format(number, term, snippet)
            for term, number, snippet in table_hits
        ]
        checks.append(
            Check(
                "term-misuse",
                "术语表「不说什么」未被误用",
                STATUS_FAIL if table_hits else STATUS_OK,
                detail or ["未误用 {} 个术语：{}".format(len(table_missed), "、".join(table_missed))],
                os.path.join(BRAND_REL, "# 术语表"),
            )
        )

    pending = [
        (number, line.strip()[:50])
        for number, line in enumerate(brand_text.splitlines(), 1)
        if "【提案】" in line
    ]
    checks.append(
        Check(
            "brand-settled",
            "品牌口径已去掉【提案】标记",
            STATUS_WARN if pending else STATUS_OK,
            ["品牌口径第 {} 行仍带【提案】：{}".format(n, s) for n, s in pending]
            or ["品牌口径没有未确认标记"],
            BRAND_REL,
        )
    )

    if content_record is None:
        checks.append(
            Check(
                "content-pillar",
                "内容卡声明内容支柱",
                STATUS_SKIP,
                ["内容卡不可用，跳过"],
                relative(root, os.path.join(target.content_dir, CARD_NAME)),
            )
        )
    else:
        pillar = content_record.get("pillar")
        if isinstance(pillar, str) and pillar.strip():
            checks.append(
                Check(
                    "content-pillar",
                    "内容卡声明内容支柱",
                    STATUS_OK,
                    ["支柱：{}".format(pillar.strip())],
                    relative(root, os.path.join(target.content_dir, CARD_NAME)),
                )
            )
        else:
            checks.append(
                Check(
                    "content-pillar",
                    "内容卡声明内容支柱",
                    STATUS_WARN,
                    ["内容卡未声明 pillar，内容支柱无法机器核对"],
                    relative(root, os.path.join(target.content_dir, CARD_NAME)),
                )
            )

    if target.kind == "channel" and publication_record is not None:
        channel_id = publication_record.get("channel")
        candidates = channel_candidates(root, channel_id)
        display = configured_channel_names(root).get(channel_id) or channel_id
    elif target.kind == "main":
        display = brand_main_channel(brand_text)
        candidates = {display} if display else set()
    else:
        display = ""
        candidates = set()

    brand_channel = brand_channel_name(brand_text, candidates) or display
    checks.append(word_count_check(brand_text, draft, brand_channel, display))
    checks.append(cta_check(brand_text, draft, brand_channel, display))

    return checks


