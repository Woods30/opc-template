            None,
            Check(
                "publication-record",
                "publication 记录有效",
                STATUS_FAIL,
                [path_error],
                source,
            ),
        )
    if not os.path.isfile(card):
        return (
            None,
            Check(
                "publication-record",
                "publication 记录有效",
                STATUS_FAIL,
                ["找不到发布卡：{}".format(source)],
                source,
            ),
        )
    record, _body, errors = wf.parse_card_document(Path(card), source)
    if errors:
        return (
            None,
            Check(
                "publication-record",
                "publication 记录有效",
                STATUS_FAIL,
                [error.message for error in errors],
                source,
            ),
        )
    problems = []
    if record.get("record_type") != "publication":
        problems.append("record_type 必须是 publication")
    if record.get("publication_id") != publication_id:
        problems.append(
            "发布卡 publication_id「{}」与目录「{}」不一致（引用断裂）".format(
                record.get("publication_id"), publication_id
            )
