}


def render(checks, label):
    lines = ["preflight · 稿件 {}".format(label)]
    for check in checks:
        lines.append("[{}] {}".format(STATUS_LABEL[check.status], check.title))
        for item in check.detail:
            lines.append("       - {}".format(item))
        lines.append("       来源：{}".format(check.source))
    passed = sum(1 for c in checks if c.status == STATUS_OK)
    failed = sum(1 for c in checks if c.status == STATUS_FAIL)
    warned = sum(1 for c in checks if c.status == STATUS_WARN)
    skipped = sum(1 for c in checks if c.status == STATUS_SKIP)
    lines.append(
        "汇总：通过 {} 项 / 失败 {} 项 / 警告 {} 项 / 跳过 {} 项".format(passed, failed, warned, skipped)
    )
    return "\n".join(lines)


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="发布前自检：核对 canonical 稿件与品牌口径",
    )
    parser.add_argument("draft", nargs="?", help="稿件路径（canonical 主稿或渠道稿）")
    parser.add_argument("--content", default=None, help="按稳定 content ID 定位主稿")
    parser.add_argument("--publication", default=None, help="按稳定 publication ID 定位渠道稿")
    parser.add_argument("--root", default=DEFAULT_ROOT, help="仓库根目录，默认取脚本所在仓库")
    parser.add_argument("--channel", default=None, help="稿件渠道，稿件里没写渠道时手动指定")
    parser.add_argument("--json", action="store_true", help="输出 JSON")
    args = parser.parse_args(argv)

    selectors = [bool(args.draft), bool(args.content), bool(args.publication)]
    if sum(selectors) != 1:
        parser.error("draft、--content、--publication 必须且只能指定一个")

    root = os.path.abspath(args.root)
    draft_path = args.draft
    if draft_path is not None and not os.path.isabs(draft_path):
        draft_path = os.path.join(root, draft_path)

    if draft_path is not None and not os.path.isfile(draft_path):
        print("找不到稿件：{}".format(draft_path), file=sys.stderr)
        return 2

    checks = run_checks(
        root,
        draft_path,
        args.channel,
        content_id=args.content,
        publication_id=args.publication,
    )
    failed = any(c.status == STATUS_FAIL for c in checks)

    label = draft_path
    if label is None:
        label = "content {}".format(args.content) if args.content else "publication {}".format(args.publication)

    if args.json:
        payload = {
            "draft": label,
            "content_id": args.content,
            "publication_id": args.publication,
            "checks": [
                {
                    "id": c.id,
                    "title": c.title,
                    "status": c.status,
                    "detail": c.detail,
                    "source": c.source,
                }
                for c in checks
            ],
            "failed": failed,
        }
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(render(checks, label))

    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
