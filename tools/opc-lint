#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""模版自检（opc-lint）——确保模版仓库里没有任何真实业务。

这个工具回答一个问题：**这个仓库是模版，还是混进了业务？**

    scripts/opc-lint.sh                 # 在模版仓库根跑
    scripts/opc-lint.sh --strict        # 警告也算违规
    scripts/opc-lint.sh --private-words ~/.config/opc/private-words.txt

规则来源（都从仓库文件里读，不写死在本脚本）：

    - 文件属于模版还是实例        → sync-policy.json 的 rules
    - 种子骨架该长什么样          → sync-policy.json 的 seedRules
    - 提案该有哪几节              → sync-policy.json 的 proposalSections

新增规则有两条路：改 sync-policy.json（数据类规则自动跟随），或加一个 check 函数
（代码类规则）。

退出码：0 无硬性失败；1 有硬性失败；2 用法错误。
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass, field

DEFAULT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
POLICY_REL = "sync-policy.json"
MARKER_REL = ".opc-template-repo"
CACHED_POLICY_REL = os.path.join(".opc", "policy.json")

STATUS_OK = "ok"
STATUS_FAIL = "fail"
STATUS_WARN = "warn"
STATUS_SKIP = "skip"

# 具体日期：2026-11-04 / 2026/11/4 / 2026年11月4日。占位符 YYYY-MM-DD 不匹配
RE_CONCRETE_DATE = re.compile(r"\b20\d{2}[-/年]\d{1,2}[-/月]\d{1,2}\b")
RE_URL = re.compile(r"https?://")
RE_EMAIL = re.compile(r"[\w.+-]+@[\w-]+\.[\w.]{2,}")
RE_BIG_NUMBER = re.compile(r"\b\d{3,}\b")
# 字面量拆开写，免得这条规则命中它自己的源码
RE_LOCAL_PATH = re.compile(r"/User" + r"s/|/home/[a-z][a-z0-9_-]*/")
RE_PLACEHOLDER = re.compile(r"TODO|<[^<>\n]{2,}>", re.IGNORECASE)
RE_CHECKBOX = re.compile(r"^\s*-\s*\[[ xX]\]", re.MULTILINE)

PERMISSION_MODES = {"default", "manual", "auto", "acceptEdits", "plan", "dontAsk"}
RE_ROLE_NAME = re.compile(r"^[a-z][a-z0-9_-]{0,19}$")


@dataclass
class Check:
    id: str
    title: str
    status: str = STATUS_OK
    detail: list = field(default_factory=list)
    source: str = ""


@dataclass
class Rule:
    match: str
    mode: str
    track: bool = True
    optional: bool = False


@dataclass
class Policy:
    version: int
    rules: list
    seeds: list
    merge_configs: list
    seed_rules: dict
    proposal_dir: str
    proposal_sections: list
    raw: dict


# ---------------------------------------------------------------- 仓库读取


def git_tracked_files(root):
    """仓库里的文件列表：已跟踪的 + 未被忽略的未跟踪文件。

    只看已跟踪文件会让「刚 add 进来还没提交」的业务文件逃过检查，所以把
    未忽略的未跟踪文件也算进来。不在 git 仓库里就退回文件系统遍历。
    """
    try:
        out = subprocess.run(
            ["git", "-C", root, "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
            check=True, capture_output=True,
        ).stdout
        names = [n for n in out.decode("utf-8", "replace").split("\0") if n]
        if names:
            return names
    except (OSError, subprocess.CalledProcessError):
        pass
    names = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in (".git", ".opc", "__pycache__")]
        for fn in filenames:
            full = os.path.join(dirpath, fn)
            names.append(os.path.relpath(full, root))
    return names


def read_text(path):
    """读文本；二进制返回 None。"""
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except OSError:
        return None
    if b"\0" in raw[:8192]:
        return None
    return raw.decode("utf-8", "replace")


def load_policy(root):
    """读分类策略。模版仓库读根目录的 sync-policy.json；实例读缓存副本。"""
    for rel in (POLICY_REL, CACHED_POLICY_REL):
        path = os.path.join(root, rel)
        if not os.path.isfile(path):
            continue
        try:
            with open(path, encoding="utf-8") as fh:
                raw = json.load(fh)
        except (OSError, ValueError) as exc:
            return None, "读不了 {}：{}".format(rel, exc)
        try:
            return Policy(
                version=int(raw.get("version", 0)),
                rules=[Rule(r["match"], r["mode"], r.get("track", True), r.get("optional", False))
                       for r in raw["rules"]],
                seeds=raw.get("seeds", []),
                merge_configs=raw.get("mergeConfigs", []),
                seed_rules=raw.get("seedRules", {}),
                proposal_dir=raw.get("proposalDir", "knowledge/work/*/template-proposals"),
                proposal_sections=raw.get("proposalSections", []),
                raw=raw,
            ), None
        except (KeyError, TypeError, ValueError) as exc:
            return None, "{} 结构不对：{}".format(rel, exc)
    return None, "找不到 {}（或实例侧的 {}）".format(POLICY_REL, CACHED_POLICY_REL)


def is_template_repo(root):
    """是不是模版仓库。

    标记文件是最强信号；但标记被误删时不能就此把模版当成实例——那会让
    「守卫在不在」这条规则自己消失。所以还有一条兜底：根目录有分类策略、
    而没有实例元数据，就是模版。
    """
    if os.path.isfile(os.path.join(root, MARKER_REL)):
        return True
    if os.path.isfile(os.path.join(root, POLICY_REL)) and not os.path.isfile(
        os.path.join(root, ".opc", "instance.json")
    ):
        return True
    return False


def classify(policy, rel_path):
    """最长前缀优先匹配。返回 (mode, rule) 或 (None, None)。"""
    best = None
    best_len = -1
    for rule in policy.rules:
        m = rule.match
        if m.endswith("/"):
            hit = rel_path.startswith(m)
        else:
            hit = rel_path == m
        if hit and len(m) > best_len:
            best = rule
            best_len = len(m)
    return (best.mode, best) if best else (None, None)


def find_proposals(root, policy):
    """提案文件：模版侧 docs/proposals/，实例侧 policy.proposalDir 的展开。"""
    found = []
    pattern = policy.proposal_dir
    if pattern.startswith("docs/"):
        base = os.path.join(root, "docs", "proposals")
        if os.path.isdir(base):
            for fn in sorted(os.listdir(base)):
                if fn.endswith(".md"):
                    found.append(os.path.join("docs", "proposals", fn))
        return found
    # knowledge/work/*/template-proposals/*.md
    work = os.path.join(root, "knowledge", "work")
    if not os.path.isdir(work):
        return found
    for role in sorted(os.listdir(work)):
        pdir = os.path.join(work, role, "template-proposals")
        if not os.path.isdir(pdir):
            continue
        for fn in sorted(os.listdir(pdir)):
            if fn.endswith(".md"):
                found.append(os.path.join("knowledge", "work", role, "template-proposals", fn))
    return found


def load_private_words(root, explicit):
    """私词表。每行一个词；`re:` 前缀按正则；`#` 开头是注释。"""
    candidates = []
    if explicit:
        candidates.append(explicit)
    else:
        candidates.append(os.path.join(root, ".opc", "private-words.txt"))
        candidates.append(os.path.expanduser("~/.config/opc/private-words.txt"))
    for path in candidates:
        if not path or not os.path.isfile(path):
            continue
        words = []
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                words.append(line)
        if words:
            return words, os.path.abspath(path)
    return [], None


# ---------------------------------------------------------------- 规则实现


def check_l0_policy(policy, err):
    c = Check("L0", "分类策略可读且版本受支持")
    if policy is None:
        c.status = STATUS_FAIL
        c.detail.append(err)
        return c
    if policy.version != 1:
        c.status = STATUS_FAIL
        c.detail.append("策略版本是 {}，当前只支持 1".format(policy.version))
    return c


def check_l1_no_business(root, tracked):
    c = Check("L1", "模版仓库不含业务路径", source="knowledge/ 应只存在于实例")
    hits = [p for p in tracked if p.startswith("knowledge/")]
    if hits:
        c.status = STATUS_FAIL
        c.detail.append("模版里出现 knowledge/ 下的文件（{} 个）：{}".format(
            len(hits), "、".join(hits[:8])))
        c.detail.append("业务内容长在实例仓库里；模版的占位骨架在 seeds/business/")
    return c


def check_l2_seed_set(root, policy, tracked):
    c = Check("L2", "种子集合与策略一致", source="sync-policy.json 的 seeds")
    declared = {s["source"] for s in policy.seeds}
    actual = {p for p in tracked if p.startswith("seeds/") and not p.endswith("/")}
    missing = sorted(declared - actual)
    orphan = sorted(actual - declared)
    if missing:
        c.status = STATUS_FAIL
        c.detail.append("策略声明了但仓库里没有：{}".format("、".join(missing)))
    if orphan:
        c.status = STATUS_FAIL
        c.detail.append("仓库里有但策略没声明：{}".format("、".join(orphan)))
    # 映射规则：seeds/<路径> → <路径>。物化脚本与同步都按这条推导，
    # 策略必须与它一致，否则两处会物化到不同地方。
    for seed in policy.seeds:
        src = seed["source"]
        tgt = seed["target"]
        if not src.startswith("seeds/"):
            c.status = STATUS_FAIL
            c.detail.append("种子源必须在 seeds/ 下：{}".format(src))
        elif src[len("seeds/"):] != tgt:
            c.status = STATUS_FAIL
            c.detail.append("种子映射与「去掉 seeds/ 前缀」不一致：{} → {}".format(src, tgt))
    return c


def check_l3_placeholders(root, policy):
    c = Check("L3", "种子必须留占位", source="sync-policy.json 的 seedRules")
    exempt = []
    for src, rules in sorted(policy.seed_rules.items()):
        path = os.path.join(root, src)
        if not os.path.isfile(path):
            continue
        if not rules.get("requirePlaceholder", False):
            exempt.append(src)
            continue
        text = read_text(path) or ""
        if not RE_PLACEHOLDER.search(text) and "—" not in text:
            c.status = STATUS_FAIL
            c.detail.append("{} 没有占位了（既无 TODO 也无 —），像是被填成了真实内容".format(src))
    if exempt:
        c.detail.append("豁免（本就无占位）：{}".format("、".join(exempt)))
    return c


def check_l4_no_dates(root, policy):
    c = Check("L4", "种子不得含具体日期", source="sync-policy.json 的 seedRules")
    for src in sorted(policy.seed_rules):
        path = os.path.join(root, src)
        if not os.path.isfile(path):
            continue
        text = read_text(path) or ""
        for num, line in enumerate(text.splitlines(), 1):
            if RE_CONCRETE_DATE.search(line):
                c.status = STATUS_FAIL
                c.detail.append("{}:{} 含具体日期：{}".format(src, num, line.strip()[:60]))
    return c


def check_l5_no_links(root, policy):
    c = Check("L5", "种子不得含链接、邮箱与大数", source="sync-policy.json 的 seedRules")
    for src, rules in sorted(policy.seed_rules.items()):
        path = os.path.join(root, src)
        if not os.path.isfile(path):
            continue
        text = read_text(path) or ""
        forbid = list(rules.get("forbid", []))
        for num, line in enumerate(text.splitlines(), 1):
            for token in forbid:
                if token in line:
                    c.status = STATUS_FAIL
                    c.detail.append("{}:{} 含禁用内容 {}：{}".format(src, num, token, line.strip()[:60]))
            if RE_URL.search(line):
                c.status = STATUS_FAIL
                c.detail.append("{}:{} 含链接：{}".format(src, num, line.strip()[:60]))
            if RE_EMAIL.search(line):
                c.status = STATUS_FAIL
                c.detail.append("{}:{} 含邮箱：{}".format(src, num, line.strip()[:60]))
            if RE_BIG_NUMBER.search(line):
                c.status = STATUS_FAIL
                c.detail.append("{}:{} 含三位以上数字（像真实指标）：{}".format(src, num, line.strip()[:60]))
    return c


def check_l6_private_words(root, tracked, words, words_path):
    c = Check("L6", "模版不得含私词", source=words_path or "未提供私词表")
    if not words:
        c.status = STATUS_SKIP
        c.detail.append("没有私词表，跳过。放一份到 .opc/private-words.txt 或 ~/.config/opc/private-words.txt")
        return c
    for rel in tracked:
        text = read_text(os.path.join(root, rel))
        if text is None:
            continue
        for num, line in enumerate(text.splitlines(), 1):
            for idx, word in enumerate(words, 1):
                needle = word[3:] if word.startswith("re:") else word
                hit = re.search(needle, line) if word.startswith("re:") else (needle in line)
                if hit:
                    c.status = STATUS_FAIL
                    c.detail.append("{}:{} 命中私词#{}".format(rel, num, idx))
    return c


def check_l7_channels(root):
    c = Check("L7", "模版不预置频道", source="channels.json")
    path = os.path.join(root, "channels.json")
    if not os.path.isfile(path):
        c.status = STATUS_FAIL
        c.detail.append("找不到 channels.json")
        return c
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError) as exc:
        c.status = STATUS_FAIL
        c.detail.append("channels.json 读不了：{}".format(exc))
        return c
    channels = data.get("channels")
    if not isinstance(channels, list):
        c.status = STATUS_FAIL
        c.detail.append("channels.json 缺 channels 数组")
        return c
    if channels:
        c.status = STATUS_FAIL
        c.detail.append("模版里有 {} 个频道：{}".format(
            len(channels), "、".join(str(x.get("id")) for x in channels)))
        c.detail.append("频道是实例的事，模版的 channels.json 恒为空数组")
    return c


def check_l8_roles(root):
    c = Check("L8", "角色注册表字段合法", source="roles.json")
    path = os.path.join(root, "roles.json")
    if not os.path.isfile(path):
        c.status = STATUS_FAIL
        c.detail.append("找不到 roles.json")
        return c
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError) as exc:
        c.status = STATUS_FAIL
        c.detail.append("roles.json 读不了：{}".format(exc))
        return c
    roles = data.get("roles")
    if not isinstance(roles, list) or not roles:
        c.status = STATUS_FAIL
        c.detail.append("roles.json 里没有角色")
        return c
    for role in roles:
        name = role.get("name", "")
        if not RE_ROLE_NAME.match(str(name)):
            c.status = STATUS_FAIL
            c.detail.append("角色名不合法：{}".format(name))
        mode = role.get("permissionMode", "default")
        if mode not in PERMISSION_MODES:
            c.status = STATUS_FAIL
            c.detail.append("角色 {} 的 permissionMode 不合法：{}".format(name, mode))
        if mode == "bypassPermissions":
            c.status = STATUS_FAIL
            c.detail.append("角色 {} 用了 bypassPermissions".format(name))
        for scope in role.get("scope", []):
            if scope.startswith("/") or ".." in scope or " " in scope:
                c.status = STATUS_FAIL
                c.detail.append("角色 {} 的 scope 不合法：{}".format(name, scope))
        tpl = role.get("template")
        if tpl and not os.path.isfile(os.path.join(root, tpl)):
            c.status = STATUS_FAIL
            c.detail.append("角色 {} 的模板文件不存在：{}".format(name, tpl))
    return c


def check_l9_policy_covers(root, policy, tracked):
    c = Check("L9", "策略覆盖全部模版文件", source="sync-policy.json 的 rules")
    unclassified = []
    for rel in tracked:
        mode, _ = classify(policy, rel)
        if mode is None:
            unclassified.append(rel)
    if unclassified:
        c.status = STATUS_FAIL
        c.detail.append("{} 个文件没有归类：{}".format(len(unclassified), "、".join(unclassified[:8])))
        c.detail.append("在 sync-policy.json 的 rules 里给它定一个 mode")
    return c


def check_l10_policy_refs(root, policy):
    c = Check("L10", "策略引用的文件必须存在", source="sync-policy.json")
    for seed in policy.seeds:
        if not os.path.isfile(os.path.join(root, seed["source"])):
            c.status = STATUS_FAIL
            c.detail.append("种子源不存在：{}".format(seed["source"]))
    for rule in policy.rules:
        m = rule.match
        if m.endswith("/") or "*" in m or rule.optional:
            continue
        if not os.path.isfile(os.path.join(root, m)):
            c.status = STATUS_FAIL
            c.detail.append("规则引用的文件不存在：{}".format(m))
    return c


def check_l11_guards(root):
    c = Check("L11", "守卫本身在位", source=MARKER_REL)
    marker = os.path.join(root, MARKER_REL)
    if not os.path.isfile(marker):
        c.status = STATUS_FAIL
        c.detail.append("模版仓库必须有 {}".format(MARKER_REL))
        return c
    text = read_text(marker) or ""
    try:
        data = json.loads(text)
    except ValueError:
        c.status = STATUS_FAIL
        c.detail.append("{} 不是合法 JSON".format(MARKER_REL))
        return c
    if data.get("kind") != "opc-template":
        c.status = STATUS_FAIL
        c.detail.append("{} 的 kind 应为 opc-template".format(MARKER_REL))
    install = os.path.join(root, "scripts", "opc-install.sh")
    lib = os.path.join(root, "scripts", "lib.sh")
    if not os.path.isfile(install) or "opc_is_template_repo" not in (read_text(install) or ""):
        c.status = STATUS_FAIL
        c.detail.append("scripts/opc-install.sh 里没有模版仓库守卫")
    if not os.path.isfile(lib) or MARKER_REL not in (read_text(lib) or ""):
        c.status = STATUS_FAIL
        c.detail.append("scripts/lib.sh 里没有 {} 的判定".format(MARKER_REL))
    sync = os.path.join(root, "scripts", "opc-sync.sh")
    if os.path.isfile(sync) and "opc_is_template_repo" not in (read_text(sync) or ""):
        c.status = STATUS_FAIL
        c.detail.append("scripts/opc-sync.sh 里没有模版仓库守卫")
    return c


def check_l12_no_local_paths(root, tracked):
    c = Check("L12", "模版不得含本机路径", source="本机绝对路径（家目录展开的那种）")
    for rel in tracked:
        text = read_text(os.path.join(root, rel))
        if text is None:
            continue
        for num, line in enumerate(text.splitlines(), 1):
            if RE_LOCAL_PATH.search(line):
                c.status = STATUS_FAIL
                c.detail.append("{}:{} 含本机路径：{}".format(rel, num, line.strip()[:60]))
    return c


def check_l13_proposals(root, policy):
    c = Check("L13", "提案格式完整", source="sync-policy.json 的 proposalSections")
    proposals = find_proposals(root, policy)
    if not proposals:
        c.status = STATUS_SKIP
        c.detail.append("没有找到提案文件")
        return c
    for rel in proposals:
        text = read_text(os.path.join(root, rel)) or ""
        for section in policy.proposal_sections:
            if not re.search(r"^##\s+{}\s*$".format(re.escape(section)), text, re.MULTILINE):
                c.status = STATUS_FAIL
                c.detail.append("{} 缺小节：## {}".format(rel, section))
        if policy.proposal_sections and "脱敏自检" in policy.proposal_sections:
            if not RE_CHECKBOX.search(text):
                c.status = STATUS_FAIL
                c.detail.append("{} 的「脱敏自检」没有勾选项（- [x]）".format(rel))
    return c


def check_l14_proposal_private_words(root, policy, words, words_path):
    c = Check("L14", "提案不得含私词", source=words_path or "未提供私词表")
    if not words:
        c.status = STATUS_SKIP
        c.detail.append("没有私词表，跳过")
        return c
    for rel in find_proposals(root, policy):
        text = read_text(os.path.join(root, rel))
        if text is None:
            continue
        for num, line in enumerate(text.splitlines(), 1):
            for idx, word in enumerate(words, 1):
                needle = word[3:] if word.startswith("re:") else word
                hit = re.search(needle, line) if word.startswith("re:") else (needle in line)
                if hit:
                    c.status = STATUS_FAIL
                    c.detail.append("{}:{} 命中私词#{}".format(rel, num, idx))
    return c


def check_l16_instance(root, policy):
    c = Check("L16", "实例自洽", source="template.lock.json 与 roles.json")
    lock = os.path.join(root, "template.lock.json")
    if not os.path.isfile(lock):
        c.status = STATUS_WARN
        c.detail.append("没有 template.lock.json——还没接入同步，跑 scripts/opc-sync.sh adopt")
    roles = os.path.join(root, "roles.json")
    if os.path.isfile(roles):
        try:
            with open(roles, encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            data = {}
        for role in data.get("roles", []):
            tpl = role.get("template")
            if tpl and not os.path.isfile(os.path.join(root, tpl)):
                c.status = STATUS_FAIL
                c.detail.append("角色 {} 的模板文件不存在：{}".format(role.get("name"), tpl))
    return c


# ---------------------------------------------------------------- 驱动


def run_checks(root, strict=False, words_file=None):
    template_mode = is_template_repo(root)
    tracked = git_tracked_files(root)
    policy, err = load_policy(root)
    words, words_path = load_private_words(root, words_file)

    checks = [check_l0_policy(policy, err)]

    if template_mode:
        checks += [
            check_l1_no_business(root, tracked),
            check_l2_seed_set(root, policy, tracked),
            check_l3_placeholders(root, policy),
            check_l4_no_dates(root, policy),
            check_l5_no_links(root, policy),
            check_l7_channels(root),
            check_l8_roles(root),
            check_l9_policy_covers(root, policy, tracked),
            check_l10_policy_refs(root, policy),
            check_l11_guards(root),
            check_l12_no_local_paths(root, tracked),
        ]
        if policy is not None:
            checks.append(check_l13_proposals(root, policy))
            checks.append(check_l14_proposal_private_words(root, policy, words, words_path))
    else:
        skipped = Check("SKIP", "模版侧规则跳过", source="这是实例仓库")
        skipped.status = STATUS_SKIP
        skipped.detail.append("L1–L12 是模版侧规则，在实例里跑没有意义")
        checks.append(skipped)
        if policy is not None:
            checks.append(check_l13_proposals(root, policy))
            checks.append(check_l14_proposal_private_words(root, policy, words, words_path))
        checks.append(check_l16_instance(root, policy))

    if policy is not None:
        checks.append(check_l6_private_words(root, tracked, words, words_path))

    if strict:
        for c in checks:
            if c.status == STATUS_WARN:
                c.status = STATUS_FAIL
    return checks


STATUS_LABEL = {STATUS_OK: "通过", STATUS_FAIL: "失败", STATUS_WARN: "警告", STATUS_SKIP: "跳过"}


def render(checks, root):
    lines = ["OPC 模版自检：{}".format(root), ""]
    for c in checks:
        lines.append("[{}] {}".format(STATUS_LABEL[c.status], c.title))
        for item in c.detail:
            lines.append("       - {}".format(item))
        if c.source:
            lines.append("       来源：{}".format(c.source))
    passed = sum(1 for c in checks if c.status == STATUS_OK)
    failed = sum(1 for c in checks if c.status == STATUS_FAIL)
    warned = sum(1 for c in checks if c.status == STATUS_WARN)
    skipped = sum(1 for c in checks if c.status == STATUS_SKIP)
    lines.append(
        "汇总：通过 {} 项 / 失败 {} 项 / 警告 {} 项 / 跳过 {} 项".format(passed, failed, warned, skipped)
    )
    return "\n".join(lines)


def main(argv=None):
    parser = argparse.ArgumentParser(description="模版自检：确保模版仓库里没有真实业务")
    parser.add_argument("--root", default=DEFAULT_ROOT, help="仓库根目录，默认取脚本所在仓库")
    parser.add_argument("--private-words", default=None, help="私词表文件路径（每行一个词）")
    parser.add_argument("--json", action="store_true", help="输出 JSON")
    parser.add_argument("--quiet", action="store_true", help="只输出失败项")
    parser.add_argument("--strict", action="store_true", help="警告也算违规")
    args = parser.parse_args(argv)

    root = os.path.abspath(args.root)
    if not os.path.isdir(root):
        print("找不到目录：{}".format(root), file=sys.stderr)
        return 2

    checks = run_checks(root, strict=args.strict, words_file=args.private_words)
    failed = any(c.status == STATUS_FAIL for c in checks)

    if args.json:
        payload = {
            "root": root,
            "template_repo": is_template_repo(root),
            "checks": [
                {
                    "id": c.id,
                    "title": c.title,
                    "status": c.status,
                    "detail": c.detail,
                    "source": c.source,
                }
                for c in checks
            ],
            "failed": failed,
        }
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif args.quiet:
        for c in checks:
            if c.status == STATUS_FAIL:
                print("[失败] {}".format(c.title))
                for item in c.detail:
                    print("       - {}".format(item))
    else:
        print(render(checks, root))

    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
